rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isWorkspaceMember(workspaceId) {
      return isAuth() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
    }
    
    // User Profiles
    // Allow users to read any profile (for assignee names), but only write to their own.
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isUser(userId);
    }
    
    // Workspaces
    match /workspaces/{workspaceId} {
      // Allow read of any document within a workspace if the user is a member.
      // This single rule grants access to companies, projects, silos, and tasks.
      allow read: if isWorkspaceMember(workspaceId);
      
      // Allow creation of companies/projects if user is a member.
      allow create, update: if isWorkspaceMember(workspaceId);
      
      match /companies/{companyId} {
        match /projects/{projectId} {
           match /sales/{saleId} {
              allow write: if isWorkspaceMember(workspaceId);
           }
           match /silos/{siloId} {
              allow write: if isWorkspaceMember(workspaceId);
              match /tasks/{taskId} {
                 // Allow create if a workspace member.
                 // Allow update/delete if a member (covers admins and assignees for simplicity now).
                 allow write: if isWorkspaceMember(workspaceId);
              }
           }
        }
      }
    }
    
    // User-specific denormalized tasks
    match /user-tasks/{userId} {
      // Allow a user to list tasks from their own collection.
      allow list: if isUser(userId);

      // Allow read/delete on a specific task document only if they are the owner.
      match /tasks/{taskId} {
        allow read, delete: if isUser(userId);

        // Allow another user (e.g., admin) to CREATE a task in this user's list,
        // but only if the creator is a member of the workspace the task belongs to.
        allow create: if isAuth() && isWorkspaceMember(request.resource.data.workspaceId);
        
        // Allow updates only by the owner of the task list.
        allow update: if isUser(userId);
      }
    }
    
    // Invites
    match /invites/{inviteId} {
        // Allow admins of a workspace to create invites.
        allow create: if isAuth() && isWorkspaceMember(request.resource.data.workspaceId) &&
                         get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.users[request.auth.uid].role == 'admin';
                         
        // Anyone with the token can read it to process the join request.
        // The token is secret, acting as the auth mechanism here.
        allow read: if isAuth(); 
    }
  }
}
