/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model within workspaces.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles, accessible only to the owning user.
 * - /workspaces/{workspaceId}: Stores workspace data with user roles denormalized into the 'users' map.
 * - /workspaces/{workspaceId}/companies/{companyId}: Companies within workspaces.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Projects within companies.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Silos (task containers) within projects.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Tasks within silos.
 * - /user-tasks/{userId}/tasks/{taskId}: Denormalized tasks for quick user lookups.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Sales logged for projects.
 * - /invites/{inviteId}: Stores pending invitations for users to join workspaces.
 *
 * Key Security Decisions:
 * - User profiles are strictly private and owner-accessible only.
 * - Workspaces enforce role-based access using the 'users' map on the workspace document.
 * - User listing is generally disallowed for privacy, except where explicitly needed.
 * - Invites can be created by workspace admins to invite users
 *
 * Denormalization for Authorization:
 * - Workspace roles are denormalized into the 'workspaces/{workspaceId}/users' map for efficient access control.
 *
 * Structural Segregation:
 * - User-specific data is stored under /users/{userId} to ensure privacy and ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, list) User accessing their own profile. (auth.uid == userId)
     * @allow (create) User creating their own profile. (auth.uid == userId)
     * @allow (update, delete) User updating/deleting their own profile. (auth.uid == userId)
     * @deny (get, list) User attempting to access another user's profile. (auth.uid != userId)
     * @deny (create, update, delete) User attempting to modify another user's profile. (auth.uid != userId)
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to workspace documents based on user roles.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) Any authenticated user can read workspace details.
     * @allow (create) User creating a workspace if they are the owner
     * @allow (update, delete) Only workspace admins can update or delete workspaces.
     * @deny User attempting to create a workspace with mismatched ownerId.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }
      function isExistingAdmin(workspaceId) {
          return isAdmin(workspaceId) && resource != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingAdmin(workspaceId);
      allow delete: if isExistingAdmin(workspaceId);

      /**
       * @description Controls access to company documents within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       */
      match /companies/{companyId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        allow update: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';

        /**
         * @description Controls access to project documents within a company.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
         */
        match /projects/{projectId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
          allow update: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
          allow delete: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';

          /**
           * @description Controls access to sales documents within a project.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
           */
          match /sales/{saleId} {
            allow get, list: if isSignedIn();
            allow create: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            allow update: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            allow delete: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
          }

          /**
           * @description Controls access to silo documents within a project.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
           */
          match /silos/{siloId} {
            allow get, list: if isSignedIn();
            allow create: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            allow update: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            allow delete: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';

            /**
             * @description Controls access to task documents within a silo.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
             */
            match /tasks/{taskId} {
              allow get, list: if isSignedIn();
              allow create: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
              allow update: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
              allow delete: if isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            }
          }
        }
      }
    }

    /**
     * @description Controls access to user-specific task documents.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) Owner can get/list their own tasks.
     * @allow (create) Owner can create tasks under their ID.
     * @allow (update, delete) Owner can update/delete their own tasks.
     * @deny Others cannot access these tasks.
     * @principle Enforces strict user-ownership.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to invite documents.
     * @path /invites/{inviteId}
     * @allow (create) Workspace admins can create invites.
     * @deny Other users cannot create invites.
     * @principle Restricts invite creation to workspace admins.
     */
    match /invites/{inviteId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isAdminForWorkspace(workspaceId) {
            return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        }
        allow create: if isSignedIn() && request.resource.data.workspaceId is string && request.resource.data.email is string && request.resource.data.token is string && request.resource.data.expires is number && isAdminForWorkspace(request.resource.data.workspaceId);
        allow get: if false;
        allow list: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}