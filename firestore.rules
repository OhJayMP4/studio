/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and a
 * shared-access model with role-based permissions for workspaces and companies.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information.
 * - /workspaces/{workspaceId}: Stores workspace data, including member roles.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company data within a workspace.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Workspaces are secured using a role-based access control model, where
 *   members have different roles (admin, contributor, viewer).
 * - Companies are secured based on workspace membership. Only workspace
 *   members can create, update, or delete companies within that workspace.
 * - Listing of users is disallowed.
 *
 * Denormalization for Authorization:
 * - Workspaces denormalize user roles and member lists directly on the
 *   workspace document to avoid costly `get()` operations in security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not allowed.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows workspace members to read workspace data based on their role.
     * @path /workspaces/{workspaceId}
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceMember() {
        return request.auth != null && resource.data.memberIds is list && resource.data.memberIds.hasAny([request.auth.uid]);
      }

      function isWorkspaceAdmin() {
          return request.auth != null && resource.data.users[request.auth.uid].role == 'admin';
      }

      function isWorkspaceOwner() {
        return request.auth != null && resource.data.ownerId == request.auth.uid;
      }
      
      allow get: if isWorkspaceMember();
      allow list: if false;

      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if isWorkspaceAdmin();
      allow delete: if isWorkspaceOwner();
    }

    /**
     * @description Allows workspace members to manage companies within their workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isWorkspaceMember(workspaceId) {
        return request.auth != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds is list && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
      }
      
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceMember(workspaceId);
      allow delete: if isWorkspaceMember(workspaceId);
    }
  }
}