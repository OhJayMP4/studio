/**
 * @fileoverview Firestore Security Rules for Saturn Management.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control (RBAC) model within workspaces.
 * Most data is scoped to a workspace, and access is granted based on a user's role within that workspace.
 * The ruleset prioritizes secure authorization and allows flexible data shapes during the prototyping phase.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles. Accessible only to the owner.
 * - /workspaces/{workspaceId}: Stores workspace data and member roles. Access is role-based.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company data within a workspace. Access is workspace-based.
 * - /workspaces/{workspaceId}/.../projects/{projectId}: Stores project data. Access is workspace-based.
 * - /workspaces/{workspaceId}/.../silos/{siloId}/tasks/{taskId}: Stores individual tasks. Access is workspace-based.
 * - /user-tasks/{userId}/tasks/{taskId}: Stores denormalized tasks for quick lookups by user. Owner-only access.
 * - /workspaces/{workspaceId}/.../sales/{saleId}: Stores sales data. Access is workspace-based.
 * - /invites/{inviteId}: Stores invitations to join workspaces. Accessible only on create.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Roles are denormalized directly onto the Workspace document to avoid costly `get()` calls in the rules.
 * - The default security posture for ambiguous relationships is strict owner-only access.
 * - Data type validation is relaxed for rapid prototyping, focusing only on authorization-critical fields.
 *
 * Denormalization for Authorization:
 * - Workspace member roles are stored directly within the `/workspaces/{workspaceId}` document under the `users` map.
 * This allows for efficient role checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and the resource exists.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is an admin in the workspace.
     * @param {string} workspaceId - The workspace ID.
     */
    function isAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    /**
     * @description Checks if the authenticated user is a member of the workspace.
     * @param {string} workspaceId - The workspace ID.
     */
    function isWorkspaceMember(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (read, write) if isOwner(userId)
     * @deny (read, write) if !isOwner(userId)
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is disallowed.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for workspaces.
     * @path /workspaces/{workspaceId}
     * @allow (read) if isWorkspaceMember(workspaceId)
     * @allow (write) if isAdmin(workspaceId)
     * @deny (read) if !isWorkspaceMember(workspaceId)
     * @deny (write) if !isAdmin(workspaceId)
     * @principle Enforces workspace-based role access control.
     */
    match /workspaces/{workspaceId} {
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false; // Workspace listing is disallowed.
      allow create: if isSignedIn(); // Any signed-in user can create a workspace.
      allow update: if isAdmin(workspaceId);
      allow delete: if isAdmin(workspaceId);

       /**
         * @description Rules for companies within a workspace.
         * @path /workspaces/{workspaceId}/companies/{companyId}
         * @allow (read) if isWorkspaceMember(workspaceId)
         * @allow (write) if isAdmin(workspaceId)
         * @deny (read) if !isWorkspaceMember(workspaceId)
         * @deny (write) if !isAdmin(workspaceId)
         * @principle Enforces workspace-based role access control.
         */
      match /companies/{companyId} {
        allow get: if isWorkspaceMember(workspaceId);
        allow list: if isWorkspaceMember(workspaceId);
        allow create: if isAdmin(workspaceId);
        allow update: if isAdmin(workspaceId);
        allow delete: if isAdmin(workspaceId);

         /**
           * @description Rules for projects within a company.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
           * @allow (read) if isWorkspaceMember(workspaceId)
           * @allow (write) if isAdmin(workspaceId)
           * @deny (read) if !isWorkspaceMember(workspaceId)
           * @deny (write) if !isAdmin(workspaceId)
           * @principle Enforces workspace-based role access control.
           */
        match /projects/{projectId} {
          allow get: if isWorkspaceMember(workspaceId);
          allow list: if isWorkspaceMember(workspaceId);
          allow create: if isAdmin(workspaceId);
          allow update: if isAdmin(workspaceId);
          allow delete: if isAdmin(workspaceId);

           /**
             * @description Rules for sales within a project.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
             * @allow (read) if isWorkspaceMember(workspaceId)
             * @allow (write) if isAdmin(workspaceId)
             * @deny (read) if !isWorkspaceMember(workspaceId)
             * @deny (write) if !isAdmin(workspaceId)
             * @principle Enforces workspace-based role access control.
             */
          match /sales/{saleId} {
            allow get: if isWorkspaceMember(workspaceId);
            allow list: if isWorkspaceMember(workspaceId);
            allow create: if isAdmin(workspaceId);
            allow update: if isAdmin(workspaceId);
            allow delete: if isAdmin(workspaceId);
          }

           /**
             * @description Rules for silos within a project.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
             * @allow (read) if isWorkspaceMember(workspaceId)
             * @allow (write) if isAdmin(workspaceId)
             * @deny (read) if !isWorkspaceMember(workspaceId)
             * @deny (write) if !isAdmin(workspaceId)
             * @principle Enforces workspace-based role access control.
             */
          match /silos/{siloId} {
            allow get: if isWorkspaceMember(workspaceId);
            allow list: if isWorkspaceMember(workspaceId);
            allow create: if isAdmin(workspaceId);
            allow update: if isAdmin(workspaceId);
            allow delete: if isAdmin(workspaceId);

            /**
              * @description Rules for tasks within a silo.
              * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
              * @allow (read) if isWorkspaceMember(workspaceId)
              * @allow (write) if isAdmin(workspaceId)
              * @deny (read) if !isWorkspaceMember(workspaceId)
              * @deny (write) if !isAdmin(workspaceId)
              * @principle Enforces workspace-based role access control.
              */
            match /tasks/{taskId} {
              allow get: if isWorkspaceMember(workspaceId);
              allow list: if isWorkspaceMember(workspaceId);
              allow create: if isAdmin(workspaceId);
              allow update: if isAdmin(workspaceId);
              allow delete: if isAdmin(workspaceId);
            }
          }
        }
      }
    }

    /**
     * @description Rules for denormalized user tasks.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (read, write) if isOwner(userId)
     * @deny (read, write) if !isOwner(userId)
     * @principle Enforces document ownership for writes.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.assigneeId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.assigneeId == resource.data.assigneeId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for invites.
     * @path /invites/{inviteId}
     * @allow create: if isSignedIn();
     * @deny get, list, update, delete: if true;
     * @principle Allows any signed-in user to create an invite.
     */
    match /invites/{inviteId} {
        allow get: if false;
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }
  }
}