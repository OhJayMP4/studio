/**
 * @fileoverview Firestore Security Rules
 *
 * Core Philosophy:
 * This ruleset implements a hybrid security model, combining user-based access control with
 * workspace-based roles and invitation-based access. It prioritizes secure data access by
 * enforcing strict ownership and role-based authorization for all write operations, while
 * offering flexible read access where appropriate.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles, accessible only to the owner.
 * - /workspaces/{workspaceId}: Stores workspace data, secured by workspace admin roles and invitation-based access.
 * - /workspaces/{workspaceId}/companies/{companyId}: Companies within workspaces.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Projects within companies.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Silos (task containers) within projects.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Individual tasks within silos.
 * - /user-tasks/{userId}/tasks/{taskId}: Denormalized task data for quick user lookups, accessible only to the owner.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Sales logged for projects.
 * - /invites/{inviteId}: Invitations to join a workspace, secured by a token and expiration.
 *
 * Key Security Decisions:
 * - User profiles are strictly private and accessible only to the owner.
 * - Workspace access is managed through roles (admin, contributor, viewer) and invitation-based access.
 * - Listing of user profiles is disallowed for privacy.
 * - Invites are used to grant temporary, token-based access to workspaces.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map that stores user roles within the workspace,
 *   enabling efficient role-based access control without additional reads.
 * - `memberIds` array on `Workspace` to allow simpler queries for workspace membership.
 *
 * Structural Segregation:
 * - User-specific data (user profiles, user tasks) is stored in user-scoped subcollections
 *   to ensure privacy and efficient access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isWorkspaceAdmin(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    function isExistingOwner(userId) {
      return (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data != null);
    }

    function isValidInviteForUser(inviteId) {
      let inviteDoc = get(/databases/$(database)/documents/invites/$(inviteId)).data;
      return inviteDoc.expires > request.time
        && inviteDoc.token == request.resource.data.token
        && inviteDoc.email == request.auth.token.email
        && request.auth.uid != null;
    }

    /**
     * @description Manages user profile access. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete) User with matching userId.
     * @allow (create) User creating their own profile with matching userId.
     * @deny (get, list) Any other user trying to read another user's profile.
     * @deny (create, update, delete) Any other user trying to modify another user's profile.
     * @principle Enforces strict user ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == request.resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages workspaces, including creation, updates, and deletion.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) Any authenticated user can read workspaces.
     * @allow (create) User with valid data can create a workspace.
     * @allow (update) Only workspace admins can update workspace details.
     * @allow (delete) Only workspace admins can delete workspaces.
     * @deny (create, update, delete) Non-admins attempting to modify workspaces.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isWorkspaceAdmin(workspaceId)
        || (isValidInviteForUser(request.resource.data.inviteId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members[request.auth.uid] == 'member');
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages companies within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get, list: if true;
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages projects within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get, list: if true;
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages silos (task containers) within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      allow get, list: if true;
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages tasks within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      allow get, list: if true;
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages user-specific task lists for quick lookups.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) User with matching userId.
     * @allow (create) Workspace admin creating a user-task.  Must match the userId in the path.
     * @allow (update) Workspace admin updating a user-task.
     * @allow (delete) Workspace admin deleting a user-task.
     * @deny (get, list) Any other user trying to read another user's tasks.
     * @deny (create, update, delete) Non-admins attempting to modify user tasks.
     * @principle Enforces strict user ownership for task lists.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      allow get, list: if isOwner(userId);
      allow create: if get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.users[request.auth.uid].role == 'admin' && request.resource.data.assigneeId == userId;
      allow update: if get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.users[request.auth.uid].role == 'admin';
      allow delete: if get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    /**
     * @description Manages invites to join a workspace. Admin create, invited user read/delete on valid token.
     * @path /invites/{inviteId}
     * @allow (create) Workspace admins can create invites.
     * @allow (read, delete) Invited user can read/delete invite on valid token.
     * @allow (list) Only allowed with specific query params for token verification.
     * @deny (all) Other users accessing invites.
     * @principle Enforces admin-only creation and token-based access for invites.
     */
    match /invites/{inviteId} {
      allow create: if get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.users[request.auth.uid].role == 'admin';
      allow read: if isValidInviteForUser(inviteId);
      allow list: if request.auth != null && request.query.limit == 1 && request.query.where[0][0] == 'token';
      allow delete: if isValidInviteForUser(inviteId);
    }

    /**
     * @description Manages sales logged for a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      allow get, list: if true;
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }
  }
}