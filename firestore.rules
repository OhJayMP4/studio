rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile access.
     * @path /users/{userId}
     * @allow (get, list): Authenticated user can read their own profile data.
     * @allow (create): Authenticated user can create their own profile data.
     * @allow (update): Authenticated user can update their own profile data.
     * @allow (delete): Authenticated user can delete their own profile data.
     * @deny (get, list): Authenticated user cannot read other user profiles.
     * @deny (create): Unauthenticated user cannot create a profile.
     * @principle Enforces user-ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages workspace access.
     * @path /workspaces/{workspaceId}
     * @allow (get, list): Authenticated users who are members of the workspace can read workspace data.
     * @allow (create): Authenticated user can create a workspace if the ownerId is their uid and they are added as a member.
     * @allow (update): Authenticated users who are workspace admins can update workspace data.
     * @allow (delete): Authenticated users who are workspace admins can delete the workspace.
     * @deny (get, list): Authenticated users who are not members cannot read workspace data.
     * @deny (create): Unauthenticated users cannot create a workspace.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember() {
        return resource.data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin() {
        return resource.data.users[request.auth.uid].role == 'admin';
      }

      function isExistingWorkspaceAdmin() {
        return isWorkspaceAdmin() && resource != null;
      }

      allow get: if isSignedIn() && isWorkspaceMember();
      allow list: if isSignedIn(); // List available to signed in users
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.users[request.auth.uid].role == 'admin';
      allow update: if isSignedIn() && isWorkspaceAdmin();
      allow delete: if isSignedIn() && isWorkspaceAdmin();

      /**
       * @description Manages company access within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (get, list): Authenticated users who are members of the workspace can read company data.
       * @allow (create): Authenticated users who are workspace members can create company data.
       * @allow (update): Authenticated users who are workspace members can update company data.
       * @allow (delete): Authenticated users who are workspace members can delete company data.
       * @deny (get, list): Authenticated users who are not members cannot read company data.
       * @deny (create): Unauthenticated users cannot create company data.
       * @principle Enforces workspace membership for company access.
       */
      match /companies/{companyId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function getWorkspaceId() {
            return parent_path().split("/")[6];
        }

        function isWorkspaceMember() {
          return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
        }

        allow get: if isSignedIn() && isWorkspaceMember();
        allow list: if isSignedIn() && isWorkspaceMember();
        allow create: if isSignedIn() && isWorkspaceMember();
        allow update: if isSignedIn() && isWorkspaceMember();
        allow delete: if isSignedIn() && isWorkspaceMember();

        /**
         * @description Manages project access within a company.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
         * @allow (get, list): Authenticated users who are members of the workspace can read project data.
         * @allow (create): Authenticated users who are workspace members can create project data.
         * @allow (update): Authenticated users who are workspace members can update project data.
         * @allow (delete): Authenticated users who are workspace members can delete project data.
         * @deny (get, list): Authenticated users who are not members cannot read project data.
         * @deny (create): Unauthenticated users cannot create project data.
         * @principle Enforces workspace membership for project access.
         */
        match /projects/{projectId} {
          function isSignedIn() {
            return request.auth != null;
          }

          function getWorkspaceId() {
              return parent_path().split("/")[6];
          }

          function isWorkspaceMember() {
            return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
          }

          allow get: if isSignedIn() && isWorkspaceMember();
          allow list: if isSignedIn() && isWorkspaceMember();
          allow create: if isSignedIn() && isWorkspaceMember();
          allow update: if isSignedIn() && isWorkspaceMember();
          allow delete: if isSignedIn() && isWorkspaceMember();

          /**
           * @description Manages silo access within a project.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
           * @allow (get, list): Authenticated users who are members of the workspace can read silo data.
           * @allow (create): Authenticated users who are workspace members can create silo data.
           * @allow (update): Authenticated users who are workspace members can update silo data.
           * @allow (delete): Authenticated users who are workspace members can delete silo data.
           * @deny (get, list): Authenticated users who are not members cannot read silo data.
           * @deny (create): Unauthenticated users cannot create silo data.
           * @principle Enforces workspace membership for silo access.
           */
          match /silos/{siloId} {
            function isSignedIn() {
              return request.auth != null;
            }

             function getWorkspaceId() {
              return parent_path().split("/")[6];
            }

            function isWorkspaceMember() {
              return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
            }

            allow get: if isSignedIn() && isWorkspaceMember();
            allow list: if isSignedIn() && isWorkspaceMember();
            allow create: if isSignedIn() && isWorkspaceMember();
            allow update: if isSignedIn() && isWorkspaceMember();
            allow delete: if isSignedIn() && isWorkspaceMember();

            /**
             * @description Manages task access within a silo.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
             * @allow (get, list): Authenticated users who are members of the workspace can read task data.
             * @allow (create): Authenticated users who are workspace members can create task data.
             * @allow (update): Authenticated users who are workspace members can update task data.
             * @allow (delete): Authenticated users who are workspace members can delete task data.
             * @deny (get, list): Authenticated users who are not members cannot read task data.
             * @deny (create): Unauthenticated users cannot create task data.
             * @principle Enforces workspace membership for task access.
             */
            match /tasks/{taskId} {
              function isSignedIn() {
                return request.auth != null;
              }

              function getWorkspaceId() {
                  return parent_path().split("/")[6];
              }

              function isWorkspaceMember() {
                return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
              }

              allow get: if isSignedIn() && isWorkspaceMember();
              allow list: if isSignedIn() && isWorkspaceMember();
              allow create: if isSignedIn() && isWorkspaceMember();
              allow update: if isSignedIn() && isWorkspaceMember();
              allow delete: if isSignedIn() && isWorkspaceMember();
            }
          }
        }

        /**
         * @description Manages sale access within a project.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
         * @allow (get, list): Authenticated users who are members of the workspace can read sale data.
         * @allow (create): Authenticated users who are workspace members can create sale data.
         * @allow (update): Authenticated users who are workspace members can update sale data.
         * @allow (delete): Authenticated users who are workspace members can delete sale data.
         * @deny (get, list): Authenticated users who are not members cannot read sale data.
         * @deny (create): Unauthenticated users cannot create sale data.
         * @principle Enforces workspace membership for sale access.
         */
        match /sales/{saleId} {
            function isSignedIn() {
              return request.auth != null;
            }

            function getWorkspaceId() {
                  return parent_path().split("/")[6];
              }

            function isWorkspaceMember() {
              return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
            }

            allow get: if isSignedIn() && isWorkspaceMember();
            allow list: if isSignedIn() && isWorkspaceMember();
            allow create: if isSignedIn() && isWorkspaceMember();
            allow update: if isSignedIn() && isWorkspaceMember();
            allow delete: if isSignedIn() && isWorkspaceMember();
        }
      }
    }

    /**
     * @description Manages denormalized user task access.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list): Authenticated user can read their own user task data.
     * @allow (create): Denied, should be created by backend function
     * @allow (update): Denied, should be updated by backend function
     * @allow (delete): Denied, should be deleted by backend function
     * @deny (get, list): Authenticated user cannot read other user's user task data.
     * @deny (create): Unauthenticated users cannot create user task data.
     * @principle Enforces user-ownership for user task access.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

     /**
      * @description Manages invitations to workspaces.
      * @path /invites/{inviteId}
      * @allow (create): Allows anyone to create an invite.
      * @allow (get, list, update, delete): Only workspace members can read, update, or delete invites.
      * @deny: Prevents non-members from accessing invites.
      * @principle: Anyone can create an invite, but it is protected from modification by non-workspace members.
      */
    match /invites/{inviteId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function getWorkspaceId() {
            return request.resource.data.workspaceId;
        }

        function isWorkspaceMember() {
          return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
        }

        allow create: if isSignedIn(); // Backend validates invite validity

        allow get: if isSignedIn() && isWorkspaceMember();
        allow list: if isSignedIn() && isWorkspaceMember();
        allow update: if isSignedIn() && isWorkspaceMember() && resource != null;
        allow delete: if isSignedIn() && isWorkspaceMember() && resource != null;
    }
  }
}