/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for workspaces and
 * an ownership model for user profiles.  It uses denormalization to avoid
 * complex queries in security rules.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles.  Access is restricted to the
 *   owner (the user with the matching UID).
 * - /workspaces/{workspaceId}: Stores workspace data. Access is controlled by
 *   user roles defined within the workspace document (e.g., admin, contributor,
 *   viewer).
 * - Subcollections under /workspaces/{workspaceId}: Data is scoped to workspace
 *   members based on roles.
 * - /user-tasks/{userId}/tasks/{taskId}:  Denormalized tasks for users.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data.
 * - Workspace access is governed by roles defined in the workspace document.
 * - Listing of users is disallowed for privacy.
 *
 * Denormalization for Authorization:
 * Workspace documents store user roles directly within the `users` map, avoiding
 * the need for separate membership lookups.  `UserTask` documents are denormalized
 * to allow efficient per-user task queries.
 *
 * Structural Segregation:
 * There is no need to segregate public/private content.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (read, write) User with matching UID can access their profile.
     * @deny (read, write) User attempts to access another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == request.resource.data.uid;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to workspace data.
     * @path /workspaces/{workspaceId}
     * @allow (read) Workspace members can read workspace data.
     * @allow (write) Workspace admins can create/update/delete workspace data.
     * @deny (read) Non-workspace members cannot read workspace data.
     * @deny (write) Non-workspace admins cannot create/update/delete workspace data.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && request.auth.uid in resource.data.users;
      }

      function isWorkspaceAdmin(workspaceId) {
          return isSignedIn() && resource.data.users[request.auth.uid].role == 'admin';
      }

        function isCreatingValidWorkspace() {
            return request.resource.data.ownerId == request.auth.uid && request.auth.uid in request.resource.data.users && request.resource.data.users[request.auth.uid].role == 'admin';
        }

        function isExistingWorkspaceAdmin(workspaceId) {
            return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isCreatingValidWorkspace();
      allow update: if isSignedIn() && isExistingWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isExistingWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to company data within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (read) Workspace members can read company data.
     * @allow (write) Workspace admins can create/update/delete company data.
     * @deny (read) Non-workspace members cannot read company data.
     * @deny (write) Non-workspace admins cannot create/update/delete company data.
     * @principle Enforces role-based access control for companies within workspaces.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      function isWorkspaceMember(workspaceId) {
          return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role != null;
      }

      function isWorkspaceAdmin(workspaceId) {
           return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role == 'admin';
      }

        function isExistingWorkspaceAdmin(workspaceId) {
            return isWorkspaceAdmin(workspaceId);
        }

        function isWorkspaceMemberWithoutGet(workspaceId) {
          return isSignedIn() && resource.data.users[request.auth.uid].role != null;
        }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to project data within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (read) Workspace members can read project data.
     * @allow (write) Workspace admins can create/update/delete project data.
     * @deny (read) Non-workspace members cannot read project data.
     * @deny (write) Non-workspace admins cannot create/update/delete project data.
     * @principle Enforces role-based access control for projects within companies.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function getWorkspace(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }

        function isWorkspaceMember(workspaceId) {
            return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role != null;
        }

        function isWorkspaceAdmin(workspaceId) {
            return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role == 'admin';
        }

        function isExistingWorkspaceAdmin(workspaceId) {
            return isWorkspaceAdmin(workspaceId);
        }

      function isWorkspaceMemberWithoutGet(workspaceId) {
          return isSignedIn() && resource.data.users[request.auth.uid].role != null;
      }

        allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
        allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
        allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
        allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to silo data within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (read) Workspace members can read silo data.
     * @allow (write) Workspace admins can create/update/delete silo data.
     * @deny (read) Non-workspace members cannot read silo data.
     * @deny (write) Non-workspace admins cannot create/update/delete silo data.
     * @principle Enforces role-based access control for silos within projects.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function getWorkspace(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }

        function isWorkspaceMember(workspaceId) {
            return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role != null;
        }

        function isWorkspaceAdmin(workspaceId) {
            return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role == 'admin';
        }

        function isExistingWorkspaceAdmin(workspaceId) {
            return isWorkspaceAdmin(workspaceId);
        }

      function isWorkspaceMemberWithoutGet(workspaceId) {
          return isSignedIn() && resource.data.users[request.auth.uid].role != null;
      }

        allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
        allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
        allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
        allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to task data within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (read) Workspace members can read task data.
     * @allow (write) Workspace admins can create/update/delete task data.
     * @deny (read) Non-workspace members cannot read task data.
     * @deny (write) Non-workspace admins cannot create/update/delete task data.
     * @principle Enforces role-based access control for tasks within silos.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function getWorkspace(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }

        function isWorkspaceMember(workspaceId) {
            return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role != null;
        }

        function isWorkspaceAdmin(workspaceId) {
            return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role == 'admin';
        }

        function isExistingWorkspaceAdmin(workspaceId) {
            return isWorkspaceAdmin(workspaceId);
        }

      function isWorkspaceMemberWithoutGet(workspaceId) {
          return isSignedIn() && resource.data.users[request.auth.uid].role != null;
      }

        allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
        allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
        allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
        allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to denormalized task data for a user.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (read, write) User with matching UID can access their task data.
     * @deny (read, write) User attempts to access another user's task data.
     * @principle Enforces document ownership for user tasks.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to sale data within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (read) Workspace members can read sale data.
     * @allow (write) Workspace admins can create/update/delete sale data.
     * @deny (read) Non-workspace members cannot read sale data.
     * @deny (write) Non-workspace admins cannot create/update/delete sale data.
     * @principle Enforces role-based access control for sales within projects.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function getWorkspace(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }

        function isWorkspaceMember(workspaceId) {
            return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role != null;
        }

        function isWorkspaceAdmin(workspaceId) {
            return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role == 'admin';
        }

        function isExistingWorkspaceAdmin(workspaceId) {
            return isWorkspaceAdmin(workspaceId);
        }

      function isWorkspaceMemberWithoutGet(workspaceId) {
          return isSignedIn() && resource.data.users[request.auth.uid].role != null;
      }

        allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
        allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
        allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
        allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to invite data.
     * @path /invites/{inviteId}
     * @allow (read) Anyone can read an invite.
     * @allow (create) Only admins can create an invite.
     * @deny (update, delete) Only admins can update and delete an invite.
     * @principle Controls who can read and write invite data.
     */
    match /invites/{inviteId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspaceIdFromInvite() {
        return resource.data.workspaceId;
      }

      function getWorkspace(workspaceId) {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && getWorkspace(workspaceId).data.users[request.auth.uid].role == 'admin';
      }

        function isExistingWorkspaceAdmin(workspaceId) {
            return isWorkspaceAdmin(workspaceId);
        }

      allow get: if true; // Invites are publicly readable so anyone can accept one
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceAdmin(request.resource.data.workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(resource.data.workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(resource.data.workspaceId);
    }
  }
}