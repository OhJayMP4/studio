/**
 * @fileoverview Firestore Security Rules for the application.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isMemberOfWorkspace(workspaceId) {
      return isSignedIn() && 
             workspaceId != null && 
             workspaceId != "" &&
             request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;
    }

    function isWorkspaceAdmin(workspaceId) {
      return isSignedIn() && 
             workspaceId != null && 
             workspaceId != "" &&
             get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if isSignedIn() && isOwner(userId);
    }

    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if false;

      match /chatMessages/{messageId} {
        allow read, create: if isMemberOfWorkspace(workspaceId);
        allow update, delete: if isMemberOfWorkspace(workspaceId) && isOwner(resource.data.senderId);
      }

      match /companies/{companyId} {
        allow read, write: if isMemberOfWorkspace(workspaceId);

        match /projects/{projectId} {
          allow read, write: if isMemberOfWorkspace(workspaceId);

          match /silos/{siloId} {
            allow read, write: if isMemberOfWorkspace(workspaceId);

            match /tasks/{taskId} {
              allow read, write: if isMemberOfWorkspace(workspaceId);

              match /comments/{commentId=**} {
                allow get, list, create: if isMemberOfWorkspace(workspaceId);
                allow update, delete: if isMemberOfWorkspace(workspaceId) && isOwner(resource.data.createdBy);
              }
            }
          }
          
          match /sales/{saleId} {
            allow read, write: if isMemberOfWorkspace(workspaceId);
          }
        }
        
        match /socialPosts/{postId} {
          allow read, write: if isMemberOfWorkspace(workspaceId);
        }

        match /socialAccounts/{accountId} {
          allow read, write: if isWorkspaceAdmin(workspaceId);
        }
      }
    }
    
     match /user-tasks/{userId}/tasks/{taskId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isMemberOfWorkspace(request.query.workspaceId));
        allow create: if isSignedIn() && isMemberOfWorkspace(request.resource.data.workspaceId);
        allow update, delete: if isSignedIn() && (isOwner(userId) || isWorkspaceAdmin(resource.data.workspaceId));
    }

    match /invites/{inviteId} {
      allow create: if isWorkspaceAdmin(request.resource.data.workspaceId);
      allow get, list, update, delete: if false;
    }

    match /notifications/{workspaceId}/activities/{activityId} {
      allow read, list, update: if isMemberOfWorkspace(workspaceId);
      allow create, delete: if false;
    }

    match /presence/{workspaceId}/users/{userId} {
      allow read, list: if isMemberOfWorkspace(workspaceId);
      allow create, update: if isOwner(userId) && isMemberOfWorkspace(workspaceId);
    }

    match /user-workspace-prefs/{docId} {
        allow read: if isSignedIn() && request.auth.uid == docId.split('-')[0];
        allow write: if isSignedIn() && request.auth.uid == resource.data.uid;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
    }

    match /workspace-files/{fileId} {
      allow list: if isSignedIn();
      allow get, update: if isMemberOfWorkspace(resource.data.workspaceId);
      allow create: if isSignedIn() && isMemberOfWorkspace(request.resource.data.workspaceId);
      allow delete: if isWorkspaceAdmin(request.resource.data.workspaceId);
    }
  }
}