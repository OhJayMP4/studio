/**
 * @fileoverview Firestore Security Rules for SaturnSync application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership and hierarchical model. Users can only
 * create or modify their own user documents. Workspaces are owned by a single user, and
 * data within workspaces (companies, projects, silos, tasks) follows a parent-child
 * relationship where only workspace admins can manage the workspace's resources.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, accessible only by the user themselves.
 * - /workspaces/{workspaceId}: Workspaces owned by a user.
 * - /workspaces/{workspaceId}/users/{userId}: Users who are part of a workspace, defined by a role
 * - /workspaces/{workspaceId}/companies/{companyId}: Companies within a workspace.
 * - /companies/{companyId}/projects/{projectId}: Projects within a company.
 * - /projects/{projectId}/silos/{siloId}: Silos within a project.
 * - /silos/{siloId}/tasks/{taskId}: Tasks within a silo.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user documents.
 * - Workspace ownership is enforced via the `ownerId` field. Only the workspace owner can
 *   create, update, or delete workspaces.
 * - Listing of users is disallowed to prevent data leaks.
 * - The WorkspaceUser document determines who is part of a workspace and their role. This is used
 *   to determine access to resources within the workspace.
 *
 * Denormalization for Authorization:
 * - WorkspaceUser documents are used to determine which users have access to workspaces and their
 *   resources (companies, projects, silos, tasks). The role defined in WorkspaceUser is used to
 *   determine if a user can create, update, or delete a workspace's resources.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to a user's own profile.
     * @path /users/{userId}
     * @allow (create) User 'testuser' with id matching {userId} can create their profile.
     * @allow (get) User 'testuser' with id matching {userId} can get their profile.
     * @allow (update) User 'testuser' with id matching {userId} can update their profile.
     * @allow (delete) User 'testuser' with id matching {userId} can delete their profile.
     * @deny (create) User 'testuser' attempts to create a profile with a different {userId}.
     * @deny (get) User 'testuser' attempts to get a profile with a different {userId}.
     * @deny (update) User 'testuser' attempts to update a profile with a different {userId}.
     * @deny (delete) User 'testuser' attempts to delete a profile with a different {userId}.
     * @principle Enforces user-ownership.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isOwner(userId) && resource.data.id == userId;
    }

    /**
     * @description Grants access to workspaces, enforcing owner-based access.
     * @path /workspaces/{workspaceId}
     * @allow (create) User 'testuser' can create a workspace with ownerId matching their uid.
     * @allow (get) Any user can read a workspace.
     * @allow (list) Any user can list workspaces.
     * @allow (update) User 'testuser' can update a workspace they own.
     * @allow (delete) User 'testuser' can delete a workspace they own.
     * @deny (create) User 'testuser' attempts to create a workspace with ownerId not matching their uid.
     * @deny (update) User 'testuser' attempts to update a workspace they don't own.
     * @deny (delete) User 'testuser' attempts to delete a workspace they don't own.
     * @principle Enforces workspace ownership for writes, public read.
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceOwner(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }

      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isWorkspaceOwner(workspaceId);
      allow delete: if isWorkspaceOwner(workspaceId);
    }

    /**
     * @description Grants access to workspace users, enforcing workspace admin access.
     * @path /workspaces/{workspaceId}/users/{userId}
     * @allow (create) Workspace admin can add a user to the workspace.
     * @allow (get) Any user in the workspace can read user information.
     * @allow (list) Any user in the workspace can list users.
     * @allow (update) Workspace admin can update user information.
     * @allow (delete) Workspace admin can remove a user from the workspace.
     * @deny (create) Non-admin attempts to create a user in the workspace.
     * @deny (update) Non-admin attempts to update a user in the workspace.
     * @deny (delete) Non-admin attempts to delete a user in the workspace.
     * @principle Enforces workspace admin role for managing workspace users.
     */
    match /workspaces/{workspaceId}/users/{userId} {
        function isInWorkspace(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.userId == request.auth.uid;
        }

        function isAdmin(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin';
        }

        allow get, list: if isInWorkspace(workspaceId);
        allow create: if isAdmin(workspaceId);
        allow update: if isAdmin(workspaceId);
        allow delete: if isAdmin(workspaceId);
    }

    /**
     * @description Grants access to companies within a workspace, enforcing workspace admin access.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (create) Workspace admin can create a company in the workspace.
     * @allow (get) Any user in the workspace can read company information.
     * @allow (list) Any user in the workspace can list companies.
     * @allow (update) Workspace admin can update company information.
     * @allow (delete) Workspace admin can delete a company from the workspace.
     * @deny (create) Non-admin attempts to create a company in the workspace.
     * @deny (update) Non-admin attempts to update a company in the workspace.
     * @deny (delete) Non-admin attempts to delete a company in the workspace.
     * @principle Enforces workspace admin role for managing companies.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
        function isInWorkspace(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.userId == request.auth.uid;
        }

        function isAdmin(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin';
        }

        allow get, list: if isInWorkspace(workspaceId);
        allow create: if isAdmin(workspaceId);
        allow update: if isAdmin(workspaceId);
        allow delete: if isAdmin(workspaceId);
    }

    /**
     * @description Grants access to projects within a company, enforcing workspace admin access.
     * @path /companies/{companyId}/projects/{projectId}
     * @allow (create) Workspace admin can create a project in the company.
     * @allow (get) Any user in the workspace can read project information.
     * @allow (list) Any user in the workspace can list projects.
     * @allow (update) Workspace admin can update project information.
     * @allow (delete) Workspace admin can delete a project from the company.
     * @deny (create) Non-admin attempts to create a project in the company.
     * @deny (update) Non-admin attempts to update a project in the company.
     * @deny (delete) Non-admin attempts to delete a project from the company.
     * @principle Enforces workspace admin role for managing projects.
     */
    match /companies/{companyId}/projects/{projectId} {
        function getWorkspaceIdFromCompany(companyId) {
            return get(/databases/$(database)/documents/workspaces/$(companyId.split('/')[1])/companies/$(companyId)).data.workspaceId;
        }

        function isInWorkspace(companyId) {
            let workspaceId = getWorkspaceIdFromCompany(companyId);
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.userId == request.auth.uid;
        }

        function isAdmin(companyId) {
             let workspaceId = getWorkspaceIdFromCompany(companyId);
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin';
        }

        allow get, list: if isInWorkspace(companyId);
        allow create: if isAdmin(companyId);
        allow update: if isAdmin(companyId);
        allow delete: if isAdmin(companyId);
    }

    /**
     * @description Grants access to silos within a project, enforcing workspace admin access.
     * @path /projects/{projectId}/silos/{siloId}
     * @allow (create) Workspace admin can create a silo in the project.
     * @allow (get) Any user in the workspace can read silo information.
     * @allow (list) Any user in the workspace can list silos.
     * @allow (update) Workspace admin can update silo information.
     * @allow (delete) Workspace admin can delete a silo from the project.
     * @deny (create) Non-admin attempts to create a silo in the project.
     * @deny (update) Non-admin attempts to update a silo in the project.
     * @deny (delete) Non-admin attempts to delete a silo from the project.
     * @principle Enforces workspace admin role for managing silos.
     */
    match /projects/{projectId}/silos/{siloId} {
         function getWorkspaceIdFromProject(projectId) {
            return get(/databases/$(database)/documents/companies/$(projectId.split('/')[1])/projects/$(projectId)).data.companyId;
        }

        function isInWorkspace(projectId) {
            let companyId = getWorkspaceIdFromProject(projectId);
            return get(/databases/$(database)/documents/workspaces/$(companyId.split('/')[1])/users/$(request.auth.uid)).data.userId == request.auth.uid;
        }

        function isAdmin(projectId) {
            let companyId = getWorkspaceIdFromProject(projectId);
            return get(/databases/$(database)/documents/workspaces/$(companyId.split('/')[1])/users/$(request.auth.uid)).data.role == 'admin';
        }

        allow get, list: if isInWorkspace(projectId);
        allow create: if isAdmin(projectId);
        allow update: if isAdmin(projectId);
        allow delete: if isAdmin(projectId);
    }

    /**
     * @description Grants access to tasks within a silo, enforcing workspace admin access.
     * @path /silos/{siloId}/tasks/{taskId}
     * @allow (create) Workspace admin can create a task in the silo.
     * @allow (get) Any user in the workspace can read task information.
     * @allow (list) Any user in the workspace can list tasks.
     * @allow (update) Workspace admin can update task information.
     * @allow (delete) Workspace admin can delete a task from the silo.
     * @deny (create) Non-admin attempts to create a task in the silo.
     * @deny (update) Non-admin attempts to update a task in the silo.
     * @deny (delete) Non-admin attempts to delete a task from the silo.
     * @principle Enforces workspace admin role for managing tasks.
     */
    match /silos/{siloId}/tasks/{taskId} {
         function getWorkspaceIdFromSilo(siloId) {
            return get(/databases/$(database)/documents/projects/$(siloId.split('/')[1])/silos/$(siloId)).data.projectId;
        }

        function isInWorkspace(siloId) {
            let projectId = getWorkspaceIdFromSilo(siloId);
            let companyId = get(/databases/$(database)/documents/companies/$(projectId.split('/')[1])/projects/$(projectId)).data.companyId;
            return get(/databases/$(database)/documents/workspaces/$(companyId.split('/')[1])/users/$(request.auth.uid)).data.userId == request.auth.uid;
        }

        function isAdmin(siloId) {
            let projectId = getWorkspaceIdFromSilo(siloId);
             let companyId = get(/databases/$(database)/documents/companies/$(projectId.split('/')[1])/projects/$(projectId)).data.companyId;
            return get(/databases/$(database)/documents/workspaces/$(companyId.split('/')[1])/users/$(request.auth.uid)).data.role == 'admin';
        }

        allow get, list: if isInWorkspace(siloId);
        allow create: if isAdmin(siloId);
        allow update: if isAdmin(siloId);
        allow delete: if isAdmin(siloId);
    }
  }
}