/**
 * @fileoverview Firestore Security Rules for Saturn App
 *
 * Core Philosophy: This ruleset prioritizes secure authorization based on
 * ownership and roles within workspaces. It avoids complex data validation
 * during this prototyping phase, focusing on who can access what data.
 *
 * Data Structure:
 * - User profiles are stored in `/users/{userId}` and are only accessible
 *   by the user themselves.
 * - Workspaces are stored in `/workspaces/{workspaceId}`. Access is
 *   controlled by workspace ownership and membership.
 * - Companies, projects, silos, and tasks are nested under workspaces.
 *   Access to these resources is determined by workspace membership.
 * - User-specific task lists are denormalized in `/user-tasks/{userId}`
 *   for efficient user-specific queries.
 * - Invites are stored in `/invites/{inviteId}`.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Workspace ownership grants full control over the workspace and its
 *   nested resources.
 * - Workspace members have read access to workspace data, and their roles
 *   (admin, contributor, viewer) determine their write access.
 * - User listing is disallowed for privacy reasons.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map, which stores user roles
 *   within the workspace. This denormalization avoids costly `get()`
 *   operations to a separate membership collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, update, delete) if the user is the owner of the profile.
     * @allow (create) if the user's auth UID matches the document ID.
     * @deny (get, update, delete) if the user is not the owner of the profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Controls access to workspace data.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create, update, delete) if the user is the owner of the workspace.
     * @deny (create, update, delete) if the user is not the owner of the workspace.
     * @principle Enforces workspace ownership and membership for access control.
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceOwner(workspaceId) {
          return resource.data.ownerId == request.auth.uid;
      }

      function isWorkspaceMember(workspaceId) {
          return request.auth.uid in resource.data.users;
      }

      function isAdmin(workspaceId) {
          return resource.data.users[request.auth.uid].role == 'admin';
      }

      function isContributor(workspaceId) {
          return resource.data.users[request.auth.uid].role == 'contributor';
      }

      function canUpdateWorkspace(workspaceId) {
          return isWorkspaceOwner(workspaceId) || isAdmin(workspaceId);
      }

      function isSignedIn() {
          return request.auth != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && canUpdateWorkspace(workspaceId) && resource != null;
      allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;

        /**
         * @description Controls access to company data within a workspace.
         * @path /workspaces/{workspaceId}/companies/{companyId}
         * @allow (get, list) if the user is a member of the workspace.
         * @allow (create, update, delete) if the user is an admin or the owner of the workspace.
         * @deny (create, update, delete) if the user is not an admin or the owner of the workspace.
         * @principle Enforces workspace membership and admin roles for company access.
         */
        match /companies/{companyId} {
            function getWorkspaceId() {
                return request.path[3];
            }

            function isSignedIn() {
              return request.auth != null;
            }

            function isWorkspaceMember() {
              return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
            }

            function isAdmin() {
                return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'admin';
            }

            function isContributor() {
                return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'contributor';
            }

            function isWorkspaceOwner() {
              return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.ownerId == request.auth.uid;
            }

            function canUpdateCompany() {
              return isWorkspaceOwner() || isAdmin();
            }

            allow get, list: if isSignedIn() && isWorkspaceMember();
            allow create: if isSignedIn() && canUpdateCompany();
            allow update: if isSignedIn() && canUpdateCompany() && resource != null;
            allow delete: if isSignedIn() && canUpdateCompany() && resource != null;

                /**
                 * @description Controls access to project data within a company.
                 * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
                 * @allow (get, list) if the user is a member of the workspace.
                 * @allow (create, update, delete) if the user is an admin or the owner of the workspace.
                 * @deny (create, update, delete) if the user is not an admin or the owner of the workspace.
                 * @principle Enforces workspace membership and admin roles for project access.
                 */
                match /projects/{projectId} {
                    function getWorkspaceId() {
                        return request.path[3];
                    }

                    function isSignedIn() {
                      return request.auth != null;
                    }

                    function isWorkspaceMember() {
                      return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
                    }

                    function isAdmin() {
                        return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'admin';
                    }

                    function isContributor() {
                        return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'contributor';
                    }

                    function isWorkspaceOwner() {
                      return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.ownerId == request.auth.uid;
                    }

                    function canUpdateProject() {
                      return isWorkspaceOwner() || isAdmin();
                    }

                    allow get, list: if isSignedIn() && isWorkspaceMember();
                    allow create: if isSignedIn() && canUpdateProject();
                    allow update: if isSignedIn() && canUpdateProject() && resource != null;
                    allow delete: if isSignedIn() && canUpdateProject() && resource != null;

                    /**
                     * @description Controls access to silo data within a project.
                     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
                     * @allow (get, list) if the user is a member of the workspace.
                     * @allow (create, update, delete) if the user is an admin or the owner of the workspace.
                     * @deny (create, update, delete) if the user is not an admin or the owner of the workspace.
                     * @principle Enforces workspace membership and admin roles for silo access.
                     */
                    match /silos/{siloId} {
                        function getWorkspaceId() {
                            return request.path[3];
                        }

                        function isSignedIn() {
                          return request.auth != null;
                        }

                        function isWorkspaceMember() {
                          return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
                        }

                        function isAdmin() {
                            return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'admin';
                        }

                        function isContributor() {
                            return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'contributor';
                        }

                        function isWorkspaceOwner() {
                          return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.ownerId == request.auth.uid;
                        }

                        function canUpdateSilo() {
                          return isWorkspaceOwner() || isAdmin();
                        }

                        allow get, list: if isSignedIn() && isWorkspaceMember();
                        allow create: if isSignedIn() && canUpdateSilo();
                        allow update: if isSignedIn() && canUpdateSilo() && resource != null;
                        allow delete: if isSignedIn() && canUpdateSilo() && resource != null;

                        /**
                         * @description Controls access to task data within a silo.
                         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
                         * @allow (get, list) if the user is a member of the workspace.
                         * @allow (create, update, delete) if the user is a contributor, admin, or the owner of the workspace.
                         * @deny (create, update, delete) if the user is not a contributor, admin, or the owner of the workspace.
                         * @principle Enforces workspace membership and contributor/admin roles for task access.
                         */
                        match /tasks/{taskId} {
                            function getWorkspaceId() {
                                return request.path[3];
                            }

                            function isSignedIn() {
                              return request.auth != null;
                            }

                            function isWorkspaceMember() {
                              return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
                            }

                            function isAdmin() {
                                return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'admin';
                            }

                            function isContributor() {
                                return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'contributor';
                            }

                            function isWorkspaceOwner() {
                              return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.ownerId == request.auth.uid;
                            }

                            function canUpdateTask() {
                                return isWorkspaceOwner() || isAdmin() || isContributor();
                            }

                            allow get, list: if isSignedIn() && isWorkspaceMember();
                            allow create: if isSignedIn() && canUpdateTask();
                            allow update: if isSignedIn() && canUpdateTask() && resource != null;
                            allow delete: if isSignedIn() && canUpdateTask() && resource != null;
                        }
                    }
                  /**
                   * @description Controls access to sale data within a project.
                   * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
                   * @allow (get, list) if the user is a member of the workspace.
                   * @allow (create, update, delete) if the user is an admin or the owner of the workspace.
                   * @deny (create, update, delete) if the user is not an admin or the owner of the workspace.
                   * @principle Enforces workspace membership and admin roles for sale access.
                   */
                  match /sales/{saleId} {
                      function getWorkspaceId() {
                          return request.path[3];
                      }

                    function isSignedIn() {
                      return request.auth != null;
                    }

                    function isWorkspaceMember() {
                      return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
                    }

                    function isAdmin() {
                      return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'admin';
                    }

                    function isContributor() {
                      return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid].role == 'contributor';
                    }

                    function isWorkspaceOwner() {
                      return get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.ownerId == request.auth.uid;
                    }

                    function canUpdateSale() {
                      return isWorkspaceOwner() || isAdmin();
                    }

                    allow get, list: if isSignedIn() && isWorkspaceMember();
                    allow create: if isSignedIn() && canUpdateSale();
                    allow update: if isSignedIn() && canUpdateSale() && resource != null;
                    allow delete: if isSignedIn() && canUpdateSale() && resource != null;
                  }
                }
        }
    }

    /**
     * @description Controls access to denormalized user task data.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) if the user is the owner of the task.
     * @allow (create, update, delete) if the user is the owner of the task.
     * @deny (get, update, delete) if the user is not the owner of the task.
     * @principle Enforces document ownership for user-specific tasks.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource != null;
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Controls access to invite data.
     * @path /invites/{inviteId}
     * @allow (get) if the invite's email matches the authenticated user's email.
     * @allow (create) if the request contains a valid token for the invite.
     * @deny (list, update, delete) always.
     * @principle Restricts access to invites based on email and requires a valid token for creation.
     */
    match /invites/{inviteId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.token.email == resource.data.email;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if false;
    }
  }
}