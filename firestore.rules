/**
 * @fileoverview Firestore Security Rules.
 *
 * Core Philosophy:
 * This ruleset is in prototyping mode. All access is open.
 *
 * Data Structure:
 * The Firestore database contains collections for users, workspaces, companies, projects, silos, tasks, and sales.
 * The hierarchy is /users/{userId}, /workspaces/{workspaceId}, /workspaces/{workspaceId}/companies/{companyId},
 * /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId},
 * /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId},
 * /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}, and
 * /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}.
 *
 * Key Security Decisions:
 * In prototyping mode, all reads and writes are allowed for all users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /workspaces/{workspaceId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}