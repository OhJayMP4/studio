rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getWorkspaceData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isWorkspaceMember(workspaceId) {
        let workspaceData = getWorkspaceData(workspaceId);
        return isSignedIn() && request.auth.uid in workspaceData.memberIds;
    }

    function isWorkspaceAdmin(workspaceId) {
      let workspaceData = getWorkspaceData(workspaceId);
      return isSignedIn() && workspaceData.users[request.auth.uid].role == 'admin';
    }

    // User Profiles
    match /users/{userId} {
      // Any signed-in user can create their own profile.
      allow create: if isSignedIn();
      // Only the user themselves can read or write their own profile.
      allow read, update: if isUser(userId);
      // Users cannot delete their profiles for now.
      allow delete: if false;
    }

    // Workspaces
    match /workspaces/{workspaceId} {
      // Any signed-in user can create a workspace.
      allow create: if isSignedIn();
      // Only members of the workspace can read it. Admins can update it.
      allow read: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      // Only admins can delete a workspace.
      allow delete: if isWorkspaceAdmin(workspaceId);

      // Subcollections within a workspace
      match /companies/{companyId} {
        allow read, list: if isWorkspaceMember(workspaceId);
        allow create, update, delete: if isWorkspaceAdmin(workspaceId);

        match /projects/{projectId} {
            allow read, list: if isWorkspaceMember(workspaceId);
            allow create, update, delete: if isWorkspaceAdmin(workspaceId);
            
            match /silos/{siloId} {
                allow read, list: if isWorkspaceMember(workspaceId);
                allow create, update, delete: if isWorkspaceAdmin(workspaceId);

                 match /tasks/{taskId} {
                    allow read, list: if isWorkspaceMember(workspaceId);
                    // Any workspace member can create, update, or delete tasks
                    allow write: if isWorkspaceMember(workspaceId);
                 }
            }
             match /sales/{saleId} {
                allow read, list: if isWorkspaceMember(workspaceId);
                allow create, update, delete: if isWorkspaceAdmin(workspaceId);
            }
        }
      }
    }
    
    // Denormalized tasks for user-specific queries
    match /user-tasks/{userId}/{path=**} {
        // Only the assigned user can read their own task list.
        allow read: if isUser(userId);
        // Writes are handled by Cloud Functions for security.
        allow write: if false;
    }

    // Invitations
    match /invites/{inviteId} {
        // Admins can create invites.
        allow create: if isWorkspaceAdmin(request.resource.data.workspaceId);
        // Any authenticated user can read an invite to verify it, the function handles the logic.
        allow read: if isSignedIn();
        // Deletion is handled by the Cloud Function after use or expiration.
        allow delete: if false;
    }
  }
}
