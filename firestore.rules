
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isWorkspaceMember(workspaceId) {
      return isUserAuthenticated() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
    }
    
    function isWorkspaceAdmin(workspaceId) {
      return isUserAuthenticated() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }
    
    function isWorkspaceContributor(workspaceId) {
      let userRole = get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role;
      return isUserAuthenticated() && (userRole == 'admin' || userRole == 'contributor');
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if isUserAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Invites
    match /invites/{inviteId} {
        // Public read for client-side query by token.
        allow read: if isUserAuthenticated();
        // Allow admins of the target workspace to create invites.
        allow create: if isWorkspaceAdmin(request.resource.data.workspaceId);
        // Only the invited user can delete (implicitly by using it).
        allow delete: if isUserAuthenticated();
    }
    
    // Denormalized user tasks for quick lookups
    match /user-tasks/{userId}/{taskId} {
      // User can read their own tasks.
      allow read: if isOwner(userId);
      // Allow users to create their own tasks, OR allow workspace admins to create tasks for others.
      allow write: if isOwner(userId) || isWorkspaceAdmin(request.resource.data.workspaceId);
    }

    // Workspaces and subcollections
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      // Only owner can delete a workspace.
      allow delete: if isOwner(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId);
      // Admins can update workspace details.
      allow update: if isWorkspaceAdmin(workspaceId);
      allow create: if isOwner(request.resource.data.ownerId);
      
      match /companies/{companyId} {
        allow read, write: if isWorkspaceMember(workspaceId);
        
        match /projects/{projectId} {
          allow read, write: if isWorkspaceMember(workspaceId);
          
           match /sales/{saleId} {
             allow read, write: if isWorkspaceMember(workspaceId);
           }
          
          match /silos/{siloId} {
            allow read, write: if isWorkspaceMember(workspaceId);
            
            match /tasks/{taskId} {
              allow read: if isWorkspaceMember(workspaceId);
              // Contributors can create/update tasks
              allow write: if isWorkspaceContributor(workspaceId);
            }
          }
        }
      }
    }
  }
}
