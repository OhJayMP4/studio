/**
 * @fileoverview Firestore Security Rules for SaturnSync application.
 *
 * Core Philosophy:
 * This ruleset enforces a multi-tenant security model based on workspaces.
 * Users can only access workspaces, companies, projects, silos, and tasks
 * that they are explicitly associated with.  User documents themselves are private.
 *
 * Data Structure:
 * The data is organized hierarchically:
 * /users/{userId} - User profile information.
 * /workspaces/{workspaceId} - Workspaces containing companies and users.
 * /workspaces/{workspaceId}/users/{userId} - Users that are members of the workspace.
 * /workspaces/{workspaceId}/companies/{companyId} - Companies within a workspace.
 * /companies/{companyId}/projects/{projectId} - Projects within a company.
 * /projects/{projectId}/silos/{siloId} - Silos within a project.
 * /silos/{siloId}/tasks/{taskId} - Tasks within a silo.
 *
 * Key Security Decisions:
 * - Listing of users is disallowed to protect privacy.
 * - Workspaces are the root of the multi-tenant data model.
 * - Authorization is based on workspace membership and roles within the workspace.
 * - Data validation is relaxed to allow for rapid prototyping.
 *
 * Denormalization for Authorization:
 * - Workspace membership is managed in the /workspaces/{workspaceId}/users/{userId} subcollection.
 * This is critical for performant rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.id == userId;
    }

    /**
     * @description Allows the user to read and write if they are a member of the workspace.
     */
    function isWorkspaceMember(workspaceId) {
        return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
    }

    /**
     * @description Checks if the user has the specified role in the workspace.
     */
    function hasWorkspaceRole(workspaceId, role) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == role;
    }
    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User D1fXLMlQbYOklZKeYOqdP2wmMmh2 can create their own profile.
     * @deny (create) User D1fXLMlQbYOklZKeYOqdP2wmMmh3 cannot create profile for user D1fXLMlQbYOklZKeYOqdP2wmMmh2.
     * @allow (get) User D1fXLMlQbYOklZKeYOqdP2wmMmh2 can read their own profile.
     * @deny (get) User D1fXLMlQbYOklZKeYOqdP2wmMmh3 cannot read profile for user D1fXLMlQbYOklZKeYOqdP2wmMmh2.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for workspaces.
     * @path /workspaces/{workspaceId}
     * @allow (create) User owns a workspace.
     * @deny (create) User does not own a workspace.
     * @allow (get) User can read a workspace if they are a member.
     * @deny (get) User cannot read a workspace if they are not a member.
     * @principle Enforces workspace ownership for writes and restricts access to workspace members.
     */
    match /workspaces/{workspaceId} {
      allow get, list: if isWorkspaceMember(workspaceId);
      allow create: if isSignedIn();
      allow update: if isWorkspaceMember(workspaceId) && hasWorkspaceRole(workspaceId, 'admin');
      allow delete: if isWorkspaceMember(workspaceId) && hasWorkspaceRole(workspaceId, 'admin');
    }

    /**
     * @description Rules for workspace users.
     * @path /workspaces/{workspaceId}/users/{userId}
     * @allow (create) Workspace admins can add users to the workspace.
     * @deny (create) Users cannot add themselves or others to a workspace without admin rights.
     * @allow (get) Workspace members can read workspace user data.
     * @deny (get) Users cannot read workspace user data if they are not members.
     * @principle Manages workspace membership and roles.
     */
    match /workspaces/{workspaceId}/users/{userId} {
        allow get: if isWorkspaceMember(workspaceId);
        allow list: if false;
        allow create: if isWorkspaceMember(workspaceId) && hasWorkspaceRole(workspaceId, 'admin');
        allow update: if isWorkspaceMember(workspaceId) && hasWorkspaceRole(workspaceId, 'admin');
        allow delete: if isWorkspaceMember(workspaceId) && hasWorkspaceRole(workspaceId, 'admin');
    }

      /**
       * @description Rules for companies within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (create) Workspace members can create companies.
       * @deny (create) Users cannot create companies if they are not members of the workspace.
       * @allow (get) Workspace members can read company data.
       * @deny (get) Users cannot read company data if they are not members of the workspace.
       * @principle Enforces access based on workspace membership.
       */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get, list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceMember(workspaceId);
      allow delete: if isWorkspaceMember(workspaceId);
    }

    /**
     * @description Rules for projects within a company.
     * @path /companies/{companyId}/projects/{projectId}
     * @allow (create) Workspace members can create projects within a company.
     * @deny (create) Users cannot create projects if they are not members of the parent workspace.
     * @allow (get) Workspace members can read project data.
     * @deny (get) Users cannot read project data if they are not members of the parent workspace.
     * @principle Enforces access based on workspace membership.
     */
    match /companies/{companyId}/projects/{projectId} {
        allow get, list, create, update, delete: if isCompanyInWorkspace(companyId);
        function isCompanyInWorkspace(companyId) {
            return get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId != null && isWorkspaceMember(get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId);
        }
    }

    /**
     * @description Rules for silos within a project.
     * @path /projects/{projectId}/silos/{siloId}
     * @allow (create) Workspace members can create silos.
     * @deny (create) Users cannot create silos if they are not members of the parent workspace.
     * @allow (get) Workspace members can read silo data.
     * @deny (get) Users cannot read silo data if they are not members of the parent workspace.
     * @principle Enforces access based on workspace membership.
     */
    match /projects/{projectId}/silos/{siloId} {
        allow get, list, create, update, delete: if isProjectInWorkspace(projectId);

        function isProjectInWorkspace(projectId) {
            let companyId = get(/databases/$(database)/documents/projects/$(projectId)).data.companyId;
            return companyId != null && isCompanyInWorkspace(companyId);
        }
        function isCompanyInWorkspace(companyId) {
            return get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId != null && isWorkspaceMember(get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId);
        }
    }

    /**
     * @description Rules for tasks within a silo.
     * @path /silos/{siloId}/tasks/{taskId}
     * @allow (create) Workspace members can create tasks.
     * @deny (create) Users cannot create tasks if they are not members of the parent workspace.
     * @allow (get) Workspace members can read task data.
     * @deny (get) Users cannot read task data if they are not members of the parent workspace.
     * @principle Enforces access based on workspace membership.
     */
    match /silos/{siloId}/tasks/{taskId} {
        allow get, list, create, update, delete: if isSiloInWorkspace(siloId);

        function isSiloInWorkspace(siloId) {
            let projectId = get(/databases/$(database)/documents/silos/$(siloId)).data.projectId;
            return projectId != null && isProjectInWorkspace(projectId);
        }

        function isProjectInWorkspace(projectId) {
            let companyId = get(/databases/$(database)/documents/projects/$(projectId)).data.companyId;
            return companyId != null && isCompanyInWorkspace(companyId);
        }
        function isCompanyInWorkspace(companyId) {
            return get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId != null && isWorkspaceMember(get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId);
        }
    }
  }
}