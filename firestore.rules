rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, update, delete) if the user is the owner of the profile.
     * @allow (create) if the user's auth UID matches the user ID.
     * @allow (list) if false (listing users is not allowed).
     * @deny Attempting to update another user's profile.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to workspace data.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create) if the user is the owner of the workspace.
     * @allow (update, delete) if the user is an admin of the workspace.
     * @deny Any write operation if the user is not authenticated.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      function canCreateWorkspace() {
          return isSignedIn() && request.auth.uid == request.resource.data.ownerId
      }

      function isExistingWorkspaceAdmin(workspaceId) {
        return isWorkspaceAdmin(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if canCreateWorkspace();
      allow update: if isExistingWorkspaceAdmin(workspaceId);
      allow delete: if isExistingWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to company data within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) if the user is a member of the parent workspace.
     * @allow (create, update, delete) if the user is an admin of the parent workspace.
     * @deny Any write operation if the user is not a workspace member.
     * @principle Inherits workspace-level access control for companies.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      function existingIsWorkspaceAdmin(workspaceId) {
          return isWorkspaceAdmin(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if existingIsWorkspaceAdmin(workspaceId);
      allow delete: if existingIsWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to project data within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list) if the user is a member of the parent workspace.
     * @allow (create, update, delete) if the user is an admin of the parent workspace.
     * @deny Any write operation if the user is not a workspace member.
     * @principle Inherits workspace-level access control for projects.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      function existingIsWorkspaceAdmin(workspaceId) {
          return isWorkspaceAdmin(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if existingIsWorkspaceAdmin(workspaceId);
      allow delete: if existingIsWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to silo data within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list) if the user is a member of the parent workspace.
     * @allow (create, update, delete) if the user is an admin of the parent workspace.
     * @deny Any write operation if the user is not a workspace member.
     * @principle Inherits workspace-level access control for silos.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      function existingIsWorkspaceAdmin(workspaceId) {
          return isWorkspaceAdmin(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if existingIsWorkspaceAdmin(workspaceId);
      allow delete: if existingIsWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to task data within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list) if the user is a member of the parent workspace OR is assigned to the task.
     * @allow (create, update, delete) if the user is an admin of the parent workspace.
     * @deny Any write operation if the user is not a workspace member.
     * @principle Enforces workspace-level access control for tasks, with additional access for assigned users.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      function isAssignedUser(taskId, siloId, projectId, companyId, workspaceId) {
          return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/workspaces/$(workspaceId)/companies/$(companyId)/projects/$(projectId)/silos/$(siloId)/tasks/$(taskId)).data.assigneeId;
      }

        function existingIsWorkspaceAdmin(workspaceId) {
          return isWorkspaceAdmin(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
      }


      allow get, list: if isSignedIn() && (isWorkspaceMember(workspaceId) || isAssignedUser(taskId, siloId, projectId, companyId, workspaceId));
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if existingIsWorkspaceAdmin(workspaceId);
      allow delete: if existingIsWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to denormalized user task data.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list, update, delete) if the user is the owner of the user-task.
     * @allow (create) if the user is the owner of the user-task and the task's assigneeId matches the user ID.
     * @deny Any operation if the user is not authenticated.
     * @principle Enforces user-ownership for denormalized task data.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        function isExistingOwner(userId, taskId) {
          return isOwner(userId) && exists(/databases/$(database)/documents/user-tasks/$(userId)/tasks/$(taskId));
        }


        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.assigneeId == userId;
        allow update: if isExistingOwner(userId, taskId);
        allow delete: if isExistingOwner(userId, taskId);
    }

     /**
      * @description Controls access to sale data within a project.
      * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
      * @allow (get, list) if the user is a member of the parent workspace.
      * @allow (create, update, delete) if the user is an admin of the parent workspace.
      * @deny Any write operation if the user is not a workspace member.
      * @principle Inherits workspace-level access control for sales.
      */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      function existingIsWorkspaceAdmin(workspaceId) {
          return isWorkspaceAdmin(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
      }


      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if existingIsWorkspaceAdmin(workspaceId);
      allow delete: if existingIsWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to workspace invite data.
     * @path /invites/{inviteId}
     * @allow (create) if the user is authenticated.
     * @deny Any other operation.
     * @principle Restricts invite creation to authenticated users.
     */
    match /invites/{inviteId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}