rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is a member of a workspace.
    function isWorkspaceMember(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.has(request.auth.uid);
    }
    
    // Users can only read/write their own profile.
    match /users/{userId} {
      // Allow any authenticated user to read any user's profile.
      // This is needed to display assignee names and avatars on tasks.
      allow read: if request.auth != null;
      // Only allow a user to write to their own profile.
      allow write: if request.auth.uid == userId;
    }

    // Rules for workspaces and all their subcollections.
    match /workspaces/{workspaceId} {
      // Allow read if the user is a member of the workspace.
      allow read: if isWorkspaceMember(workspaceId);

      // Allow a user to create a workspace if they are the owner.
      allow create: if request.resource.data.ownerId == request.auth.uid;
      
      // Allow updates if the user is an admin of the workspace.
      allow update: if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';

      // Allow admins to delete workspaces.
      allow delete: if resource.data.users[request.auth.uid].role == 'admin';

      // Allow reads/writes to all subcollections if the user is a member of the workspace.
      match /{subcollection}/{docId=**} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }
    }

    // Rules for denormalized user tasks.
    match /user-tasks/{userId}/{taskId} {
      // A user can only access tasks in their own user-tasks collection.
      allow read, delete: if request.auth.uid == userId;

      // Allow creation only if the creating user is a member of the workspace
      // that the task belongs to. This allows admins/members to assign tasks.
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      
      allow update: if request.auth.uid == userId;
    }
    
    // Invites can be read by anyone with the token (for the join page)
    // and can only be created by workspace members. Writes/deletes happen in Cloud Functions.
    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow write, delete: if false; // Only backend functions can modify/delete.
    }
  }
}
