/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a hybrid security model. User profiles are owner-writable.
 * Workspaces enforce role-based access, and invites are secured by unique tokens.
 * Data is denormalized to simplify security rules and improve performance.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, writable only by the user.
 * - /workspaces/{workspaceId}: Workspace data, with role-based access control.
 * - /workspaces/{workspaceId}/companies/{companyId}: Companies within a workspace, access controlled by workspace membership.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Projects within a company.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Silos (task containers) within a project.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Tasks within a silo.
 * - /user-tasks/{userId}/tasks/{taskId}: Denormalized tasks for quick user lookups.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Sales logged for a project.
 * - /invites/{inviteId}: Invitations to join workspaces, secured by a unique token.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Owner-only writes are enforced for user profiles.
 * - Role-based access control is implemented for workspaces.
 *
 * Denormalization for Authorization:
 * - Workspaces contain a `users` map that stores user roles. This allows for efficient role-based access control without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read and write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages workspaces and access to them.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if userHasRole(workspaceId, 'viewer')
     * @allow (create) if request.auth.uid == request.resource.data.ownerId
     * @allow (update, delete) if userHasRole(workspaceId, 'admin')
     * @deny (create, update, delete) if !userHasRole(workspaceId, 'admin')
     * @principle Implements role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function userHasRole(workspaceId, requiredRole) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == requiredRole;
      }

       function isAdmin(workspaceId) {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        }

      allow get: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && isAdmin(workspaceId);
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && isAdmin(workspaceId);
    }

    /**
     * @description Manages companies within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) if userHasRole(workspaceId, 'viewer')
     * @allow (create, update, delete) if userHasRole(workspaceId, 'admin')
     * @deny (create, update, delete) if !userHasRole(workspaceId, 'admin')
     * @principle Access to companies is controlled by workspace membership.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function userHasRole(workspaceId, requiredRole) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == requiredRole;
      }

      allow get: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      allow list: if false;
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'admin');
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'admin');
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'admin');
    }

    /**
     * @description Manages projects within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list) if userHasRole(workspaceId, 'viewer')
     * @allow (create, update, delete) if userHasRole(workspaceId, 'admin')
     * @deny (create, update, delete) if !userHasRole(workspaceId, 'admin')
     * @principle Access to projects is controlled by workspace membership.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function userHasRole(workspaceId, requiredRole) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == requiredRole;
      }

      allow get: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      allow list: if false;
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'contributor');
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'contributor');
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'admin');
    }

    /**
     * @description Manages silos (task containers) within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list) if userHasRole(workspaceId, 'viewer')
     * @allow (create, update, delete) if userHasRole(workspaceId, 'admin')
     * @deny (create, update, delete) if !userHasRole(workspaceId, 'admin')
     * @principle Access to silos is controlled by workspace membership.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function userHasRole(workspaceId, requiredRole) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == requiredRole;
      }

      allow get: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      allow list: if false;
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'contributor');
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'contributor');
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'admin');
    }

    /**
     * @description Manages individual tasks within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list) if userHasRole(workspaceId, 'viewer')
     * @allow (create, update, delete) if userHasRole(workspaceId, 'contributor')
     * @deny (create, update, delete) if !userHasRole(workspaceId, 'contributor')
     * @principle Access to tasks is controlled by workspace membership.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function userHasRole(workspaceId, requiredRole) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == requiredRole;
      }

      allow get: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      allow list: if false;
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'contributor');
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'contributor');
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'admin');
    }

     /**
      * @description Manages denormalized tasks for a specific user.
      * @path /user-tasks/{userId}/tasks/{taskId}
      * @allow (get, list) if isOwner(userId)
      * @allow (create, update, delete) if isOwner(userId)
      * @deny (create, update, delete) if !isOwner(userId)
      * @principle Enforces document ownership for writes.
      */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages sales logged for a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get, list) if userHasRole(workspaceId, 'viewer')
     * @allow (create, update, delete) if userHasRole(workspaceId, 'contributor')
     * @deny (create, update, delete) if !userHasRole(workspaceId, 'contributor')
     * @principle Access to sales is controlled by workspace membership.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function userHasRole(workspaceId, requiredRole) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == requiredRole;
      }

      allow get: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      allow list: if false;
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'contributor');
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'contributor');
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && userHasRole(workspaceId, 'admin');
    }

    /**
     * @description Manages invitations for users to join workspaces.
     * @path /invites/{inviteId}
     * @allow (get) if request.auth.token.email == resource.data.email
     * @allow (create) if request.auth.uid != null
     * @allow update, delete: if false;
     * @principle Secures invites by requiring the authenticated user's email to match the invite email.
     */
    match /invites/{inviteId} {
        function isSignedIn() {
            return request.auth != null;
        }

        allow get: if isSignedIn() && request.auth.token.email == resource.data.email;
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }
  }
}