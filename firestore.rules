/**
 * @fileoverview Firestore Security Rules for SaturnSync application.
 *
 * Core Philosophy:
 * This ruleset enforces a hierarchical ownership model. Users own their profiles. Workspaces are owned by a single user.
 * Companies, Projects, Silos, and Tasks inherit authorization from their parent Workspace. Users are granted explicit roles within Workspaces.
 *
 * Data Structure:
 * The data is structured hierarchically: /users/{userId} -> /workspaces/{workspaceId} -> /workspaces/{workspaceId}/companies/{companyId}
 * -> /companies/{companyId}/projects/{projectId} -> /projects/{projectId}/silos/{siloId} -> /silos/{siloId}/tasks/{taskId}.
 * WorkspaceUser objects specify a user's role in a workspace.
 *
 * Key Security Decisions:
 * - Users can only read/write their own user document.
 * - Workspaces are owned by the user who created them.
 * - Companies, Projects, Silos and Tasks inherit their authorization from the parent workspace.
 * - Listing of users is disallowed for privacy.
 *
 * Denormalization for Authorization:
 * The `Company`, `Project`, `Silo`, and `Task` entities all contain a parent ID field (e.g., `workspaceId`, `companyId`, `projectId`, `siloId`) to simplify authorization rules and avoid costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching ID can create their profile.
     * @allow (get, update, delete) User with matching ID can read, update, and delete their profile.
     * @deny (create) User cannot create a profile with a different ID.
     * @deny (get, update, delete) User cannot read, update, or delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Controls access to workspaces.
     * @path /workspaces/{workspaceId}
     * @allow (create) Signed-in user can create a workspace. `ownerId` must match their UID.
     * @allow (get, update, delete) Workspace owner can read, update, and delete the workspace.
     * @deny (create) User cannot create a workspace with an `ownerId` that doesn't match their UID.
     * @deny (get, update, delete) User cannot read, update, or delete a workspace they don't own.
     * @principle Enforces workspace ownership.
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceOwner(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }

      function isWorkspaceUser(workspaceId) {
        return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isWorkspaceUser(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;
      allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;

       /**
         * @description Controls access to users within a workspace.
         * @path /workspaces/{workspaceId}/users/{userId}
         */
        match /users/{userId} {
          function isWorkspaceOwner(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
          }

          function isWorkspaceUser(workspaceId) {
            return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
          }
          allow get: if isWorkspaceUser(workspaceId) ;
          allow list: if isWorkspaceOwner(workspaceId);
          allow create: if isWorkspaceOwner(workspaceId);
          allow update: if isWorkspaceOwner(workspaceId) && resource != null;
          allow delete: if isWorkspaceOwner(workspaceId) && resource != null;
        }

      /**
       * @description Controls access to companies within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (get, list) Any user in the workspace can read the company.
       * @allow (create, update, delete) Only the workspace owner can manage companies.
       * @deny (create, update, delete) Non-owners cannot manage companies.
       * @principle Workspace owner manages companies.
       */
        match /companies/{companyId} {
          function isWorkspaceOwner(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
          }

           function isWorkspaceUser(workspaceId) {
              return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
           }
          allow get: if isWorkspaceUser(workspaceId);
          allow list: if isWorkspaceUser(workspaceId);
          allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
          allow update: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;
          allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;

          /**
           * @description Controls access to projects within a company.
           * @path /companies/{companyId}/projects/{projectId}
           */
          match /projects/{projectId} {
            function isWorkspaceOwner(workspaceId) {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
            }
             function isWorkspaceUser(workspaceId) {
                 return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
             }

            allow get: if isWorkspaceUser(workspaceId);
            allow list: if isWorkspaceUser(workspaceId);
            allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
            allow update: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;
            allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;

            /**
             * @description Controls access to silos within a project.
             * @path /projects/{projectId}/silos/{siloId}
             */
            match /silos/{siloId} {
              function isWorkspaceOwner(workspaceId) {
                return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
              }
               function isWorkspaceUser(workspaceId) {
                   return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
               }
              allow get: if isWorkspaceUser(workspaceId);
              allow list: if isWorkspaceUser(workspaceId);
              allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
              allow update: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;
              allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;

              /**
               * @description Controls access to tasks within a silo.
               * @path /silos/{siloId}/tasks/{taskId}
               */
              match /tasks/{taskId} {
                function isWorkspaceOwner(workspaceId) {
                  return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
                }
                 function isWorkspaceUser(workspaceId) {
                     return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
                 }

                allow get: if isWorkspaceUser(workspaceId);
                allow list: if isWorkspaceUser(workspaceId);
                allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
                allow update: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;
                allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;
              }
            }
          }
        }
    }
  }
}