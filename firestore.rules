rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users
      allow create: if isOwner(userId) && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows workspace members to read workspace data, and admins to modify it.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if request.auth.uid in resource.data.memberIds
     * @allow (create) if request.auth.uid == request.resource.data.ownerId
     * @allow (update, delete) if resource.data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if request.auth == null
     * @principle Enforces workspace membership for reads and role-based access for writes.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isWorkspaceMember() {
        return isSignedIn() && request.auth.uid in resource.data.users;
      }
      function isAdmin() {
        return isSignedIn() && resource.data.users[request.auth.uid].role == 'admin';
      }
      function isWorkspaceOwner(){
        return isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      }
      allow get, list: if isWorkspaceMember();
      allow create: if isWorkspaceOwner();
      allow update: if isSignedIn() && isAdmin() ;
      allow delete: if isSignedIn() && isAdmin() ;
    }

    /**
     * @description Allows workspace members to read company data, and workspace admins to modify it.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
     * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if request.auth == null
     * @principle Enforces workspace membership for reads and role-based access for writes, requiring a get() call.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
        function isSignedIn() {
          return request.auth != null;
        }
        function getWorkspace() {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }
        function isWorkspaceMember() {
          return isSignedIn() && request.auth.uid in getWorkspace().data.users;
        }
        function isAdmin() {
          return isSignedIn() && getWorkspace().data.users[request.auth.uid].role == 'admin';
        }
        allow get, list: if isWorkspaceMember();
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows workspace members to read project data, and workspace admins to modify it.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
     * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if request.auth == null
     * @principle Enforces workspace membership for reads and role-based access for writes, requiring a get() call.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
        function isSignedIn() {
          return request.auth != null;
        }
        function getWorkspace() {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }
        function isWorkspaceMember() {
          return isSignedIn() && request.auth.uid in getWorkspace().data.users;
        }
        function isAdmin() {
          return isSignedIn() && getWorkspace().data.users[request.auth.uid].role == 'admin';
        }
        allow get, list: if isWorkspaceMember();
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows workspace members to read silo data, and workspace admins to modify it.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
     * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if request.auth == null
     * @principle Enforces workspace membership for reads and role-based access for writes, requiring a get() call.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
        function isSignedIn() {
          return request.auth != null;
        }
        function getWorkspace() {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }
        function isWorkspaceMember() {
          return isSignedIn() && request.auth.uid in getWorkspace().data.users;
        }
        function isAdmin() {
          return isSignedIn() && getWorkspace().data.users[request.auth.uid].role == 'admin';
        }
        allow get, list: if isWorkspaceMember();
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows workspace members to read task data, and workspace admins or the assignee to modify it.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
     * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
     * @allow (update) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin' || resource.data.assigneeId == request.auth.uid
     * @allow (delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if request.auth == null
     * @principle Enforces workspace membership for reads, role-based access for admins, and assignee-based access for updates.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
        function isSignedIn() {
          return request.auth != null;
        }
        function getWorkspace() {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }
        function isWorkspaceMember() {
          return isSignedIn() && request.auth.uid in getWorkspace().data.users;
        }
        function isAdmin() {
          return isSignedIn() && getWorkspace().data.users[request.auth.uid].role == 'admin';
        }
        allow get, list: if isWorkspaceMember();
        allow create: if isWorkspaceMember();
        allow update: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.assigneeId);
        allow delete: if isSignedIn() && isAdmin();
    }

   /**
     * @description Allows users to read their own denormalized task data.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) if userId == request.auth.uid
     * @allow (create, update, delete) if false
     * @principle Enforces document ownership; only the user can read, and no one can modify.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get, list: if isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows workspace members to read sales data, and workspace admins to modify it.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
     * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if request.auth == null
     * @principle Enforces workspace membership for reads and role-based access for writes, requiring a get() call.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
        function isSignedIn() {
          return request.auth != null;
        }
        function getWorkspace() {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }
        function isWorkspaceMember() {
          return isSignedIn() && request.auth.uid in getWorkspace().data.users;
        }
        function isAdmin() {
          return isSignedIn() && getWorkspace().data.users[request.auth.uid].role == 'admin';
        }
        allow get, list: if isWorkspaceMember();
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows anyone to read invites, and no one to modify them.  Backend services will manage invites.
     * @path /invites/{inviteId}
     * @allow get: if true
     * @allow list: if false
     * @allow create, update, delete: if false
     * @principle Public read, private write.
     */
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}