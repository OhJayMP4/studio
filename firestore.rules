rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) Any authenticated user can read any profile.
     * @deny (create, update, delete) No one can create, update, or delete profiles directly through Firestore.
     * @principle Publicly readable profiles.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages workspace data and member roles.
     * @path /workspaces/{workspaceId}
     * @allow (get) Any workspace member can read workspace data.
     * @allow (list) Listing workspaces is disabled.
     * @allow (create) Any authenticated user can create a workspace, becoming the owner.
     * @allow (update) Only workspace admins can update workspace data.
     * @allow (delete) Only workspace admins can delete a workspace.
     * @principle Workspace access control based on roles.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() { return request.auth != null; }
      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }
      function getWorkspaceRoles(workspaceId) {
        return getWorkspace(workspaceId).data.users;
      }
      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && getWorkspaceRoles(workspaceId)[request.auth.uid] != null;
      }
      function isWorkspaceAdmin(workspaceId) {
        let roles = getWorkspaceRoles(workspaceId);
        return roles[request.auth.uid] != null && roles[request.auth.uid].role == 'admin';
      }
      function isWorkspaceOwner(workspaceId) {
        return getWorkspace(workspaceId).data.ownerId == request.auth.uid;
      }
      
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages company data within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get) Any workspace member can read company data.
     * @allow (list) Listing companies is disabled.
     * @allow (create) Only workspace admins can create companies.
     * @allow (update) Only workspace admins can update company data.
     * @allow (delete) Only workspace admins can delete a company.
     * @principle Workspace-level access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() { return request.auth != null; }
      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }
      function getWorkspaceRoles(workspaceId) {
        return getWorkspace(workspaceId).data.users;
      }
      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && getWorkspaceRoles(workspaceId)[request.auth.uid] != null;
      }
      function isWorkspaceAdmin(workspaceId) {
        let roles = getWorkspaceRoles(workspaceId);
        return roles[request.auth.uid] != null && roles[request.auth.uid].role == 'admin';
      }
      
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages project data within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get) Any workspace member can read project data.
     * @allow (list) Listing projects is disabled.
     * @allow (create) Only workspace admins can create projects.
     * @allow (update) Only workspace admins can update project data.
     * @allow (delete) Only workspace admins can delete a project.
     * @principle Workspace-level access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      function isSignedIn() { return request.auth != null; }
      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }
      function getWorkspaceRoles(workspaceId) {
        return getWorkspace(workspaceId).data.users;
      }
      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && getWorkspaceRoles(workspaceId)[request.auth.uid] != null;
      }
      function isWorkspaceAdmin(workspaceId) {
        let roles = getWorkspaceRoles(workspaceId);
        return roles[request.auth.uid] != null && roles[request.auth.uid].role == 'admin';
      }

      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages silos (task containers) within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get) Any workspace member can read silo data.
     * @allow (list) Listing silos is disabled.
     * @allow (create) Only workspace admins can create silos.
     * @allow (update) Only workspace admins can update silo data.
     * @allow (delete) Only workspace admins can delete a silo.
     * @principle Workspace-level access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      function isSignedIn() { return request.auth != null; }
      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }
      function getWorkspaceRoles(workspaceId) {
        return getWorkspace(workspaceId).data.users;
      }
      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && getWorkspaceRoles(workspaceId)[request.auth.uid] != null;
      }
      function isWorkspaceAdmin(workspaceId) {
        let roles = getWorkspaceRoles(workspaceId);
        return roles[request.auth.uid] != null && roles[request.auth.uid].role == 'admin';
      }

      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages individual tasks within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get) Any workspace member can read task data.
     * @allow (list) Listing tasks is disabled.
     * @allow (create) Only workspace members can create tasks.
     * @allow (update) Only workspace members can update task data.
     * @allow (delete) Only workspace members can delete tasks.
     * @principle Workspace-level access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      function isSignedIn() { return request.auth != null; }
      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }
      function getWorkspaceRoles(workspaceId) {
        return getWorkspace(workspaceId).data.users;
      }
      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && getWorkspaceRoles(workspaceId)[request.auth.uid] != null;
      }
      function isWorkspaceAdmin(workspaceId) {
        let roles = getWorkspaceRoles(workspaceId);
        return roles[request.auth.uid] != null && roles[request.auth.uid].role == 'admin';
      }

      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Manages denormalized tasks for a specific user.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get) Only the owner (the user themselves) can read a user task.
     * @allow (list) Only the owner (the user themselves) can list user tasks.
     * @allow (create) Only the owner can create.
     * @allow (update) Only the owner can update their own user tasks.
     * @allow (delete) Only the owner can delete their own user tasks.
     * @principle User-level access control.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isSignedIn() { return request.auth != null; }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages sales logged for projects.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get) Any workspace member can read sale data.
     * @allow (list) Listing sales is disabled.
     * @allow (create) Only workspace admins can create sales.
     * @allow (update) Only workspace admins can update sale data.
     * @allow (delete) Only workspace admins can delete sales.
     * @principle Workspace-level access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      function isSignedIn() { return request.auth != null; }
      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }
      function getWorkspaceRoles(workspaceId) {
        return getWorkspace(workspaceId).data.users;
      }
      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && getWorkspaceRoles(workspaceId)[request.auth.uid] != null;
      }
      function isWorkspaceAdmin(workspaceId) {
        let roles = getWorkspaceRoles(workspaceId);
        return roles[request.auth.uid] != null && roles[request.auth.uid].role == 'admin';
      }

      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages invitations for users to join workspaces.
     * @path /invites/{inviteId}
     * @allow (get) Any user can read invites to verify the token.
     * @allow (list) Listing invites is disabled.
     * @allow (create) Only workspace admins can create invites.
     * @allow (update) Only workspace admins can update invites.
     * @allow (delete) Only workspace admins can delete invites.
     * @principle Workspace-level access control with public read for token verification.
     */
    match /invites/{inviteId} {
      function isSignedIn() { return request.auth != null; }
      function getWorkspaceIdForCreate() {
        return request.resource.data.workspaceId;
      }
      function getWorkspaceIdForOther() {
        return resource.data.workspaceId;  // For update/delete
      }
      function getWorkspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }
      function getWorkspaceRoles(workspaceId) {
        return getWorkspace(workspaceId).data.users;
      }
      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && getWorkspaceRoles(workspaceId)[request.auth.uid] != null;
      }
      function isWorkspaceAdmin(workspaceId) {
        let roles = getWorkspaceRoles(workspaceId);
        return roles[request.auth.uid] != null && roles[request.auth.uid].role == 'admin';
      }

      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceAdmin(getWorkspaceIdForCreate());
      allow update: if isSignedIn() && isWorkspaceAdmin(getWorkspaceIdForOther());
      allow delete: if isSignedIn() && isWorkspaceAdmin(getWorkspaceIdForOther());
    }
  }
}