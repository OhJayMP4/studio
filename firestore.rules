/**
 * @fileoverview Firestore Security Rules for SaturnSync.
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model for user profiles and workspaces.
 *  Workspaces can contain users and companies. Companies can contain projects. Projects can contain silos. Silos can contain tasks.
 *  Users are added to workspaces and assigned a role. The error indicates the rules do not allow a user to list workspaces.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only by the user themselves.
 * - /workspaces/{workspaceId}: Stores workspace data. Only workspace owners can create, update, or delete workspaces.
 * - /workspaces/{workspaceId}/users/{userId}: Stores user to workspace mappings.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company data within a workspace.
 * - /companies/{companyId}/projects/{projectId}: Stores project data within a company.
 * - /projects/{projectId}/silos/{siloId}: Stores silo data within a project.
 * - /silos/{siloId}/tasks/{taskId}: Stores task data within a silo.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user profiles.
 * - Workspaces can be listed.
 * - Workspace owners have full control over their workspaces.
 * - Listing of users, companies, projects, silos, and tasks is allowed by anyone that has read access to their parent document.
 *
 * Denormalization for Authorization:
 * - Workspace documents have an `ownerId` field to simplify ownership checks.
 * - WorkspaceUser documents hold user information inside the workspace.
 *
 * Structural Segregation:
 * - Public vs. Private Data: No explicit segregation is defined. All data is treated as private, requiring authentication and authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own user profiles.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get) if request.auth == null
     * @deny (create, update, delete) if request.auth == null
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows listing of workspaces. Owners can create, update, and delete.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if true
     * @allow (create) if request.resource.data.ownerId == request.auth.uid
     * @allow (update, delete) if resource.data.ownerId == request.auth.uid
     * @deny (create) if request.auth == null
     * @deny (update, delete) if request.auth == null
     * @deny (create) if request.resource.data.ownerId != request.auth.uid
     * @deny (update, delete) if request.resource.data.ownerId != request.auth.uid
     * @principle Enforces document ownership for writes.
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceOwner(workspaceId) {
        return request.auth.uid == resource.data.ownerId;
      }
      allow get, list: if true;
      allow create: if request.auth.uid != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth.uid != null && isWorkspaceOwner(workspaceId);
      allow delete: if request.auth.uid != null && isWorkspaceOwner(workspaceId);
    }

     /**
      * @description Allows workspace owners and workspace users to manage workspace users.
      * @path /workspaces/{workspaceId}/users/{userId}
      * @allow (get, list, create, update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
      * @deny (get, list, create, update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId != request.auth.uid
      * @principle Enforces workspace ownership.
      */
    match /workspaces/{workspaceId}/users/{userId} {
       function isWorkspaceOwner(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
        }
      allow get, list: if exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && isWorkspaceOwner(workspaceId);
      allow create: if isWorkspaceOwner(workspaceId);
      allow update: if isWorkspaceOwner(workspaceId);
      allow delete: if isWorkspaceOwner(workspaceId);
    }

    /**
     * @description Allows workspace owners to manage companies within their workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list, create, update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
     * @deny (get, list, create, update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId != request.auth.uid
     * @principle Enforces workspace ownership.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
        function isWorkspaceOwner(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
        }
      allow get, list: if exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && isWorkspaceOwner(workspaceId);
      allow create: if isWorkspaceOwner(workspaceId);
      allow update: if isWorkspaceOwner(workspaceId);
      allow delete: if isWorkspaceOwner(workspaceId);
    }

    /**
     * @description Allows workspace owners to manage projects within their companies.
     * @path /companies/{companyId}/projects/{projectId}
     * @allow (get, list, create, update, delete) if get(/databases/$(database)/documents/workspaces/{workspaceId}/companies/$(companyId)).data.workspaceId == request.auth.uid
     * @deny (get, list, create, update, delete) if get(/databases/$(database)/documents/workspaces/{workspaceId}/companies/$(companyId)).data.workspaceId != request.auth.uid
     * @principle Enforces workspace ownership.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
        function isWorkspaceOwner(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
        }
        function getWorkspaceId(){
            return request.path[1];
        }
        function getCompanyId(){
            return request.path[3];
        }

      allow get, list: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId());
      allow create: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
      allow update: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
      allow delete: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
    }

    /**
     * @description Allows workspace owners to manage silos within their projects.
     * @path /projects/{projectId}/silos/{siloId}
     * @allow (get, list, create, update, delete) if get(/databases/$(database)/documents/companies/{companyId}/projects/$(projectId)).data.companyId == request.auth.uid
     * @deny (get, list, create, update, delete) if get(/databases/$(database)/documents/companies/{companyId}/projects/$(projectId)).data.companyId != request.auth.uid
     * @principle Enforces workspace ownership.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
        function isWorkspaceOwner(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
        }
        function getWorkspaceId(){
            return request.path[1];
        }
        function getCompanyId(){
            return request.path[3];
        }
        function getProjectId(){
            return request.path[5];
        }
      allow get, list: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId());
      allow create: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
      allow update: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
      allow delete: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
    }

    /**
     * @description Allows workspace owners to manage tasks within their silos.
     * @path /silos/{siloId}/tasks/{taskId}
     * @allow (get, list, create, update, delete) if get(/databases/$(database)/documents/projects/{projectId}/silos/$(siloId)).data.projectId == request.auth.uid
     * @deny (get, list, create, update, delete) if get(/databases/$(database)/documents/projects/{projectId}/silos/$(siloId)).data.projectId != request.auth.uid
     * @principle Enforces workspace ownership.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
        function isWorkspaceOwner(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
        }
        function getWorkspaceId(){
            return request.path[1];
        }
        function getCompanyId(){
            return request.path[3];
        }
        function getProjectId(){
            return request.path[5];
        }
        function getSiloId(){
            return request.path[7];
        }
      allow get, list: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId());
      allow create: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
      allow update: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
      allow delete: if exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId())) && isWorkspaceOwner(getWorkspaceId()); // TODO: Add workspace owner validation
    }
  }
}