/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership and role-based access control model for the SaturnSync application.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}` and are accessible only to the owning user.
 * - Workspaces are stored under `/workspaces/{workspaceId}`. Access control is managed via a `users` map, where keys are user UIDs and values are role objects (e.g., { role: 'admin' }).
 * - Companies, Projects, Silos, and Tasks are nested under workspaces and inherit access control from the workspace.
 * - User-specific tasks are denormalized and stored under `/user-tasks/{userId}/tasks/{taskId}` for efficient user-based queries, with access restricted to the owning user.
 * - Invites are stored under `/invites/{inviteId}` and are publicly accessible to allow users to join the workspace if they have a valid invite token.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Workspace access is controlled by roles defined within the workspace document.  Admins have full access, while other roles have limited permissions as defined by the application logic.
 * - Listing of users is disallowed.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map (UID -> role) for efficient role-based access control.  This avoids costly `get()` calls to a separate membership collection.
 *
 * Structural Segregation:
 * - User-specific tasks are stored in a separate `/user-tasks/{userId}` collection to optimize user-based queries and simplify security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, create, update, delete): Authenticated user with matching UID.
     * @deny (get, create, update, delete): Any other user or unauthenticated request.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to workspace documents.
     * @path /workspaces/{workspaceId}
     * @allow (get, list): Public read access.
     * @allow (create): Authenticated user creating the workspace with valid data.
     * @allow (update, delete): Only workspace admins can modify the workspace.
     * @deny (create, update, delete): Unauthorized users cannot modify the workspace.
     * @principle Enforces role-based access control using the 'users' map in the workspace document.
     */
    match /workspaces/{workspaceId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && isAdmin(workspaceId);
    }

    /**
     * @description Controls access to company documents within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list): Public read access.
     * @allow (create): Authenticated user who is a workspace admin.
     * @allow (update, delete): Authenticated user who is a workspace admin.
     * @deny (create, update, delete): Unauthorized users cannot modify company data.
     * @principle Enforces role-based access control, inheriting permissions from the workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin(workspaceId);
      allow update, delete: if isSignedIn() && isAdmin(workspaceId);
    }

    /**
     * @description Controls access to project documents within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list): Public read access.
     * @allow (create): Authenticated user who is a workspace admin.
     * @allow (update, delete): Authenticated user who is a workspace admin.
     * @deny (create, update, delete): Unauthorized users cannot modify project data.
     * @principle Enforces role-based access control, inheriting permissions from the workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin(workspaceId);
      allow update, delete: if isSignedIn() && isAdmin(workspaceId);
    }

    /**
     * @description Controls access to silo documents within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list): Public read access.
     * @allow (create): Authenticated user who is a workspace admin.
     * @allow (update, delete): Authenticated user who is a workspace admin.
     * @deny (create, update, delete): Unauthorized users cannot modify silo data.
     * @principle Enforces role-based access control, inheriting permissions from the workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin(workspaceId);
      allow update, delete: if isSignedIn() && isAdmin(workspaceId);
    }

    /**
     * @description Controls access to task documents within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list): Public read access.
     * @allow (create): Authenticated user who is a workspace admin.
     * @allow (update, delete): Authenticated user who is a workspace admin.
     * @deny (create, update, delete): Unauthorized users cannot modify task data.
     * @principle Enforces role-based access control, inheriting permissions from the workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin(workspaceId);
      allow update, delete: if isSignedIn() && isAdmin(workspaceId);
    }

    /**
     * @description Controls access to denormalized user-specific task documents.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get): Authenticated user accessing their own tasks.
     * @allow (list): Authenticated user listing their own tasks.
     * @allow (create): if false;
     * @allow (update): if false;
     * @allow (delete): if false;
     * @deny (get, list, create, update, delete): Any other user or unauthenticated request.
     * @principle Enforces strict user ownership for accessing denormalized task data.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to sale documents within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get, list): Public read access.
     * @allow (create): Authenticated user who is a workspace admin.
     * @allow (update, delete): Authenticated user who is a workspace admin.
     * @deny (create, update, delete): Unauthorized users cannot modify sale data.
     * @principle Enforces role-based access control, inheriting permissions from the workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin(workspaceId);
      allow update, delete: if isSignedIn() && isAdmin(workspaceId);
    }

    /**
     * @description Controls access to invite documents.
     * @path /invites/{inviteId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     */
    match /invites/{inviteId} {
        allow get: if true;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
  }

  function isAdmin(workspaceId) {
    return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
  }
}