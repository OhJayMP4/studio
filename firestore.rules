/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and a shared access model based on workspace membership. Data shape validation
 * is minimized for rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information, accessible only to the user.
 * - /workspaces/{workspaceId}: Stores workspace data, accessible to workspace members.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company data within a workspace, accessible to workspace members.
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the owning user.
 * - Workspace access is based on explicit membership defined in the 'users' map and 'memberIds' array on the workspace document.
 * - Listing of users is disallowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (get, update, delete) if request.auth.uid == userId
     * @allow (create) if request.auth.uid == userId
     * @deny (get, update, delete) if request.auth.uid != userId
     * @deny (create) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secures workspaces, allowing access to workspace members only.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if request.auth.uid in resource.data.memberIds
     * @allow (create) if request.auth.uid != null
     * @allow (update, delete) if resource.data.users[request.auth.uid].role == 'admin'
     * @deny (get, list) if !(request.auth.uid in resource.data.memberIds)
     * @deny (update, delete) if resource.data.users[request.auth.uid].role != 'admin'
     * @principle Implements shared access based on workspace membership and enforces admin-only privileges for certain operations.
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceMember() {
        return request.auth.uid in resource.data.memberIds;
      }

      allow get: if isWorkspaceMember();
      allow list: if true; // Allowing list all workspaces as per discussion
      allow create: if request.auth.uid != null;
      allow update: if resource.data.users[request.auth.uid].role == 'admin';
      allow delete: if resource.data.users[request.auth.uid].role == 'admin';
    }

    /**
     * @description Protects company data within workspaces, allowing access to workspace members only.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
     * @allow (create, update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
     * @deny (get, list, create, update, delete) if !(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]))
     * @principle Implements shared access based on workspace membership.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
         function isWorkspaceMember() {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
        }
      allow get: if isWorkspaceMember();
      allow list: if true; //Allowing List
      allow create: if isWorkspaceMember();
      allow update: if isWorkspaceMember();
      allow delete: if isWorkspaceMember();
    }
  }
}