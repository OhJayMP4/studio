/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and a role-based access control model for workspaces.
 * Users can only read and write their own profile data. Access to workspaces and their child collections
 * (companies, projects, silos, tasks, and sales) is determined by the user's role within the workspace.
 * Additionally, user-specific task lists are secured to only allow access to the associated user.
 * Invitations are publicly readable, but creation is disallowed, and updates/deletions are restricted.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /workspaces/{workspaceId}: Stores workspace information, including members and their roles.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company information.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Stores project information.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Stores silo information.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Stores task information.
 * - /user-tasks/{userId}/tasks/{taskId}: Stores denormalized task information for individual users.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Stores sales information.
 * - /invites/{inviteId}: Stores invitation information.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Workspace access is controlled by roles defined within the workspace document.
 * - User task lists are private to each user.
 * - Listing of workspaces, companies, projects, silos, tasks, user-tasks, sales, and invites is restricted to authorized users.
 * - Invites can be viewed by anyone, but only admins of a workspace can create, update, or delete them.
 *
 * Denormalization for Authorization:
 * - Workspace documents denormalize user roles within the 'users' map to avoid costly 'get()' calls in child collection rules.
 *
 * Structural Segregation:
 * - User-specific data is stored under the `/users/{userId}` path, ensuring private data is kept separate from public data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data. Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete): User with UID 'user123' can read, update or delete their profile.
     * @allow (create): User with UID 'user123' can create their profile.
     * @deny (get, update, delete): User with UID 'anotherUser' cannot read, update, or delete 'user123' profile.
     * @deny (create): User attempts to create a profile with a different userId than their own.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.uid == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId) && resource.data.uid == userId;
    }

    /**
     * @description Manages workspace data. Access is controlled by workspace roles.
     * @path /workspaces/{workspaceId}
     * @allow (get, list): User with UID 'user123' can read/list a workspace if they are a member.
     * @allow (create): User with UID 'user123' can create a workspace if they are the owner.
     * @allow (update, delete): User with UID 'user123' can update/delete a workspace if they are the owner.
     * @deny (get, list): User with UID 'anotherUser' cannot read/list a workspace if they are not a member.
     * @deny (create): User attempts to create a workspace without being authenticated.
     * @deny (update, delete): User with UID 'anotherUser' cannot update/delete a workspace if they are not the owner.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Manages company data within a workspace. Access is controlled by workspace roles.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list): User with UID 'user123' can read/list a company if they are a member of the workspace.
     * @allow (create): User with UID 'user123' can create a company if they are a member of the workspace.
     * @allow (update, delete): User with UID 'user123' can update/delete a company if they are a member of the workspace.
     * @deny (get, list): User with UID 'anotherUser' cannot read/list a company if they are not a member of the workspace.
     * @deny (create): User attempts to create a company without being authenticated or being a member of the workspace.
     * @deny (update, delete): User with UID 'anotherUser' cannot update/delete a company if they are not a member of the workspace.
     * @principle Enforces role-based access control for companies within a workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Manages project data within a company. Access is controlled by workspace roles.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list): User with UID 'user123' can read/list a project if they are a member of the workspace.
     * @allow (create): User with UID 'user123' can create a project if they are a member of the workspace.
     * @allow (update, delete): User with UID 'user123' can update/delete a project if they are a member of the workspace.
     * @deny (get, list): User with UID 'anotherUser' cannot read/list a project if they are not a member of the workspace.
     * @deny (create): User attempts to create a project without being authenticated or a member of the workspace.
     * @deny (update, delete): User with UID 'anotherUser' cannot update/delete a project if they are not a member of the workspace.
     * @principle Enforces role-based access control for projects within a company.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Manages silo data within a project. Access is controlled by workspace roles.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list): User with UID 'user123' can read/list a silo if they are a member of the workspace.
     * @allow (create): User with UID 'user123' can create a silo if they are a member of the workspace.
     * @allow (update, delete): User with UID 'user123' can update/delete a silo if they are a member of the workspace.
     * @deny (get, list): User with UID 'anotherUser' cannot read/list a silo if they are not a member of the workspace.
     * @deny (create): User attempts to create a silo without being authenticated or a member of the workspace.
     * @deny (update, delete): User with UID 'anotherUser' cannot update/delete a silo if they are not a member of the workspace.
     * @principle Enforces role-based access control for silos within a project.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Manages task data within a silo. Access is controlled by workspace roles.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list): User with UID 'user123' can read/list a task if they are a member of the workspace.
     * @allow (create): User with UID 'user123' can create a task if they are a member of the workspace.
     * @allow (update, delete): User with UID 'user123' can update/delete a task if they are a member of the workspace.
     * @deny (get, list): User with UID 'anotherUser' cannot read/list a task if they are not a member of the workspace.
     * @deny (create): User attempts to create a task without being authenticated or a member of the workspace.
     * @deny (update, delete): User with UID 'anotherUser' cannot update/delete a task if they are not a member of the workspace.
     * @principle Enforces role-based access control for tasks within a silo.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Manages user-specific task data. Users can only read and write their own tasks.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list): User with UID 'user123' can read/list their own tasks.
     * @allow (create): User with UID 'user123' can create their own tasks.
     * @allow (update, delete): User with UID 'user123' can update/delete their own tasks.
     * @deny (get, list): User with UID 'anotherUser' cannot read/list 'user123' tasks.
     * @deny (create): User with UID 'anotherUser' cannot create tasks for 'user123'.
     * @deny (update, delete): User with UID 'anotherUser' cannot update/delete 'user123' tasks.
     * @principle Enforces document ownership for user-specific task lists.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages sale data within a project. Access is controlled by workspace roles.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get, list): User with UID 'user123' can read/list sales if they are a member of the workspace.
     * @allow (create): User with UID 'user123' can create a sale if they are a member of the workspace.
     * @allow (update, delete): User with UID 'user123' can update/delete a sale if they are a member of the workspace.
     * @deny (get, list): User with UID 'anotherUser' cannot read/list sales if they are not a member of the workspace.
     * @deny (create): User attempts to create a sale without being authenticated or a member of the workspace.
     * @deny (update, delete): User with UID 'anotherUser' cannot update/delete a sale if they are not a member of the workspace.
     * @principle Enforces role-based access control for sales within a project.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Manages invitations to workspaces. Invitations are publicly readable, but creation is disallowed, and updates/deletions are restricted to workspace admins.
     * @path /invites/{inviteId}
     * @allow (get, list): Any user can view invites.
     * @deny (create): No user can create new invites through the rules.
     * @allow (update, delete): Only workspace admins can update or delete invites.
     * @principle Restricts invite management to workspace admins while allowing public read access.
     */
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    function getWorkspace(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function isWorkspaceMember(workspaceId) {
      return getWorkspace(workspaceId).data.users[request.auth.uid] != null;
    }

    function isWorkspaceAdmin(workspaceId) {
      return getWorkspace(workspaceId).data.users[request.auth.uid].role == 'admin';
    }
  }
}