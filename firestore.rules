/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control (RBAC) model within workspaces.
 * Most data is scoped to a workspace, and access is determined by a user's role within that workspace.
 * Public read access is granted to user profiles and invites.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles.
 * - /workspaces/{workspaceId}: Stores workspace data, including member roles.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company data within a workspace.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Stores project data within a company.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Stores the silos (task containers) for a project.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Stores the individual tasks within a silo.
 * - /user-tasks/{userId}/tasks/{taskId}: Denormalized tasks for a specific user for efficient lookup.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Stores the individual sales logged for a project.
 * - /invites/{inviteId}: Stores pending invitations for users to join workspaces.
 *
 * Key Security Decisions:
 * - User profiles are publicly readable.
 * - Listing of user profiles is disallowed.
 * - Workspace data is protected by role-based access control.
 * - Self-creation is allowed for user documents.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map that denormalizes user roles for efficient access control.
 *   This avoids the need for complex queries or joins to determine a user's permissions within a workspace.
 *
 * Structural Segregation:
 * - Public user profile information is stored separately from potentially private workspace data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function getWorkspaceId() {
      return request.resource.data.workspaceId;
    }


    function isWorkspaceAdmin(workspaceId) {
      return getWorkspaceRole(workspaceId) == 'admin';
    }

    function isWorkspaceMember(workspaceId) {
        let role = getWorkspaceRole(workspaceId);
        return role == 'admin' || role == 'contributor' || role == 'viewer';
    }

    function getWorkspaceRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role;
    }

    /**
     * @description Rules for user profiles. Publicly readable, owner-only create.
     * @path /users/{userId}
     * @allow (get, list): Any user can read any profile.
     * @allow (create): A user can create their own profile.
     * @deny (create): A user cannot create a profile for another user.
     * @deny (update, delete): Profiles cannot be updated or deleted.
     * @principle Public read, owner-only create, no updates or deletes.
     */
    match /users/{userId} {
      allow get: if true;
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * @description Rules for workspaces. Owner-only access for writes, member-only access for reads.
     * @path /workspaces/{workspaceId}
     * @allow (get, list): Any member of the workspace can read workspace details.
     * @allow (create): Only the workspace owner can create a workspace.
     * @allow (update, delete): Only an admin of the workspace can update or delete it.
     * @deny (create): A non-admin user cannot create a workspace.
     * @deny (update, delete): A non-admin user cannot update or delete a workspace.
     * @principle Workspace-level RBAC, owner-only writes.
     */
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Rules for companies within a workspace. Workspace member access.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list): Any member of the workspace can read companies.
     * @allow (create): Only a member of the workspace can create a company.
     * @allow (update, delete): Only an admin of the workspace can update or delete a company.
     * @deny (create): A non-member user cannot create a company.
     * @deny (update, delete): A non-admin user cannot update or delete a company.
     * @principle Workspace-level RBAC, owner-only writes.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Rules for projects within a company. Workspace member access.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list): Any member of the workspace can read projects.
     * @allow (create): Only a member of the workspace can create a project.
     * @allow (update, delete): Only an admin of the workspace can update or delete a project.
     * @deny (create): A non-member user cannot create a project.
     * @deny (update, delete): A non-admin user cannot update or delete a project.
     * @principle Workspace-level RBAC, owner-only writes.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Rules for silos within a project. Workspace member access.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list): Any member of the workspace can read silos.
     * @allow (create): Only a member of the workspace can create a silo.
     * @allow (update, delete): Only an admin of the workspace can update or delete a silo.
     * @deny (create): A non-member user cannot create a silo.
     * @deny (update, delete): A non-admin user cannot update or delete a silo.
     * @principle Workspace-level RBAC, owner-only writes.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Rules for tasks within a silo. Workspace member access.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list): Any member of the workspace can read tasks.
     * @allow (create): Only a member of the workspace can create a task.
     * @allow (update, delete): Only a member of the workspace can update or delete a task.
     * @deny (create): A non-member user cannot create a task.
     * @deny (update, delete): A non-member user cannot update or delete a task.
     * @principle Workspace-level RBAC, owner-only writes.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Rules for denormalized user tasks.  Owner-only access.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list): A user can only read their own tasks.
     * @allow (create): A user can only create their own tasks.
     * @allow (update, delete): A user can only update or delete their own tasks.
     * @deny (create): A user cannot create tasks for another user.
     * @deny (update, delete): A user cannot update or delete tasks for another user.
     * @principle Owner-only access for denormalized user tasks.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for sales within a project. Workspace member access.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get, list): Any member of the workspace can read sales.
     * @allow (create): Only a member of the workspace can create a sale.
     * @allow (update, delete): Only a member of the workspace can update or delete a sale.
     * @deny (create): A non-member user cannot create a sale.
     * @deny (update, delete): A non-member user cannot update or delete a sale.
     * @principle Workspace-level RBAC, owner-only writes.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Rules for invites. Publicly readable, workspace admin create.
     * @path /invites/{inviteId}
     * @allow (get): Any user can read an invite.
     * @allow (create): Only a workspace admin can create an invite.
     * @deny (create): A non-admin user cannot create an invite.
     * @deny (update, delete): Invites cannot be updated or deleted through rules (use a cloud function).
     * @principle Public read for invites, admin-only create.
     */
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceAdmin(request.resource.data.workspaceId);
      allow update, delete: if false;
    }
  }
}