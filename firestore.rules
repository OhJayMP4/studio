/**
 * @fileoverview Firestore Security Rules for SaturnSync.
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership and role-based access model.
 *  - Users can only manage their own profiles.
 *  - Workspaces control access to companies, projects, silos, and tasks. Workspace access is managed via the `users` map on the Workspace document.
 *
 * Data Structure:
 *  - /users/{userId}: User profiles, accessible only to the user themselves.
 *  - /workspaces/{workspaceId}: Workspaces, accessible to workspace members.
 *  - /workspaces/{workspaceId}/users/{userId}: Workspace user details. This is a subcollection that mirrors data in the workspace document's `users` map, but can contain more details. Accessible to workspace members.
 *  - /workspaces/{workspaceId}/companies/{companyId}: Companies within a workspace, accessible to workspace members.
 *  - /companies/{companyId}/projects/{projectId}: Projects within a company, accessible to workspace members via workspace ID.
 *  - /projects/{projectId}/silos/{siloId}: Silos within a project, accessible to workspace members via workspace ID.
 *  - /silos/{siloId}/tasks/{taskId}: Tasks within a silo, accessible to workspace members via workspace ID.
 *
 * Key Security Decisions:
 *  - User listing is disallowed.
 *  - All write operations require authentication.
 *  - The `Workspace` document's `users` map is the primary source of truth for workspace membership.
 *  - Subcollection access is validated by checking the parent document.
 *
 * Denormalization for Authorization:
 *  - The `Workspace` document contains a `users` map that stores user IDs and their roles within the workspace. This is denormalized data, copied from the WorkspaceUser subcollection, and allows rules to quickly check workspace membership without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile.
     * @allow (get, update, delete) Authenticated user can only access their own profile.
     * @deny (list) User listing is not allowed.
     * @deny (create) Non-authenticated user cannot create a profile.
     * @deny (get, update, delete) Authenticated user cannot access other user's profiles.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to workspaces.
     * @path /workspaces/{workspaceId}
     * @allow (create) Authenticated user can create a workspace.
     * @allow (get, list) Authenticated user can get a workspace if they are a member.
     * @allow (update, delete) Authenticated user can update a workspace if they are the owner.
     * @deny (create) Non-authenticated user cannot create a workspace.
     * @deny (get, list) Authenticated user cannot access workspaces they are not a member of.
     * @deny (update, delete) Authenticated user cannot update workspaces they are not the owner of.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && workspaceId != null && resource.data.users[request.auth.uid] != null;
      }

      function isWorkspaceOwner(workspaceId) {
        return isSignedIn() && workspaceId != null && resource.data.ownerId == request.auth.uid;
      }

      function isExistingWorkspaceOwner(workspaceId) {
          return isWorkspaceOwner(workspaceId) && resource != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn();
      allow update: if isExistingWorkspaceOwner(workspaceId);
      allow delete: if isExistingWorkspaceOwner(workspaceId);
    }

    /**
     * @description Controls access to workspace users.
     * @path /workspaces/{workspaceId}/users/{userId}
     * @allow (create) Authenticated user can create their workspace user profile.
     * @allow (get, list) Authenticated user can get workspace user profiles if they are a member of the workspace.
     * @allow (update, delete) Authenticated user can update workspace user profiles if they are the owner of the workspace.
     * @deny (create) Non-authenticated user cannot create a workspace user profile.
     * @deny (get, list) Authenticated user cannot access workspace user profiles if they are not a member of the workspace.
     * @deny (update, delete) Authenticated user cannot update workspace user profiles if they are not the owner of the workspace.
     * @principle Enforces role-based access control for workspace user profiles.
     */
    match /workspaces/{workspaceId}/users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
          return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceOwner(workspaceId) {
          return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }

      function isExistingWorkspaceOwner(workspaceId) {
          return isWorkspaceOwner(workspaceId) && resource != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isExistingWorkspaceOwner(workspaceId);
      allow delete: if isExistingWorkspaceOwner(workspaceId);
    }

    /**
     * @description Controls access to companies.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (create) Authenticated user can create a company if they are a member of the workspace.
     * @allow (get, list) Authenticated user can get a company if they are a member of the workspace.
     * @allow (update, delete) Authenticated user can update a company if they are a member of the workspace.
     * @deny (create) Non-authenticated user cannot create a company.
     * @deny (get, list) Authenticated user cannot access companies if they are not a member of the workspace.
     * @deny (update, delete) Authenticated user cannot update a company if they are not a member of the workspace.
     * @principle Enforces role-based access control for companies.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
          return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isExistingWorkspaceMember(workspaceId) {
          return isWorkspaceMember(workspaceId) && resource != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isExistingWorkspaceMember(workspaceId);
      allow delete: if isExistingWorkspaceMember(workspaceId);
    }

    /**
     * @description Controls access to projects.
     * @path /companies/{companyId}/projects/{projectId}
     * @allow (create) Authenticated user can create a project if they are a member of the workspace.
     * @allow (get, list) Authenticated user can get a project if they are a member of the workspace.
     * @allow (update, delete) Authenticated user can update a project if they are a member of the workspace.
     * @deny (create) Non-authenticated user cannot create a project.
     * @deny (get, list) Authenticated user cannot access projects if they are not a member of the workspace.
     * @deny (update, delete) Authenticated user cannot update a project if they are not a member of the workspace.
     * @principle Enforces role-based access control for projects.
     */
    match /companies/{companyId}/projects/{projectId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function getWorkspaceId() {
            return get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId;
        }

        function isWorkspaceMember() {
            let workspaceId = getWorkspaceId();
            return isSignedIn() && workspaceId != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        function isExistingWorkspaceMember() {
            return isWorkspaceMember() && resource != null;
        }

        allow get, list: if isSignedIn() && isWorkspaceMember();
        allow create: if isSignedIn() && isWorkspaceMember();
        allow update: if isExistingWorkspaceMember();
        allow delete: if isExistingWorkspaceMember();
    }

    /**
     * @description Controls access to silos.
     * @path /projects/{projectId}/silos/{siloId}
     * @allow (create) Authenticated user can create a silo if they are a member of the workspace.
     * @allow (get, list) Authenticated user can get a silo if they are a member of the workspace.
     * @allow (update, delete) Authenticated user can update a silo if they are a member of the workspace.
     * @deny (create) Non-authenticated user cannot create a silo.
     * @deny (get, list) Authenticated user cannot access silos if they are not a member of the workspace.
     * @deny (update, delete) Authenticated user cannot update a silo if they are not a member of the workspace.
     * @principle Enforces role-based access control for silos.
     */
    match /projects/{projectId}/silos/{siloId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function getCompanyId() {
            return get(/databases/$(database)/documents/projects/$(projectId)).data.companyId;
        }

        function getWorkspaceId() {
            let companyId = getCompanyId();
            return get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId;
        }

        function isWorkspaceMember() {
            let workspaceId = getWorkspaceId();
            return isSignedIn() && workspaceId != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        function isExistingWorkspaceMember() {
            return isWorkspaceMember() && resource != null;
        }

        allow get, list: if isSignedIn() && isWorkspaceMember();
        allow create: if isSignedIn() && isWorkspaceMember();
        allow update: if isExistingWorkspaceMember();
        allow delete: if isExistingWorkspaceMember();
    }

    /**
     * @description Controls access to tasks.
     * @path /silos/{siloId}/tasks/{taskId}
     * @allow (create) Authenticated user can create a task if they are a member of the workspace.
     * @allow (get, list) Authenticated user can get a task if they are a member of the workspace.
     * @allow (update, delete) Authenticated user can update a task if they are a member of the workspace.
     * @deny (create) Non-authenticated user cannot create a task.
     * @deny (get, list) Authenticated user cannot access tasks if they are not a member of the workspace.
     * @deny (update, delete) Authenticated user cannot update a task if they are not a member of the workspace.
     * @principle Enforces role-based access control for tasks.
     */
    match /silos/{siloId}/tasks/{taskId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function getProjectId() {
            return get(/databases/$(database)/documents/silos/$(siloId)).data.projectId;
        }

        function getCompanyId() {
            let projectId = getProjectId();
            return get(/databases/$(database)/documents/projects/$(projectId)).data.companyId;
        }

        function getWorkspaceId() {
            let companyId = getCompanyId();
            return get(/databases/$(database)/documents/companies/$(companyId)).data.workspaceId;
        }

        function isWorkspaceMember() {
            let workspaceId = getWorkspaceId();
            return isSignedIn() && workspaceId != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        function isExistingWorkspaceMember() {
            return isWorkspaceMember() && resource != null;
        }

        allow get, list: if isSignedIn() && isWorkspaceMember();
        allow create: if isSignedIn() && isWorkspaceMember();
        allow update: if isExistingWorkspaceMember();
        allow delete: if isExistingWorkspaceMember();
    }
  }
}