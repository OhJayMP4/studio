
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspaceId) {
      return isUserAuthenticated() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
    }

    function isWorkspaceAdmin(workspaceId) {
        return isUserAuthenticated() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    match /users/{userId} {
      allow read, write: if isUserAuthenticated() && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create: if isUserAuthenticated();
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);

      match /companies/{companyId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if isWorkspaceAdmin(workspaceId);

        match /projects/{projectId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow write: if isWorkspaceAdmin(workspaceId);

            match /silos/{siloId} {
                allow read: if isWorkspaceMember(workspaceId);
                allow write: if isWorkspaceMember(workspaceId);

                match /tasks/{taskId} {
                    allow read: if isWorkspaceMember(workspaceId);
                    allow create: if isWorkspaceMember(workspaceId);
                    allow update, delete: if isWorkspaceAdmin(workspaceId) || (isWorkspaceMember(workspaceId) && resource.data.assigneeId == request.auth.uid);
                }
            }
             match /sales/{saleId} {
                allow read: if isWorkspaceMember(workspaceId);
                allow write: if isWorkspaceAdmin(workspaceId);
            }
        }
      }
    }

    match /user-tasks/{userId}/tasks/{taskId} {
        allow read: if isUserAuthenticated() && request.auth.uid == userId;
        allow create: if (isUserAuthenticated() && request.auth.uid == userId) || isWorkspaceAdmin(request.resource.data.workspaceId);
        allow update, delete: if isUserAuthenticated() && request.auth.uid == userId;
    }

    match /invites/{inviteId} {
        allow read: if isUserAuthenticated();
        allow create: if isWorkspaceAdmin(request.resource.data.workspaceId);
        allow delete: if isUserAuthenticated();
    }
  }
}
