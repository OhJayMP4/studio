/**
 * @fileoverview Firestore Security Rules for the Studio application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for workspaces,
 * with ownership and membership defining access to data. Users can only
 * manage their own profiles. Public read access is generally disallowed
 * except where explicitly intended for public consumption.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, accessible only by the user.
 * - /workspaces/{workspaceId}: Workspaces containing companies, projects, etc. Access controlled by workspace membership.
 * - /workspaces/{workspaceId}/companies/{companyId}: Companies within a workspace.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Projects within a company.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Silos (task containers) for a project.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Tasks within a silo.
 * - /user-tasks/{userId}/tasks/{taskId}: Denormalized tasks for a specific user.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Sales logged for a project.
 * - /invites/{inviteId}: Invitations for users to join workspaces.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Workspace membership is strictly enforced for access to workspace-related data.
 * - Default security posture is to deny access unless explicitly allowed.
 *
 * Denormalization for Authorization:
 * - Workspace documents denormalize user roles in the `members` map for efficient access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members[request.auth.uid] != null;
    }

    function isWorkspaceAdmin(workspaceId) {
      return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members[request.auth.uid].role == 'admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Add this helper after existing helpers (e.g., after isExistingOwner)
    function isValidInviteForUser(inviteId) {
      let inviteDoc = get(/databases/$(database)/documents/invites/$(inviteId));
      return inviteDoc.data.expires > request.time
        && inviteDoc.data.token == request.resource.data.token // Assume token passed in update data
        && inviteDoc.data.email == request.auth.token.email
        && request.auth.uid != null;
    }

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is the owner of the profile.
     * @deny (get, create, update, delete) if the user is not the owner of the profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to workspace documents.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create) if the user is the owner of the workspace.
     * @allow (update, delete) if the user is an admin of the workspace.
     * @deny (get, create, update, delete) if the user is not authorized.
     * @principle Enforces workspace membership and admin roles for access control.
     */
    match /workspaces/{workspaceId} {
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isWorkspaceAdmin(workspaceId)
        || (exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
            && isValidInviteForUser(request.resource.data.inviteId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members[request.auth.uid] == 'member');
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to company documents within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create, update, delete) if the user is an admin of the workspace.
     * @deny (get, create, update, delete) if the user is not authorized.
     * @principle Enforces workspace membership and admin roles for access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to project documents within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create, update, delete) if the user is an admin of the workspace.
     * @deny (get, create, update, delete) if the user is not authorized.
     * @principle Enforces workspace membership and admin roles for access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to silo documents within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create, update, delete) if the user is an admin of the workspace.
     * @deny (get, create, update, delete) if the user is not authorized.
     * @principle Enforces workspace membership and admin roles for access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to task documents within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create, update, delete) if the user is an admin of the workspace.
     * @deny (get, create, update, delete) if the user is not authorized.
     * @principle Enforces workspace membership and admin roles for access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to user task documents.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) if the user is the owner of the task.
     * @allow (create, update, delete) if the user is the owner of the task.
     * @deny (get, create, update, delete) if the user is not authorized.
     * @principle Enforces document ownership for all operations.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

        /**
     * @description Controls access to sale documents within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create, update, delete) if the user is an admin of the workspace.
     * @deny (get, create, update, delete) if the user is not authorized.
     * @principle Enforces workspace membership and admin roles for access control.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceAdmin(workspaceId);
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if isWorkspaceAdmin(workspaceId);
    }

    // For /invites/{inviteId} (add new match after /user-tasks if missing):
    match /invites/{inviteId} {
      allow create: if isWorkspaceAdmin(request.resource.data.workspaceId);
      allow get: if isValidInviteForUser(inviteId);
      allow list: if request.auth != null && request.query.limit == 1 && request.query.where[0][0] == 'token';
      allow delete: if isValidInviteForUser(inviteId);
    }
  }
}