/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model within workspaces.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /workspaces/{workspaceId}: Workspaces, with access controlled by workspace membership (roles).
 * - /workspaces/{workspaceId}/companies/{companyId}: Companies within workspaces, inheriting workspace access control.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Projects within companies, inheriting workspace access control.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Silos within projects, inheriting workspace access control.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Tasks within silos, inheriting workspace access control.
 * - /user-tasks/{userId}/tasks/{taskId}: Denormalized tasks for users, accessible only to the user themselves.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Sales within projects, inheriting workspace access control.
 * - /invites/{inviteId}: Invitations, publicly readable but with owner-only (server-side) creation.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Workspace membership is managed via the `users` map on the workspace document.
 * - Read-only access is not explicitly enforced, but can be implemented via custom claims.
 * - The default security posture is strict; any ambiguous or missing rules default to denial.
 *
 * Denormalization for Authorization:
 * - Workspace membership (`users` map) is denormalized onto the workspace document to avoid collection group queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner (UID matches).
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner (UID matches and resource exists).
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a member of the workspace.
     */
    function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
    }

    /**
     * @description Checks if the user has a specific role in the workspace.
     */
    function hasWorkspaceRole(workspaceId, role) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == role;
    }

    match /users/{userId} {
      /**
       * @description Controls access to user profile documents.
       * @path /users/{userId}
       * @allow (create) User with UID 'user123' can create their own profile.
       * @allow (get) User with UID 'user123' can read their own profile.
       * @allow (update) User with UID 'user123' can update their own profile.
       * @allow (delete) User with UID 'user123' can delete their own profile.
       * @deny (create) User with UID 'user456' cannot create a profile for user 'user123'.
       * @deny (get) User with UID 'user456' cannot read the profile of user 'user123'.
       * @principle Enforces document ownership for all operations.
       */
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    match /workspaces/{workspaceId} {
      /**
       * @description Controls access to workspace documents.
       * @path /workspaces/{workspaceId}
       * @allow (get) User with role 'admin' in workspace 'workspace123' can read the workspace.
       * @allow (create) User with UID 'user123' can create a workspace.
       * @allow (update) User with role 'admin' in workspace 'workspace123' can update the workspace.
       * @allow (delete) User with role 'admin' in workspace 'workspace123' can delete the workspace.
       * @deny (create) User without authentication cannot create a workspace.
       * @deny (get) User without role 'admin' in workspace 'workspace123' cannot read the workspace.
       * @principle Enforces role-based access control for workspaces.
       */
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isWorkspaceMember(workspaceId);
      allow delete: if hasWorkspaceRole(workspaceId, 'admin') && resource != null;
    }

    match /workspaces/{workspaceId}/companies/{companyId} {
      /**
       * @description Controls access to company documents within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (get) User with role 'admin' in workspace 'workspace123' can read company 'company456'.
       * @allow (create) User with role 'admin' in workspace 'workspace123' can create a company.
       * @allow (update) User with role 'admin' in workspace 'workspace123' can update company 'company456'.
       * @allow (delete) User with role 'admin' in workspace 'workspace123' can delete company 'company456'.
       * @deny (create) User without role 'admin' in workspace 'workspace123' cannot create a company.
       * @deny (get) User without role 'admin' in workspace 'workspace123' cannot read company 'company456'.
       * @principle Enforces role-based access control for companies within workspaces.
       */
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceMember(workspaceId) && resource != null;
      allow delete: if hasWorkspaceRole(workspaceId, 'admin') && resource != null;
    }

    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      /**
       * @description Controls access to project documents within a company.
       * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
       * @allow (get) User with role 'admin' in workspace 'workspace123' can read project 'project789'.
       * @allow (create) User with role 'admin' in workspace 'workspace123' can create a project.
       * @allow (update) User with role 'admin' in workspace 'workspace123' can update project 'project789'.
       * @allow (delete) User with role 'admin' in workspace 'workspace123' can delete project 'project789'.
       * @deny (create) User without role 'admin' in workspace 'workspace123' cannot create a project.
       * @deny (get) User without role 'admin' in workspace 'workspace123' cannot read project 'project789'.
       * @principle Enforces role-based access control for projects within companies.
       */
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceMember(workspaceId) && resource != null;
      allow delete: if hasWorkspaceRole(workspaceId, 'admin') && resource != null;
    }

    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      /**
       * @description Controls access to silo documents within a project.
       * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
       * @allow (get) User with role 'admin' in workspace 'workspace123' can read silo 'silo101'.
       * @allow (create) User with role 'admin' in workspace 'workspace123' can create a silo.
       * @allow (update) User with role 'admin' in workspace 'workspace123' can update silo 'silo101'.
       * @allow (delete) User with role 'admin' in workspace 'workspace123' can delete silo 'silo101'.
       * @deny (create) User without role 'admin' in workspace 'workspace123' cannot create a silo.
       * @deny (get) User without role 'admin' in workspace 'workspace123' cannot read silo 'silo101'.
       * @principle Enforces role-based access control for silos within projects.
       */
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceMember(workspaceId) && resource != null;
      allow delete: if hasWorkspaceRole(workspaceId, 'admin') && resource != null;
    }

    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      /**
       * @description Controls access to task documents within a silo.
       * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
       * @allow (get) User with role 'admin' in workspace 'workspace123' can read task 'task202'.
       * @allow (create) User with role 'admin' in workspace 'workspace123' can create a task.
       * @allow (update) User with role 'admin' in workspace 'workspace123' can update task 'task202'.
       * @allow (delete) User with role 'admin' in workspace 'workspace123' can delete task 'task202'.
       * @deny (create) User without role 'admin' in workspace 'workspace123' cannot create a task.
       * @deny (get) User without role 'admin' in workspace 'workspace123' cannot read task 'task202'.
       * @principle Enforces role-based access control for tasks within silos.
       */
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceMember(workspaceId) && resource != null;
      allow delete: if hasWorkspaceRole(workspaceId, 'admin') && resource != null;
    }

    match /user-tasks/{userId}/tasks/{taskId} {
      /**
       * @description Controls access to denormalized task documents for a user.
       * @path /user-tasks/{userId}/tasks/{taskId}
       * @allow (get) User with UID 'user123' can read their own task.
       * @allow (create) User with UID 'user123' can create their own task.
       * @allow (update) User with UID 'user123' can update their own task.
       * @allow (delete) User with UID 'user123' can delete their own task.
       * @deny (create) User with UID 'user456' cannot create a task for user 'user123'.
       * @deny (get) User with UID 'user456' cannot read the task of user 'user123'.
       * @principle Enforces document ownership for denormalized tasks.
       */
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      /**
       * @description Controls access to sale documents within a project.
       * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
       * @allow (get) User with role 'admin' in workspace 'workspace123' can read sale 'sale303'.
       * @allow (create) User with role 'admin' in workspace 'workspace123' can create a sale.
       * @allow (update) User with role 'admin' in workspace 'workspace123' can update sale 'sale303'.
       * @allow (delete) User with role 'admin' in workspace 'workspace123' can delete sale 'sale303'.
       * @deny (create) User without role 'admin' in workspace 'workspace123' cannot create a sale.
       * @deny (get) User without role 'admin' in workspace 'workspace123' cannot read sale 'sale303'.
       * @principle Enforces role-based access control for sales within projects.
       */
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if isWorkspaceMember(workspaceId);
      allow create: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceMember(workspaceId) && resource != null;
      allow delete: if hasWorkspaceRole(workspaceId, 'admin') && resource != null;
    }

    match /invites/{inviteId} {
      /**
       * @description Controls access to invite documents.
       * @path /invites/{inviteId}
       * @allow (get) Any user can read an invite.
       * @deny (create) Only server-side code can create invites (no client-side creation).
       * @deny (update) No client-side updates allowed.
       * @deny (delete) No client-side deletes allowed.
       * @principle Allows public read access to invites but restricts creation, updates, and deletion.
       */
      allow get: if true;
      allow list: if false;
      allow create: if false; // TODO: Implement server-side creation with appropriate validation.
      allow update: if false;
      allow delete: if false;
    }
  }
}