rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read user profiles, but only the user themselves can modify their profile.
     * @path /users/{userId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isOwner(userId)
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Allows public read access to user profiles but enforces ownership for writes.
     */
    match /users/{userId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to workspace data based on user roles within the workspace.
     * @path /workspaces/{workspaceId}
     * @allow (get, list): if true;
     * @allow (create): if isSignedIn();
     * @allow (update, delete): if isWorkspaceAdmin(workspaceId);
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to company data within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list): if isWorkspaceMember(workspaceId);
     * @allow (create): if isWorkspaceAdmin(workspaceId);
     * @allow (update, delete): if isWorkspaceAdmin(workspaceId);
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Enforces workspace membership for company access.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to project data within a company and workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list): if isWorkspaceMember(workspaceId);
     * @allow (create): if isWorkspaceAdmin(workspaceId);
     * @allow (update, delete): if isWorkspaceAdmin(workspaceId);
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Enforces workspace membership for project access.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to silo data within a project, company, and workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list): if isWorkspaceMember(workspaceId);
     * @allow (create): if isWorkspaceAdmin(workspaceId);
     * @allow (update, delete): if isWorkspaceAdmin(workspaceId);
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Enforces workspace membership for silo access.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to task data within a silo, project, company, and workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list): if isWorkspaceMember(workspaceId);
     * @allow (create): if isWorkspaceAdmin(workspaceId);
     * @allow (update): if isWorkspaceAdmin(workspaceId) || isTaskAssignee(workspaceId, taskId);
     * @allow delete: if isWorkspaceAdmin(workspaceId);
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Enforces workspace membership for task access, allows assigned users to update.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && (isWorkspaceAdmin(workspaceId) || isTaskAssignee(workspaceId, companyId, projectId, siloId, taskId));
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to denormalized user task data.  Only the user can read/write their own tasks.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list): if isOwner(userId);
     * @allow (create, update, delete): if isOwner(userId);
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Enforces strict user ownership for user-specific tasks.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to sales data within a project, company, and workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get, list): if isWorkspaceMember(workspaceId);
     * @allow (create, update, delete): if isWorkspaceAdmin(workspaceId);
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Enforces workspace membership for sales data access.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to invite data. Only the invitee can read the invite.
     * @path /invites/{inviteId}
     * @allow get: if request.auth.token.email == resource.data.email;
     * @allow list: if false;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Restricts access to invites to only the intended recipient.
     */
    match /invites/{inviteId} {
      allow get: if isSignedIn() && request.auth.token.email == resource.data.email;
      allow list: if false;

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isWorkspaceMember(workspaceId) {
    return isSignedIn() && (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role != null);
  }

  function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin');
  }

  function isTaskAssignee(workspaceId, companyId, projectId, siloId, taskId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/companies/$(companyId)/projects/$(projectId)/silos/$(siloId)/tasks/$(taskId)).data.assigneeId == request.auth.uid;
  }
}