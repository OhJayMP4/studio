/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset is in prototyping mode. All reads and writes are allowed for all authenticated users,
 * facilitating rapid development and iteration.  This is not suitable for production.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.  Access is open to authenticated users.
 * - /workspaces/{workspaceId}: Stores workspace data. Access is open to authenticated users.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company data. Access is open to authenticated users.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Stores project data. Access is open to authenticated users.
 *
 * Key Security Decisions:
 * - Open Access: All read and write operations are allowed for any authenticated user to enable rapid prototyping.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description: Allows any authenticated user to read and write user profile data.
     * @path: /users/{userId}
     * @allow: (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny: None (Prototyping mode)
     * @principle: Open access for authenticated users during prototyping.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description: Allows any authenticated user to read and write workspace data.
     * @path: /workspaces/{workspaceId}
     * @allow: (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny: None (Prototyping mode)
     * @principle: Open access for authenticated users during prototyping.
     */
    match /workspaces/{workspaceId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description: Allows any authenticated user to read and write company data within a workspace.
     * @path: /workspaces/{workspaceId}/companies/{companyId}
     * @allow: (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny: None (Prototyping mode)
     * @principle: Open access for authenticated users during prototyping.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description: Allows any authenticated user to read and write project data within a company.
     * @path: /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow: (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny: None (Prototyping mode)
     * @principle: Open access for authenticated users during prototyping.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}