/**
 * @fileoverview Firestore Security Rules.
 *
 * Core Philosophy: This ruleset prioritizes strong authorization based on
 * user identity, workspace membership, and explicit roles. It uses denormalized
 * data to make authorization decisions efficient and avoids complex queries
 * within the rules. Data shape validation is intentionally relaxed to allow
 * for rapid prototyping and schema iteration.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - Workspaces are stored under `/workspaces/{workspaceId}` and contain
 *   member lists and role definitions.
 * - Companies, projects, silos, and tasks are nested hierarchically under
 *   workspaces to reflect their relationships.
 * - Denormalized user tasks are stored under `/user-tasks/{userId}/tasks/{taskId}`
 *   for efficient user-specific queries.
 * - Invites are stored under `/invites/{inviteId}`.
 *
 * Key Security Decisions:
 * - User profiles are strictly owned by the user.
 * - Workspace access is controlled through explicit membership and roles
 *   defined within the workspace document.
 * - All write operations require authentication.
 * - Data consistency between paths and document fields is enforced on create
 *   operations.
 * - List operations are generally restricted to owners or workspace members,
 *   except where public read access is explicitly intended.
 * - Destructive operations (update, delete) are validated against existing documents.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map that stores user roles, allowing
 *   rules to quickly check a user's permissions within the workspace without
 *   performing additional reads.
 * - UserTask documents duplicate relevant data from Task, Project, Company, and Silo
 *   documents to allow for efficient user-specific task queries.
 *
 * Structural Segregation:
 * - Public user profile information is stored under `/users/{userId}`, while
 *   any private user data should be stored in a subcollection under that path
 *   with stricter access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile.
     * @allow (get, update, delete) - Authenticated user can access and modify their own profile.
     * @deny (create) - Unauthenticated user cannot create a profile.
     * @deny (update, delete) - Authenticated user cannot modify another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to workspace documents.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) - Anyone can read a workspace.
     * @allow (create) - Only authenticated users can create workspaces. The ownerId must match the authenticated user's UID.
     * @allow (update, delete) - Only the workspace owner (ownerId) can update or delete the workspace.
     * @deny (create) - Unauthenticated users cannot create workspaces.
     * @deny (update, delete) - Non-owners cannot modify or delete workspaces.
     * @principle Enforces workspace ownership and authenticated access.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to company documents within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) - Workspace members can read companies.
     * @allow (create) - Workspace admins can create companies.
     * @allow (update, delete) - Workspace admins can update or delete companies.
     * @deny (create, update, delete) - Non-members cannot create, update, or delete companies.
     * @principle Enforces workspace membership for read access and admin role for write access.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to project documents within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list) - Workspace members can read projects.
     * @allow (create) - Workspace admins can create projects.
     * @allow (update, delete) - Workspace admins can update or delete projects.
     * @deny (create, update, delete) - Non-members cannot create, update, or delete projects.
     * @principle Enforces workspace membership for read access and admin role for write access.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to silo documents within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list) - Workspace members can read silos.
     * @allow (create) - Workspace admins can create silos.
     * @allow (update, delete) - Workspace admins can update or delete silos.
     * @deny (create, update, delete) - Non-members cannot create, update, or delete silos.
     * @principle Enforces workspace membership for read access and admin role for write access.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to task documents within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list) - Workspace members can read tasks.
     * @allow (create) - Workspace admins can create tasks.
     * @allow (update, delete) - Workspace admins can update or delete tasks.
     * @deny (create, update, delete) - Non-members cannot create, update, or delete tasks.
     * @principle Enforces workspace membership for read access and admin role for write access.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to denormalized user task documents.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) - Only the user can read their own tasks.
     * @allow (create) - No one can directly create user tasks. These are created via backend triggers.
     * @allow (update, delete) - No one can directly update or delete user tasks. These are managed via backend triggers.
     * @deny (create, update, delete) - All direct client modifications are denied.
     * @principle Enforces strict user ownership and prevents client-side modifications.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

     /**
      * @description Controls access to sales documents within a project.
      * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
      * @allow (get, list) - Workspace members can read sales.
      * @allow (create) - Workspace admins can create sales.
      * @allow (update, delete) - Workspace admins can update or delete sales.
      * @deny (create, update, delete) - Non-members cannot create, update, or delete sales.
      * @principle Enforces workspace membership for read access and admin role for write access.
      */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to invite documents.
     * @path /invites/{inviteId}
     * @allow (get) - Anyone can read an invite to verify it.
     * @allow (create) - Backend only.
     * @allow (update, delete) - Backend only.
     * @principle Secure invites with backend only management.
     */
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}