/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for workspaces,
 *              where users have specific roles (admin, contributor, viewer) within each workspace.
 *              User profiles are also secured, allowing only the user to read and write their own profile.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information. Only the user can read/write their own profile.
 * - /workspaces/{workspaceId}: Stores workspace data, including member roles in the `users` map.
 *
 * Key Security Decisions:
 * - Workspaces: Only workspace admins can create companies within a workspace (this rule will be added once the company collection is defined).
 * - User Profiles: Users can only read and write their own profile data. User listing is disallowed.
 *
 * Denormalization for Authorization:
 * - Workspace roles are denormalized into the `workspaces/{workspaceId}/users` map, allowing for efficient role checks.
 *   This avoids the need for separate membership collections and `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, update, delete) if the user is the owner of the profile.
     * @allow (create) if the user's UID matches the document ID.
     * @deny (get, update, delete) if the user is not the owner of the profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      // Allow the user to read their own profile.
      allow get: if isSignedIn() && isOwner(userId);

      // Allow the user to create their own profile, but only if the userId matches their auth.uid
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;

      // Allow the user to update their own profile. Enforce immutability of the UID.
      allow update: if isSignedIn() && isOwner(userId) && resource.data.uid == request.resource.data.uid;

      // Allow the user to delete their own profile.
      allow delete: if isSignedIn() && isExistingOwner(userId);

      // Disallow listing all users.
      allow list: if false;
    }

    /**
     * @description Controls access to workspace documents.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) to all signed-in users.
     * @allow (create) if the user is creating their own workspace and sets the ownerId correctly.
     * @allow (update, delete) if the user is an admin of the workspace.
     * @deny (create, update, delete) if the user is not an admin or owner.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      // Allow any signed-in user to read workspace details and list workspaces.
      allow get, list: if isSignedIn();

      // Allow creation of a workspace if the ownerId is set to the user's UID and the user is setting themselves as the admin.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.users[request.auth.uid].role == 'admin';

      // Allow updates and deletes only if the user is an admin of the workspace and the workspace exists.
      allow update, delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Check if the current user is an admin of the workspace based on the workspaceId
    function isWorkspaceAdmin(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }
  }
}