/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model within workspaces.
 *
 * Data Structure:
 * - Users have profiles stored under /users/{userId}.
 * - Workspaces are stored under /workspaces/{workspaceId} and contain member role definitions.
 * - Companies, projects, silos, and tasks are nested under workspaces.
 * - User-specific task lists are denormalized into /user-tasks/{userId}/tasks/{taskId}.
 * - Invite documents are stored at the top level under /invites/{inviteId}.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Workspace access is governed by roles defined within the workspace document.
 * - Only workspace members can access companies, projects, silos, tasks, and sales within the workspace.
 * - Invite creation is restricted to workspace members.
 * - Invite documents can only be read before a user has accepted the invite.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map that stores each member's role.  This denormalization enables efficient role-based access checks without additional reads.
 *
 * Structural Segregation:
 * - User profiles are stored in a dedicated /users collection to separate public profile data from other user-related information.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows workspace members to read workspace data, and admins to manage it.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if request.auth.uid in resource.data.users
     * @allow (create, update, delete) if resource.data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if resource.data.users[request.auth.uid].role != 'admin'
     * @principle Enforces role-based access control within workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && resource.data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && resource.data.users[request.auth.uid].role == 'admin';
      }

      allow get, list: if isWorkspaceMember(workspaceId);

      allow create: if isSignedIn();
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) ;
    }

    /**
     * @description Allows workspace members to read company data, and workspace admins to manage it.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) if isWorkspaceMember(workspaceId)
     * @allow (create, update, delete) if isWorkspaceAdmin(workspaceId)
     * @deny (create, update, delete) if !isWorkspaceAdmin(workspaceId)
     * @principle Enforces role-based access control for companies within a workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
          return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get, list: if isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
    }

    /**
     * @description Allows workspace members to read project data, and workspace admins to manage it.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list) if isWorkspaceMember(workspaceId)
     * @allow (create, update, delete) if isWorkspaceAdmin(workspaceId)
     * @deny (create, update, delete) if !isWorkspaceAdmin(workspaceId)
     * @principle Enforces role-based access control for projects within a workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
          return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get, list: if isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
    }

    /**
     * @description Allows workspace members to read silo data, and workspace admins to manage it.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list) if isWorkspaceMember(workspaceId)
     * @allow (create, update, delete) if isWorkspaceAdmin(workspaceId)
     * @deny (create, update, delete) if !isWorkspaceAdmin(workspaceId)
     * @principle Enforces role-based access control for silos within a project.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
          return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get, list: if isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
    }

    /**
     * @description Allows workspace members to read task data, and workspace admins to manage it.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list) if isWorkspaceMember(workspaceId)
     * @allow (create, update, delete) if isWorkspaceAdmin(workspaceId)
     * @deny (create, update, delete) if !isWorkspaceAdmin(workspaceId)
     * @principle Enforces role-based access control for tasks within a silo.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
          return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get, list: if isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
    }

     /**
      * @description Allows the assigned user to read their task data, and workspace admins to manage it.
      * @path /user-tasks/{userId}/tasks/{taskId}
      * @allow (get, list) if request.auth.uid == userId
      * @allow (create, update, delete) if isWorkspaceAdmin(workspaceId)
      * @deny (create, update, delete) if !isWorkspaceAdmin(workspaceId)
      * @principle Allows users to only see their tasks. Workspace admin can manage.
      */
     match /user-tasks/{userId}/tasks/{taskId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isWorkspaceMember(workspaceId) {
            return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        function isWorkspaceAdminForUserTasks(userId) {
            return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.users[request.auth.uid].role == 'admin';
        }

        allow get: if request.auth.uid == userId;
        allow list: if request.auth.uid == userId;

        allow create: if isSignedIn() && isWorkspaceAdminForUserTasks(userId); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow update: if isSignedIn() && isWorkspaceAdminForUserTasks(userId) && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if isSignedIn() && isWorkspaceAdminForUserTasks(userId) && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows workspace members to read sale data, and workspace admins to manage it.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (get, list) if isWorkspaceMember(workspaceId)
     * @allow (create, update, delete) if isWorkspaceAdmin(workspaceId)
     * @deny (create, update, delete) if !isWorkspaceAdmin(workspaceId)
     * @principle Enforces role-based access control for sales within a project.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
          return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get, list: if isWorkspaceMember(workspaceId);

      allow create: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
    }

    /**
     * @description Allows workspace members to create invites, but anyone to read them (once).
     * @path /invites/{inviteId}
     * @allow create if isWorkspaceMember(workspaceId)
     * @allow get if invite is valid
     * @deny create if not workspace member
     */
    match /invites/{inviteId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function getWorkspaceId() {
            return request.resource.data.workspaceId;
        }

        function isWorkspaceMember() {
            return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(getWorkspaceId())).data.users[request.auth.uid] != null;
        }

        // Allow invite creation only for workspace members.
        allow create: if isSignedIn() && isWorkspaceMember();

        // Allow reading of the invite if it exists.
        allow get: if true;
        allow list: if false;

        // No updates or deletes allowed.
        allow update: if false;
        allow delete: if false;
    }
  }
}