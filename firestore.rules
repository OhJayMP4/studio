/**
 * @fileoverview Firestore Security Rules for Saturn Management App
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data and a role-based access control model for shared workspace data.
 *
 * Data Structure:
 * - User profiles are stored under /users/{userId}.
 * - Workspaces are stored under /workspaces/{workspaceId}, with nested collections for companies, projects, silos, tasks and sales.
 * - Denormalized user tasks are stored under /user-tasks/{userId}/tasks/{taskId}.
 * - Invites are stored under /invites/{inviteId}.
 *
 * Key Security Decisions:
 * - User listing is disabled.
 * - Workspace access is role-based, using the 'users' map on the workspace document.
 * - The user-tasks collection is secured to allow each user to only access their own tasks.
 *
 * Denormalization for Authorization:
 * - Workspace documents include a 'users' map that stores each user's role (admin, contributor, viewer). This is denormalized to avoid costly `get()` calls.
 * - The 'user-tasks' collection duplicates task data to enable efficient user-specific queries.
 *
 * Structural Segregation:
 * - User-specific data (profiles, denormalized tasks) is stored in dedicated user subcollections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profile data.
     * @path /users/{userId}
     * @allow (create) User 'vOeToskObwZNUPVZbMpXzxcAgkW2' can create their own profile.
     * @deny (create) User 'vOeToskObwZNUPVZbMpXzxcAgkW2' cannot create a profile with a different user ID.
     * @allow (get) User 'vOeToskObwZNUPVZbMpXzxcAgkW2' can read their own profile.
     * @deny (get) User 'vOeToskObwZNUPVZbMpXzxcAgkW2' cannot read another user's profile.
     * @allow (update) User 'vOeToskObwZNUPVZbMpXzxcAgkW2' can update their own profile.
     * @deny (update) User 'vOeToskObwZNUPVZbMpXzxcAgkW2' cannot update another user's profile.
     * @allow (delete) User 'vOeToskObwZNUPVZbMpXzxcAgkW2' can delete their own profile.
     * @deny (delete) User 'vOeToskObwZNUPVZbMpXzxcAgkW2' cannot delete another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow update: if isSignedIn() && isOwner(userId) && isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Secures workspace data, enforcing role-based access control.
     * @path /workspaces/{workspaceId}
     * @allow (create) Only a workspace owner can create a workspace.  Validation of workspace.ownerId relationship would need to occur in server-side code.
     * @deny (create) Unauthorized users cannot create workspaces.
     * @allow (get) Any signed-in user can read a workspace if they are a member.
     * @deny (get) Users not in the workspace cannot read workspace data.
     * @allow (list) Listing workspaces is disallowed for now.
     * @allow (update) Only workspace admins can update workspace details.
     * @deny (update) Non-admins cannot modify workspace data.
     * @allow (delete) Only the workspace owner can delete the workspace.
     * @deny (delete) Non-owners cannot delete workspaces.
     * @principle Implements role-based access control for workspace resources.
     */
    match /workspaces/{workspaceId} {
      allow create: if isSignedIn(); // Validation of workspace.ownerId relationship would need to occur in server-side code.
      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if false;
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
      allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId) && resource != null;

        /**
         * @description Secures company data within a workspace, enforcing workspace membership.
         * @path /workspaces/{workspaceId}/companies/{companyId}
         * @allow (create) Workspace members can create companies.
         * @deny (create) Users not in the workspace cannot create companies.
         * @allow (get) Workspace members can read company data.
         * @deny (get) Users not in the workspace cannot read company data.
         * @allow (list) Listing companies is allowed for workspace members.
         * @deny (list) Users not in the workspace cannot list companies.
         * @allow (update) Workspace members can update company data.
         * @deny (update) Users not in the workspace cannot update company data.
         * @allow (delete) Workspace admins can delete companies.
         * @deny (delete) Users not in the workspace or non-admins cannot delete companies.
         * @principle Enforces workspace membership for company access.
         */
        match /companies/{companyId} {
          allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
          allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
          allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
          allow update: if isSignedIn() && isWorkspaceMember(workspaceId) && resource != null;
          allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;

          /**
           * @description Secures project data within a company, enforcing workspace membership.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
           * @allow (create) Workspace members can create projects.
           * @deny (create) Users not in the workspace cannot create projects.
           * @allow (get) Workspace members can read project data.
           * @deny (get) Users not in the workspace cannot read project data.
           * @allow (list) Listing projects is allowed for workspace members.
           * @deny (list) Users not in the workspace cannot list projects.
           * @allow (update) Workspace members can update project data.
           * @deny (update) Users not in the workspace cannot update project data.
           * @allow (delete) Workspace admins can delete projects.
           * @deny (delete) Users not in the workspace or non-admins cannot delete projects.
           * @principle Enforces workspace membership for project access.
           */
          match /projects/{projectId} {
            allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
            allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
            allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
            allow update: if isSignedIn() && isWorkspaceMember(workspaceId) && resource != null;
            allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;

            /**
             * @description Secures silo data within a project, enforcing workspace membership.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
             * @allow (create) Workspace members can create silos.
             * @deny (create) Users not in the workspace cannot create silos.
             * @allow (get) Workspace members can read silo data.
             * @deny (get) Users not in the workspace cannot read silo data.
             * @allow (list) Listing silos is allowed for workspace members.
             * @deny (list) Users not in the workspace cannot list silos.
             * @allow (update) Workspace members can update silo data.
             * @deny (update) Users not in the workspace cannot update silo data.
             * @allow (delete) Workspace admins can delete silos.
             * @deny (delete) Users not in the workspace or non-admins cannot delete silos.
             * @principle Enforces workspace membership for silo access.
             */
            match /silos/{siloId} {
              allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
              allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
              allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
              allow update: if isSignedIn() && isWorkspaceMember(workspaceId) && resource != null;
              allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;

              /**
               * @description Secures task data within a silo, enforcing workspace membership.
               * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
               * @allow (create) Workspace members can create tasks.
               * @deny (create) Users not in the workspace cannot create tasks.
               * @allow (get) Workspace members can read task data.
               * @deny (get) Users not in the workspace cannot read task data.
               * @allow (list) Listing tasks is allowed for workspace members.
               * @deny (list) Users not in the workspace cannot list tasks.
               * @allow (update) Workspace members can update task data.
               * @deny (update) Users not in the workspace cannot update task data.
               * @allow (delete) Workspace admins can delete tasks.
               * @deny (delete) Users not in the workspace or non-admins cannot delete tasks.
               * @principle Enforces workspace membership for task access.
               */
              match /tasks/{taskId} {
                allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
                allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
                allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
                allow update: if isSignedIn() && isWorkspaceMember(workspaceId) && resource != null;
                allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
              }
            }

            /**
             * @description Secures sales data within a project, enforcing workspace membership.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
             * @allow (create) Workspace members can create sales.
             * @deny (create) Users not in the workspace cannot create sales.
             * @allow (get) Workspace members can read sale data.
             * @deny (get) Users not in the workspace cannot read sale data.
             * @allow (list) Listing sales is allowed for workspace members.
             * @deny (list) Users not in the workspace cannot list sales.
             * @allow (update) Workspace members can update sale data.
             * @deny (update) Users not in the workspace cannot update sale data.
             * @allow (delete) Workspace admins can delete sales.
             * @deny (delete) Users not in the workspace or non-admins cannot delete sales.
             * @principle Enforces workspace membership for sale access.
             */
            match /sales/{saleId} {
              allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
              allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
              allow list: if isSignedIn() && isWorkspaceMember(workspaceId);
              allow update: if isSignedIn() && isWorkspaceMember(workspaceId) && resource != null;
              allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId) && resource != null;
            }
          }
        }
    }

    /**
     * @description Secures denormalized tasks for a specific user, ensuring only the user can access their own tasks.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (create) Only the user can create tasks under their own user ID.
     * @deny (create) Users cannot create tasks under other user IDs.
     * @allow (get) Only the user can read their own tasks.
     * @deny (get) Users cannot read other users' tasks.
     * @allow (list) Only the user can list their own tasks.
     * @deny (list) Users cannot list other users' tasks.
     * @allow (update) Only the user can update their own tasks.
     * @deny (update) Users cannot update other users' tasks.
     * @allow (delete) Only the user can delete their own tasks.
     * @deny (delete) Users cannot delete other users' tasks.
     * @principle Enforces strict user-ownership for denormalized user tasks.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && resource != null;
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Secures invites, restricting creation and access.
     * @path /invites/{inviteId}
     * @allow (create) Server-side code should handle invite creation.  Placeholder only, not secure as written.
     * @deny (create)  Without server-side handling, invites cannot be securely created by the client.
     * @allow (get)  Anyone can read an invite.
     * @deny (get)  N/A
     * @allow (list) Listing invites is disallowed.
     * @deny (list) Listing is not appropriate for invites.
     * @allow (update) No client-side updates allowed.
     * @deny (update) Invites should not be updated directly by the client.
     * @allow (delete) Server-side code should handle invite deletion. Placeholder only, not secure as written.
     * @deny (delete) Without server-side handling, invites cannot be securely deleted by the client.
     * @principle Restricts invite creation and modification to server-side logic.
     */
    match /invites/{inviteId} {
        allow create: if false; // Server-side code should handle invite creation.
        allow get: if true;
        allow list: if false;
        allow update: if false; // No client-side updates allowed.
        allow delete: if false; // Server-side code should handle invite deletion.
    }

    // Helper functions

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource based on the provided userId.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource and the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a member of the workspace.
     * @param {string} workspaceId The ID of the workspace to check.
     * @return {boolean} True if the user is a member, false otherwise.
     */
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
    }

    /**
     * @description Checks if the user is an admin of the workspace.
     * @param {string} workspaceId The ID of the workspace to check.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isWorkspaceAdmin(workspaceId) {
      return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

     /**
      * @description Checks if the user is the owner of the workspace.
      * Should be used for deletion or workspace-level config changes.
      * @param {string} workspaceId The ID of the workspace to check.
      * @return {boolean} True if the user is the owner, false otherwise.
      */
    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }
  }
}