rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Users can only read and write their own profile.
     * @path /users/{userId}
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.auth.uid != null;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure workspaces. Only the owner can read, write, update, or delete a workspace.
     * @path /workspaces/{workspaceId}
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceOwner(workspaceId) {
        return request.auth.uid == resource.data.ownerId;
      }
      function isCreatingWorkspaceAsOwner() {
        return request.auth.uid == request.resource.data.ownerId;
      }
      function isExistingWorkspaceOwner(workspaceId) {
        return request.auth.uid == resource.data.ownerId && resource != null;
      }
      allow get: if isWorkspaceOwner(workspaceId);
      allow list: if false;
      allow create: if isCreatingWorkspaceAsOwner();
      allow update: if isExistingWorkspaceOwner(workspaceId);
      allow delete: if isExistingWorkspaceOwner(workspaceId);

        /**
         * @description Secure workspace users.  Workspace admins can manage users within the workspace.
         * @path /workspaces/{workspaceId}/users/{userId}
         */
        match /workspaces/{workspaceId}/users/{userId} {
            function isWorkspaceAdmin(workspaceId) {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin';
            }
            function isWorkspaceUser(workspaceId, userId) {
                return request.auth.uid == userId;
            }
            function isExistingWorkspaceAdmin(workspaceId) {
                return isWorkspaceAdmin(workspaceId) && resource != null;
            }

            allow get: if isWorkspaceUser(workspaceId, userId);
            allow list: if isWorkspaceAdmin(workspaceId);
            allow create: if isWorkspaceAdmin(workspaceId) ;
            allow update: if isExistingWorkspaceAdmin(workspaceId);
            allow delete: if isExistingWorkspaceAdmin(workspaceId);
        }

        /**
         * @description Secure companies within a workspace. Workspace admins and the workspace owner can manage companies.
         * @path /workspaces/{workspaceId}/companies/{companyId}
         */
        match /workspaces/{workspaceId}/companies/{companyId} {
            function getWorkspace(workspaceId) {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
            }
            function isWorkspaceAdmin(workspaceId) {
                let workspace = getWorkspace(workspaceId);
                return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin' ||
                       workspace.ownerId == request.auth.uid;
            }
            function isExistingWorkspaceAdmin(workspaceId) {
                return isWorkspaceAdmin(workspaceId) && resource != null;
            }

            allow get: if isWorkspaceAdmin(workspaceId);
            allow list: if isWorkspaceAdmin(workspaceId);
            allow create: if isWorkspaceAdmin(workspaceId);
            allow update: if isExistingWorkspaceAdmin(workspaceId);
            allow delete: if isExistingWorkspaceAdmin(workspaceId);

            /**
             * @description Secure projects within a company. Workspace admins and the workspace owner can manage projects.
             * @path /companies/{companyId}/projects/{projectId}
             */
            match /projects/{projectId} {
                function getWorkspaceId() {
                  return get(/databases/$(database)/documents/workspaces/$(workspaceId)/companies/$(companyId)).data.workspaceId;
                }
                function getWorkspace(workspaceId) {
                  return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
                }
                function isWorkspaceAdmin(workspaceId) {
                  let workspace = getWorkspace(workspaceId);
                    return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin' ||
                           workspace.ownerId == request.auth.uid;
                }
                function isExistingWorkspaceAdmin(workspaceId) {
                    return isWorkspaceAdmin(workspaceId) && resource != null;
                }
                allow get: if isWorkspaceAdmin(workspaceId);
                allow list: if isWorkspaceAdmin(workspaceId);
                allow create: if isWorkspaceAdmin(workspaceId);
                allow update: if isExistingWorkspaceAdmin(workspaceId);
                allow delete: if isExistingWorkspaceAdmin(workspaceId);

                /**
                 * @description Secure silos within a project. Workspace admins and the workspace owner can manage silos.
                 * @path /projects/{projectId}/silos/{siloId}
                 */
                match /silos/{siloId} {
                    function getWorkspaceId() {
                      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/companies/$(companyId)/projects/$(projectId)).data.workspaceId;
                    }
                    function getWorkspace(workspaceId) {
                      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
                    }
                    function isWorkspaceAdmin(workspaceId) {
                      let workspace = getWorkspace(workspaceId);
                        return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin' ||
                               workspace.ownerId == request.auth.uid;
                    }
                    function isExistingWorkspaceAdmin(workspaceId) {
                        return isWorkspaceAdmin(workspaceId) && resource != null;
                    }
                    allow get: if isWorkspaceAdmin(workspaceId);
                    allow list: if isWorkspaceAdmin(workspaceId);
                    allow create: if isWorkspaceAdmin(workspaceId);
                    allow update: if isExistingWorkspaceAdmin(workspaceId);
                    allow delete: if isExistingWorkspaceAdmin(workspaceId);

                    /**
                     * @description Secure tasks within a silo. Workspace admins and the workspace owner can manage tasks.
                     * @path /projects/{projectId}/silos/{siloId}/tasks/{taskId}
                     */
                    match /tasks/{taskId} {
                        function getWorkspaceId() {
                          return get(/databases/$(database)/documents/workspaces/$(workspaceId)/companies/$(companyId)/projects/$(projectId)/silos/$(siloId)).data.workspaceId;
                        }
                        function getWorkspace(workspaceId) {
                          return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
                        }
                        function isWorkspaceAdmin(workspaceId) {
                          let workspace = getWorkspace(workspaceId);
                            return get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin' ||
                                   workspace.ownerId == request.auth.uid;
                        }
                        function isExistingWorkspaceAdmin(workspaceId) {
                            return isWorkspaceAdmin(workspaceId) && resource != null;
                        }
                        allow get: if isWorkspaceAdmin(workspaceId);
                        allow list: if isWorkspaceAdmin(workspaceId);
                        allow create: if isWorkspaceAdmin(workspaceId);
                        allow update: if isExistingWorkspaceAdmin(workspaceId);
                        allow delete: if isExistingWorkspaceAdmin(workspaceId);
                    }
                }
            }
        }
      }
    }
  }
}