/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a multi-tenant data model where users have workspaces, and access is controlled based on workspace membership.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the user can read/write their own profile.
 * - /workspaces/{workspaceId}: Stores workspace data. Access is granted to workspace members.
 * - /workspaces/{workspaceId}/users/{userId}: Stores workspace-specific user data.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company data within a workspace. Access is granted to workspace members.
 * - /companies/{companyId}/projects/{projectId}: Stores project data within a company. Access is inherited from the workspace.
 * - /projects/{projectId}/silos/{siloId}: Stores silo data within a project. Access is inherited from the workspace.
 * - /silos/{siloId}/tasks/{taskId}: Stores task data within a silo. Access is inherited from the workspace.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Workspace access is based on explicit membership.
 * - Subcollections inherit access control from their parent documents (workspace membership).
 *
 * Denormalization for Authorization:
 * - Workspace documents should contain a `users` map that lists user IDs and their roles in the workspace. This allows for efficient access control checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @deny (create) User with ID 'user123' cannot create a profile with a different ID 'user456'.
     * @allow (get) User with ID 'user123' can read their own profile.
     * @deny (get) User with ID 'user123' cannot read another user's profile.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @deny (update) User with ID 'user123' cannot update another user's profile.
     * @allow (delete) User with ID 'user123' can delete their own profile.
     * @deny (delete) User with ID 'user123' cannot delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return exists(/databases/$(database)/documents/users/$(userId));
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && isExistingOwner(userId);
      allow delete: if isOwner(userId) && isExistingOwner(userId);
    }

    /**
     * @description Secure workspaces. Only workspace members can read/write workspace data.
     * @path /workspaces/{workspaceId}
     * @allow (create) User with ID 'user123' can create a workspace if they are the owner.
     * @deny (create) User with ID 'user123' cannot create a workspace if they are not the owner.
     * @allow (get) User with ID 'user123' can read a workspace if they are a member.
     * @deny (get) User with ID 'user123' cannot read a workspace if they are not a member.
     * @allow (update) User with ID 'user123' can update a workspace if they are a member.
     * @deny (update) User with ID 'user123' cannot update a workspace if they are not a member.
     * @allow (delete) User with ID 'user123' can delete a workspace if they are the owner.
     * @deny (delete) User with ID 'user123' cannot delete a workspace if they are not the owner.
     * @principle Enforces workspace membership for access.
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceMember(workspaceId) {
        return request.auth.uid != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }
       function isExistingWorkspaceMember(workspaceId) {
        return request.auth.uid != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }
       function isWorkspaceOwner() {
          return request.auth.uid != null && request.resource.data.ownerId == request.auth.uid;
       }
      function isExistingWorkspaceOwner(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }

      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isWorkspaceOwner();
      allow update: if isExistingWorkspaceMember(workspaceId);
      allow delete: if isExistingWorkspaceOwner(workspaceId);
    }

      /**
     * @description Secure users within a workspace.
     * @path /workspaces/{workspaceId}/users/{userId}
     * @allow (create) User with ID 'user123' can create a workspace user.
     * @deny (create) User with ID 'user123' cannot create a workspace user if they are not a member.
     * @allow (get) User with ID 'user123' can read a workspace user.
     * @deny (get) User with ID 'user123' cannot read a workspace user if they are not a member.
     * @allow (update) User with ID 'user123' can update a workspace user.
     * @deny (update) User with ID 'user123' cannot update a workspace user if they are not a member.
     * @allow (delete) User with ID 'user123' can delete a workspace user.
     * @deny (delete) User with ID 'user123' cannot delete a workspace user if they are not a member.
     * @principle Enforces workspace membership for access.
     */
    match /workspaces/{workspaceId}/users/{userId} {
        function isWorkspaceMember(workspaceId) {
          return request.auth.uid != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        allow get: if isWorkspaceMember(workspaceId);
        allow list: if false;
        allow create: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceMember(workspaceId);
        allow delete: if isWorkspaceMember(workspaceId);
    }

      /**
       * @description Secure companies within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (create) User with ID 'user123' can create a company within a workspace if they are a member.
       * @deny (create) User with ID 'user123' cannot create a company if they are not a member.
       * @allow (get) User with ID 'user123' can read a company if they are a member of the workspace.
       * @deny (get) User with ID 'user123' cannot read a company if they are not a member of the workspace.
       * @allow (update) User with ID 'user123' can update a company if they are a member of the workspace.
       * @deny (update) User with ID 'user123' cannot update a company if they are not a member of the workspace.
       * @allow (delete) User with ID 'user123' can delete a company if they are a member of the workspace.
       * @deny (delete) User with ID 'user123' cannot delete a company if they are not a member of the workspace.
       * @principle Enforces workspace membership for access.
       */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isWorkspaceMember(workspaceId) {
          return request.auth.uid != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isWorkspaceMember(workspaceId);
      allow update: if isWorkspaceMember(workspaceId);
      allow delete: if isWorkspaceMember(workspaceId);
    }

    /**
     * @description Secure projects within a company. Access is inherited from the workspace.
     * @path /companies/{companyId}/projects/{projectId}
     */
    match /companies/{companyId}/projects/{projectId} {
        function getWorkspaceId(companyId) {
            return get(/databases/$(database)/documents/workspaces/$(companyId)).data.workspaceId;
        }

        function isWorkspaceMember(workspaceId) {
            return request.auth.uid != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        function isCompanyInWorkspace(companyId){
            return exists(/databases/$(database)/documents/workspaces/$(getWorkspaceId(companyId))/companies/$(companyId));
        }

      allow get: if isCompanyInWorkspace(companyId) && isWorkspaceMember(getWorkspaceId(companyId));
      allow list: if false;
      allow create: if isCompanyInWorkspace(companyId) && isWorkspaceMember(getWorkspaceId(companyId));
      allow update: if isCompanyInWorkspace(companyId) && isWorkspaceMember(getWorkspaceId(companyId));
      allow delete: if isCompanyInWorkspace(companyId) && isWorkspaceMember(getWorkspaceId(companyId));
    }

    /**
     * @description Secure silos within a project. Access is inherited from the workspace.
     * @path /projects/{projectId}/silos/{siloId}
     */
    match /projects/{projectId}/silos/{siloId} {
        function getCompanyId(projectId) {
            return get(/databases/$(database)/documents/companies/$(projectId)).data.companyId;
        }

        function getWorkspaceId(companyId) {
            return get(/databases/$(database)/documents/workspaces/$(companyId)).data.workspaceId;
        }

        function isWorkspaceMember(workspaceId) {
            return request.auth.uid != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        function isProjectInCompany(projectId){
            return exists(/databases/$(database)/documents/companies/$(getCompanyId(projectId))/projects/$(projectId));
        }

      allow get: if isProjectInCompany(projectId) && isWorkspaceMember(getWorkspaceId(getCompanyId(projectId))));
      allow list: if false;
      allow create: if isProjectInCompany(projectId) && isWorkspaceMember(getWorkspaceId(getCompanyId(projectId))));
      allow update: if isProjectInCompany(projectId) && isWorkspaceMember(getWorkspaceId(getCompanyId(projectId))));
      allow delete: if isProjectInCompany(projectId) && isWorkspaceMember(getWorkspaceId(getCompanyId(projectId))));
    }

    /**
     * @description Secure tasks within a silo. Access is inherited from the workspace.
     * @path /silos/{siloId}/tasks/{taskId}
     */
    match /silos/{siloId}/tasks/{taskId} {
        function getProjectId(siloId) {
            return get(/databases/$(database)/documents/projects/$(siloId)).data.projectId;
        }

        function getCompanyId(projectId) {
            return get(/databases/$(database)/documents/companies/$(projectId)).data.companyId;
        }

        function getWorkspaceId(companyId) {
            return get(/databases/$(database)/documents/workspaces/$(companyId)).data.workspaceId;
        }

        function isWorkspaceMember(workspaceId) {
            return request.auth.uid != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        function isSiloInProject(siloId){
            return exists(/databases/$(database)/documents/projects/$(getProjectId(siloId))/silos/$(siloId));
        }

      allow get: if isSiloInProject(siloId) && isWorkspaceMember(getWorkspaceId(getCompanyId(getProjectId(siloId)))));
      allow list: if false;
      allow create: if isSiloInProject(siloId) && isWorkspaceMember(getWorkspaceId(getCompanyId(getProjectId(siloId)))));
      allow update: if isSiloInProject(siloId) && isWorkspaceMember(getWorkspaceId(getCompanyId(getProjectId(siloId)))));
      allow delete: if isSiloInProject(siloId) && isWorkspaceMember(getWorkspaceId(getCompanyId(getProjectId(siloId)))));
    }
  }
}