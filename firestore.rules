/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a multi-tenant security model based on workspaces.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the owning user.
 * - /workspaces/{workspaceId}: Stores workspace metadata, accessible to workspace members.
 * - /workspaces/{workspaceId}/users/{userId}: Stores workspace user associations.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores company data within a workspace, accessible to workspace members.
 * - /companies/{companyId}/projects/{projectId}: Stores project data within a company, accessible to workspace members.
 * - /projects/{projectId}/silos/{siloId}: Stores silo data within a project, accessible to workspace members.
 * - /silos/{siloId}/tasks/{taskId}: Stores task data within a silo, accessible to workspace members.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user profiles.
 * - Workspace ownership determines access to workspace data and its subcollections.
 * - Listing of users is disallowed.
 *
 * Denormalization for Authorization:
 * - Workspace documents have an `ownerId` field to simplify ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get, update, delete) User with ID 'user123' can access their own profile.
     * @allow (create) User with ID 'user123' can create their own profile.
     * @deny (get, update, delete) User with ID 'user456' cannot access User with ID 'user123' profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to workspaces.
     * @path /workspaces/{workspaceId}
     * @allow (create) User 'user123' can create a workspace with ownerId 'user123'.
     * @allow (get, update, delete) User 'user123' can access/modify a workspace they own (ownerId == 'user123').
     * @deny (create) User 'user456' cannot create a workspace with ownerId 'user123'.
     * @deny (get, update, delete) User 'user456' cannot access/modify a workspace owned by 'user123'.
     * @principle Enforces workspace ownership for writes.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
          return request.auth.uid == resource.data.ownerId;
      }
      function isCreatingOwnedWorkspace() {
        return request.auth.uid == request.resource.data.ownerId;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isCreatingOwnedWorkspace();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

      /**
       * @description Controls access to users within a workspace (WorkspaceUser).
       * @path /workspaces/{workspaceId}/users/{userId}
       * @allow (create) Workspace owner can add users to their workspace.
       * @allow (get, update, delete) Workspace owner or the user themselves can manage their membership.
       * @deny (create) Non-workspace owner cannot add users.
       * @principle Enforces workspace ownership and user self-management.
       */
    match /workspaces/{workspaceId}/users/{userId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isWorkspaceOwner(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
        }

        allow get: if isSignedIn() && (isWorkspaceOwner(workspaceId) || request.auth.uid == userId);
        allow list: if false;
        allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
        allow update: if isSignedIn() && (isWorkspaceOwner(workspaceId) || request.auth.uid == userId);
        allow delete: if isSignedIn() && (isWorkspaceOwner(workspaceId) || request.auth.uid == userId);
    }

    /**
     * @description Controls access to companies within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (create) Workspace owner can create companies.
     * @allow (get, update, delete) Workspace owner can manage companies.
     * @deny (create) Non-workspace owner cannot create companies.
     * @principle Enforces workspace ownership for company management.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isWorkspaceOwner(workspaceId) {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }
      allow get: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow update: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId);
    }

    /**
     * @description Controls access to projects within a company.
     * @path /companies/{companyId}/projects/{projectId}
     * @allow (create) Workspace owner can create projects.
     * @allow (get, update, delete) Workspace owner can manage projects.
     * @deny (create) Non-workspace owner cannot create projects.
     * @principle Enforces workspace ownership for project management.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isWorkspaceOwner(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }
      allow get: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow update: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId);
    }

    /**
     * @description Controls access to silos within a project.
     * @path /projects/{projectId}/silos/{siloId}
     * @allow (create) Workspace owner can create silos.
     * @allow (get, update, delete) Workspace owner can manage silos.
     * @deny (create) Non-workspace owner cannot create silos.
     * @principle Enforces workspace ownership for silo management.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      function isSignedIn() {
        return request.auth != null;
      }
     function isWorkspaceOwner(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }
      allow get: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow update: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId);
    }

    /**
     * @description Controls access to tasks within a silo.
     * @path /silos/{siloId}/tasks/{taskId}
     * @allow (create) Workspace owner can create tasks.
     * @allow (get, update, delete) Workspace owner can manage tasks.
     * @deny (create) Non-workspace owner cannot create tasks.
     * @principle Enforces workspace ownership for task management.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isWorkspaceOwner(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }
      allow get: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow update: if isSignedIn() && isWorkspaceOwner(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceOwner(workspaceId);
    }
  }
}