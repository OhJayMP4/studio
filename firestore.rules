/**
 * @file Firebase Security Rules for Firestore.
 *
 * Core Philosophy:
 * This ruleset enforces a strict, multi-layered access control model based on user roles within workspaces.
 * Users can only access resources within workspaces they are members of, with permissions determined by their role.
 * Workspace owners have administrative privileges.
 *
 * Data Structure:
 * - Users: `/users/{userId}` - Stores public user profile information.
 * - Workspaces: `/workspaces/{workspaceId}` - Contains workspaces, their members, and associated data.
 * - Companies: `/workspaces/{workspaceId}/companies/{companyId}` - Companies within workspaces.
 * - Projects: `/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}` - Projects within companies.
 * - Silos: `/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}` - Task containers within projects.
 * - Tasks: `/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}` - Individual tasks.
 * - User Tasks: `/user-tasks/{userId}/tasks/{taskId}` - Denormalized task data for efficient user lookups.
 * - Sales: `/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}` - Sales data within projects.
 * - Invites: `/invites/{inviteId}` - Invitations to join workspaces.
 *
 * Key Security Decisions:
 * - Users can only read/write their own user profiles.
 * - Workspace data is secured based on user roles defined within the workspace document.
 * - Listing all users is disallowed.
 * - Data relationships are validated upon creation using strict data consistency rules.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map that stores each user's role (`admin`, `contributor`, `viewer`). This denormalization is critical for efficient authorization checks within the workspace.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile information.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid; // Enforce immutability of userId.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to workspace data based on user roles.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if request.auth.uid in resource.data.users
     * @allow (create) if request.resource.data.ownerId == request.auth.uid
     * @allow (update, delete) if resource.data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if user is not an admin
     * @principle Implements role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember() {
        return isSignedIn() && request.auth.uid in resource.data.users;
      }

      function isWorkspaceAdmin() {
        return isSignedIn() && resource.data.users[request.auth.uid].role == 'admin';
      }

      function isExistingWorkspaceAdmin() {
        return isWorkspaceAdmin() && resource.data != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingWorkspaceAdmin();
      allow delete: if isExistingWorkspaceAdmin();
    }

    /**
     * @description Controls access to company data within a workspace; workspace membership is required.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) if user is a member of the workspace
     * @allow (create) if user is an admin of the workspace
     * @allow (update, delete) if user is an admin of the workspace
     * @principle Enforces workspace membership and admin roles for company data.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace() {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
      }

      function isWorkspaceMember() {
        return isSignedIn() && request.auth.uid in getWorkspace().users;
      }

      function isWorkspaceAdmin() {
         return isSignedIn() && getWorkspace().users[request.auth.uid].role == 'admin';
      }

      function isExistingWorkspaceAdmin() {
         return isWorkspaceAdmin() && resource.data != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember();
      allow create: if isSignedIn() && isWorkspaceAdmin();
      allow update: if isExistingWorkspaceAdmin();
      allow delete: if isExistingWorkspaceAdmin();
    }

    /**
     * @description Controls access to project data within a company and workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list) if user is a member of the workspace
     * @allow (create) if user is an admin of the workspace
     * @allow (update, delete) if user is an admin of the workspace
     * @principle Enforces workspace membership and admin roles for project data.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace() {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
      }

      function isWorkspaceMember() {
        return isSignedIn() && request.auth.uid in getWorkspace().users;
      }

      function isWorkspaceAdmin() {
         return isSignedIn() && getWorkspace().users[request.auth.uid].role == 'admin';
      }

      function isExistingWorkspaceAdmin() {
         return isWorkspaceAdmin() && resource.data != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember();
      allow create: if isSignedIn() && isWorkspaceAdmin();
      allow update: if isExistingWorkspaceAdmin();
      allow delete: if isExistingWorkspaceAdmin();
    }

    /**
     * @description Controls access to silo data within a project, company, and workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list) if user is a member of the workspace
     * @allow (create) if user is an admin of the workspace
     * @allow (update, delete) if user is an admin of the workspace
     * @principle Enforces workspace membership and admin roles for silo data.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace() {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
      }

      function isWorkspaceMember() {
        return isSignedIn() && request.auth.uid in getWorkspace().users;
      }

      function isWorkspaceAdmin() {
         return isSignedIn() && getWorkspace().users[request.auth.uid].role == 'admin';
      }

      function isExistingWorkspaceAdmin() {
         return isWorkspaceAdmin() && resource.data != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember();
      allow create: if isSignedIn() && isWorkspaceAdmin();
      allow update: if isExistingWorkspaceAdmin();
      allow delete: if isExistingWorkspaceAdmin();
    }

    /**
     * @description Controls access to task data within a silo, project, company, and workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list) if user is a member of the workspace
     * @allow (create) if user is an admin of the workspace
     * @allow (update, delete) if user is an admin of the workspace
     * @principle Enforces workspace membership and admin roles for task data.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace() {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
      }

      function isWorkspaceMember() {
        return isSignedIn() && request.auth.uid in getWorkspace().users;
      }

      function isWorkspaceAdmin() {
         return isSignedIn() && getWorkspace().users[request.auth.uid].role == 'admin';
      }

      function isExistingWorkspaceAdmin() {
         return isWorkspaceAdmin() && resource.data != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember();
      allow create: if isSignedIn() && isWorkspaceAdmin();
      allow update: if isExistingWorkspaceAdmin();
      allow delete: if isExistingWorkspaceAdmin();
    }

    /**
     * @description Controls access to denormalized user task data.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) if the user owns the task
     * @allow (create) if the user owns the task and the userId matches
     * @allow (update, delete) if the user owns the task
     * @principle Enforces ownership for user-specific task data.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Controls access to sale data within a project, company, and workspace.
      * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
      * @allow (get, list) if user is a member of the workspace
      * @allow (create) if user is an admin of the workspace
      * @allow (update, delete) if user is an admin of the workspace
      * @principle Enforces workspace membership and admin roles for sale data.
      */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace() {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
      }

      function isWorkspaceMember() {
        return isSignedIn() && request.auth.uid in getWorkspace().users;
      }

      function isWorkspaceAdmin() {
         return isSignedIn() && getWorkspace().users[request.auth.uid].role == 'admin';
      }

      function isExistingWorkspaceAdmin() {
         return isWorkspaceAdmin() && resource.data != null;
      }

      allow get, list: if isSignedIn() && isWorkspaceMember();
      allow create: if isSignedIn() && isWorkspaceAdmin();
      allow update: if isExistingWorkspaceAdmin();
      allow delete: if isExistingWorkspaceAdmin();
    }

    /**
     * @description Controls access to invite data.
     * @path /invites/{inviteId}
     * @allow get: if true; // Invite links are public
     * @allow list: if false;
     * @allow create: if false; // TODO: Implement admin-only invites
     * @allow update: if false; // Invitations cannot be updated
     * @allow delete: if false; // Invitations cannot be deleted
     * @principle Access control for invitations.
     */
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if false;
      allow create: if false; // TODO: Implement admin-only invites
      allow update: if false; // Invitations cannot be updated
      allow delete: if false; // Invitations cannot be deleted
    }
  }
}