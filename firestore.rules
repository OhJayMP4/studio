rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can read/update/delete their profile.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete user123's profile.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to workspace data.
     * @path /workspaces/{workspaceId}
     * @allow (create) User 'user123' can create a workspace if they are the owner.
     * @allow (get) User 'user123' can read a workspace if they are a member.
     * @deny (update, delete) User 'user456' cannot update/delete a workspace they don't own or aren't an admin of.
     * @principle Enforces role-based access control for workspace data.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember() {
        return resource.data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin() {
        return resource.data.users[request.auth.uid].role == 'admin' || resource.data.users[request.auth.uid].role == 'owner';
      }

       function isWorkspaceOwner() {
        return resource.data.ownerId == request.auth.uid;
      }

      allow get: if isSignedIn() && isWorkspaceMember();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();
      allow delete: if isSignedIn() && isWorkspaceMember() && isWorkspaceOwner();

      /**
       * @description Controls access to companies within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (create) User 'user123' can create a company if they are a member of the workspace.
       * @allow (get) User 'user123' can read a company if they are a member of the workspace.
       * @deny (update, delete) User 'user456' cannot update/delete a company if they are not an admin of the workspace.
       * @principle Enforces workspace membership for company access.
       */
      match /companies/{companyId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function getWorkspace() {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
        }

        function isWorkspaceMember() {
          return getWorkspace().users[request.auth.uid] != null;
        }

        function isWorkspaceAdmin() {
          return getWorkspace().users[request.auth.uid].role == 'admin' || getWorkspace().users[request.auth.uid].role == 'owner';
        }

        allow get: if isSignedIn() && isWorkspaceMember();
        allow list: if isSignedIn() && isWorkspaceMember();
        allow create: if isSignedIn() && isWorkspaceMember();
        allow update: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();
        allow delete: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();

        /**
         * @description Controls access to projects within a company.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
         * @allow (create) User 'user123' can create a project if they are a member of the workspace.
         * @allow (get) User 'user123' can read a project if they are a member of the workspace.
         * @deny (update, delete) User 'user456' cannot update/delete a project if they are not an admin of the workspace.
         * @principle Enforces workspace membership for project access.
         */
        match /projects/{projectId} {
          function isSignedIn() {
            return request.auth != null;
          }

          function getWorkspace() {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
          }

          function isWorkspaceMember() {
             return getWorkspace().users[request.auth.uid] != null;
          }

           function isWorkspaceAdmin() {
            return getWorkspace().users[request.auth.uid].role == 'admin' || getWorkspace().users[request.auth.uid].role == 'owner';
          }

          allow get: if isSignedIn() && isWorkspaceMember();
          allow list: if isSignedIn() && isWorkspaceMember();
          allow create: if isSignedIn() && isWorkspaceMember();
          allow update: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();
          allow delete: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();

          /**
           * @description Controls access to silos within a project.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
           * @allow (create) User 'user123' can create a silo if they are a member of the workspace.
           * @allow (get) User 'user123' can read a silo if they are a member of the workspace.
           * @deny (update, delete) User 'user456' cannot update/delete a silo if they are not an admin of the workspace.
           * @principle Enforces workspace membership for silo access.
           */
          match /silos/{siloId} {
            function isSignedIn() {
              return request.auth != null;
            }

             function getWorkspace() {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
            }

            function isWorkspaceMember() {
               return getWorkspace().users[request.auth.uid] != null;
            }

             function isWorkspaceAdmin() {
              return getWorkspace().users[request.auth.uid].role == 'admin' || getWorkspace().users[request.auth.uid].role == 'owner';
            }

            allow get: if isSignedIn() && isWorkspaceMember();
            allow list: if isSignedIn() && isWorkspaceMember();
            allow create: if isSignedIn() && isWorkspaceMember();
            allow update: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();
            allow delete: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();

            /**
             * @description Controls access to tasks within a silo.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
             * @allow (create) User 'user123' can create a task if they are a member of the workspace.
             * @allow (get) User 'user123' can read a task if they are a member of the workspace.
             * @deny (update, delete) User 'user456' cannot update/delete a task if they are not an admin of the workspace.
             * @principle Enforces workspace membership for task access.
             */
            match /tasks/{taskId} {
              function isSignedIn() {
                return request.auth != null;
              }

              function getWorkspace() {
                return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
              }

              function isWorkspaceMember() {
                 return getWorkspace().users[request.auth.uid] != null;
              }

               function isWorkspaceAdmin() {
                return getWorkspace().users[request.auth.uid].role == 'admin' || getWorkspace().users[request.auth.uid].role == 'owner';
              }

              allow get: if isSignedIn() && isWorkspaceMember();
              allow list: if isSignedIn() && isWorkspaceMember();
              allow create: if isSignedIn() && isWorkspaceMember();
              allow update: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();
              allow delete: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();
            }
          }

          /**
           * @description Controls access to sales within a project.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
           * @allow (create) User 'user123' can create a sale if they are a member of the workspace.
           * @allow (get) User 'user123' can read a sale if they are a member of the workspace.
           * @deny (update, delete) User 'user456' cannot update/delete a sale if they are not an admin of the workspace.
           * @principle Enforces workspace membership for sale access.
           */
          match /sales/{saleId} {
            function isSignedIn() {
              return request.auth != null;
            }

            function getWorkspace() {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
            }

            function isWorkspaceMember() {
               return getWorkspace().users[request.auth.uid] != null;
            }

             function isWorkspaceAdmin() {
              return getWorkspace().users[request.auth.uid].role == 'admin' || getWorkspace().users[request.auth.uid].role == 'owner';
            }

            allow get: if isSignedIn() && isWorkspaceMember();
            allow list: if isSignedIn() && isWorkspaceMember();
            allow create: if isSignedIn() && isWorkspaceMember();
            allow update: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();
            allow delete: if isSignedIn() && isWorkspaceMember() && isWorkspaceAdmin();
          }
        }
      }
    }

    /**
     * @description Controls access to user-specific task data.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) User 'user123' can read/list their tasks.
     * @deny (create, update, delete) User 'user456' cannot create/update/delete user123's tasks.
     * @principle Restricts access to a user's own task data.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to workspace invitations.
     * @path /invites/{inviteId}
     * @allow (create) Anyone can create an invite. This is intended for server-side creation only.
     * @deny (get, list, update, delete) No client-side access is allowed.
     */
    match /invites/{inviteId} {
      allow get: if false;
      allow list: if false;
      allow create: if false; // Intended for server-side use only with admin privileges
      allow update: if false;
      allow delete: if false;
    }
  }
}