/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a hybrid security model. User profiles and denormalized user tasks are strictly user-owned.
 * Workspaces and their hierarchical data (companies, projects, silos, tasks, sales) are accessible to workspace members.
 * Invites are disabled at the rule level and intended to be handled by a trusted server environment (e.g., Cloud Functions).
 *
 * Data Structure:
 * - /users/{userId}: User profile data.
 * - /workspaces/{workspaceId}: Workspace data, including member lists.
 * - /workspaces/{workspaceId}/companies/{companyId}: Companies within workspaces.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Projects within companies.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Silos (task containers) within projects.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Tasks within silos.
 * - /user-tasks/{userId}/tasks/{taskId}: Denormalized task data for quick user lookups.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Sales data within projects.
 * - /invites/{inviteId}: Invite documents.
 *
 * Key Security Decisions:
 * - User listing is disabled to prevent enumeration.
 * - Workspace membership is validated using a `users` map on the workspace document for efficient checks.
 * - Invites are completely disabled at the rule level, assuming a backend handles invite validation and processing.
 * - Data shape is not strictly validated in the rules, allowing for rapid iteration.
 * - Update and delete operations are guarded with `resource != null` to prevent errors.
 *
 * Denormalization for Authorization:
 * - Workspace membership is denormalized into the `users` map within the `/workspaces/{workspaceId}` document. This allows for efficient `isWorkspaceMember()` checks without needing separate database reads.
 * - The `ownerId` field on the `/workspaces/{workspaceId}` document enables fast owner-based authorization for workspace updates and deletes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users;
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to user profile information. Users can read any profile but can only modify their own.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read any user profile.
     * @allow (create, update, delete) Authenticated user can create, update, or delete their own profile.
     * @deny (list) No user listing allowed.
     * @deny (create, update, delete) Authenticated user cannot modify other profiles.
     * @principle Enforces user-ownership for profile modifications.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && resource.data.uid == userId;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.uid == userId && resource != null;
    }

    /**
     * @description Controls access to workspace data. Authenticated users can read workspaces. Workspace creation is restricted to the owner.
     *  Updates and deletes are restricted to the workspace owner.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) Authenticated users can read and list workspaces.
     * @allow (create) Authenticated user can create a workspace with themselves as the owner.
     * @deny (update, delete) Only the workspace owner can update or delete a workspace.
     * @principle Enforces workspace ownership for modifications.
     */
    match /workspaces/{workspaceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isWorkspaceOwner(workspaceId) && resource != null;
      allow delete: if isWorkspaceOwner(workspaceId) && resource != null;

      /**
       * @description Controls access to company data within a workspace. Access is restricted to workspace members.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (get, list) Authenticated workspace members can read and list companies within the workspace.
       * @allow (create, update) Authenticated workspace members can create and update companies within the workspace.
       * @deny (delete) Authenticated workspace members cannot delete companies within the workspace.
       * @principle Enforces workspace membership for company modifications.
       */
      match /companies/{companyId} {
        allow get, list: if isSignedIn();
        allow create: if isWorkspaceMember(workspaceId);
        allow update: if isWorkspaceMember(workspaceId) && resource != null;
        allow delete: if isWorkspaceMember(workspaceId) && resource != null;

        /**
         * @description Controls access to project data within a company. Access is restricted to workspace members.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
         * @allow (get, list) Authenticated workspace members can read and list projects within the company.
         * @allow (create, update) Authenticated workspace members can create and update projects within the company.
         * @deny (delete) Authenticated workspace members cannot delete projects within the company.
         * @principle Enforces workspace membership for project modifications.
         */
        match /projects/{projectId} {
          allow get, list: if isSignedIn();
          allow create: if isWorkspaceMember(workspaceId);
          allow update: if isWorkspaceMember(workspaceId) && resource != null;
          allow delete: if isWorkspaceMember(workspaceId) && resource != null;

          /**
           * @description Controls access to silo data within a project. Access is restricted to workspace members.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
           * @allow (get, list) Authenticated workspace members can read and list silos within the project.
           * @allow (create, update) Authenticated workspace members can create and update silos within the project.
           * @deny (delete) Authenticated workspace members cannot delete silos within the project.
           * @principle Enforces workspace membership for silo modifications.
           */
          match /silos/{siloId} {
            allow get, list: if isSignedIn();
            allow create: if isWorkspaceMember(workspaceId);
            allow update: if isWorkspaceMember(workspaceId) && resource != null;
            allow delete: if isWorkspaceMember(workspaceId) && resource != null;

            /**
             * @description Controls access to task data within a silo. Access is restricted to workspace members.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
             * @allow (get, list) Authenticated workspace members can read and list tasks within the silo.
             * @allow (create, update) Authenticated workspace members can create and update tasks within the silo.
             * @deny (delete) Authenticated workspace members cannot delete tasks within the silo.
             * @principle Enforces workspace membership for task modifications.
             */
            match /tasks/{taskId} {
              allow get, list: if isSignedIn();
              allow create: if isWorkspaceMember(workspaceId);
              allow update: if isWorkspaceMember(workspaceId) && resource != null;
              allow delete: if isWorkspaceMember(workspaceId) && resource != null;
            }

            /**
             * @description Controls access to sale data within a project. Access is restricted to workspace members.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
             * @allow (get, list) Authenticated workspace members can read and list sales within the project.
             * @allow (create, update) Authenticated workspace members can create and update sales within the project.
             * @deny (delete) Authenticated workspace members cannot delete sales within the project.
             * @principle Enforces workspace membership for sale modifications.
             */
            match /sales/{saleId} {
              allow get, list: if isSignedIn();
              allow create: if isWorkspaceMember(workspaceId);
              allow update: if isWorkspaceMember(workspaceId) && resource != null;
              allow delete: if isWorkspaceMember(workspaceId) && resource != null;
            }
          }
        }
      }
    }

    /**
     * @description Controls access to denormalized user-task data. Users can only read, update, or delete their own tasks.
     *  Workspace members can create tasks for other users (denormalization case).
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) Authenticated user can read and list their own tasks.
     * @allow (create) Authenticated workspace member can create a task for another user, provided they are the assignee.
     * @deny (update, delete) Only the assigned user can update or delete their own denormalized tasks.
     * @principle Enforces user-ownership for denormalized tasks, with workspace member creation.
     */
    match /user-tasks/{userId} {
      match /tasks/{taskId} {
        allow get, list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn()
          && userId == request.resource.data.assigneeId  // Must match proposed assignee
          && isWorkspaceMember(request.resource.data.workspaceId)  // Creator must be member
          && exists(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)/companies/$(request.resource.data.companyId)/projects/$(request.resource.data.projectId)/silos/$(request.resource.data.siloId)/tasks/$(taskId));  // Task must exist in hierarchy;
        allow update: if isSignedIn() && isOwner(userId) && resource != null;
        allow delete: if isSignedIn() && isOwner(userId) && resource != null;
      }
    }

    /**
     * @description Disables all access to invites. Invite processing is intended to be handled by a trusted backend.
     * @path /invites/{inviteId}
     * @deny (get, list, create, update, delete) No client-side access to invites is allowed.
     * @principle Relies on a trusted backend for invite management.
     */
    match /invites/{inviteId} {
      allow get, list, create, update, delete: if false;
    }
  }
}