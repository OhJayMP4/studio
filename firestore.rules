/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict, hierarchical access control model based on workspace membership and ownership.
 * Users can only access their own profile data. Workspaces, companies, projects, silos, and tasks are gated by workspace membership.
 * Denormalized data in /user-tasks allows efficient user-specific task queries.
 * Invites can only be created via trusted server to ensure security.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource (identified by userId).
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is a member of the specified workspace.
     */
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && 
             workspaceId != null && 
             workspaceId != "" &&
             exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
             request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users;
    }

    /**
     * @description Checks if the authenticated user is an admin of the specified workspace.
     */
    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceMember(workspaceId) && 
             get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    /**
     * @description Rules for user profile documents.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if isSignedIn() && isOwner(userId);
    }
    
    // --- Global Collection Group Queries ---
    // These allow the cross-company dashboard and search views.
    // We restrict these to ensure they are always filtered by a workspaceId the user belongs to.
    match /{path=**}/companies/{companyId} {
      allow get: if isWorkspaceMember(resource.data.workspaceId);
      allow list: if isWorkspaceMember(request.query.workspaceId);
    }
    match /{path=**}/projects/{projectId} {
      allow get: if isWorkspaceMember(resource.data.workspaceId);
      allow list: if isWorkspaceMember(request.query.workspaceId);
    }
    match /{path=**}/silos/{siloId} {
      allow get: if isWorkspaceMember(resource.data.workspaceId);
      allow list: if isWorkspaceMember(request.query.workspaceId);
    }
    match /{path=**}/tasks/{taskId} {
      allow get: if isWorkspaceMember(resource.data.workspaceId);
      allow list: if isWorkspaceMember(request.query.workspaceId);
    }

    /**
     * @description Rules for workspace documents.
     */
    match /workspaces/{workspaceId} {
      allow get, list: if isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if false; // Deletion must be done via Cloud Function

      match /companies/{companyId} {
        allow read, write: if isWorkspaceMember(workspaceId);

        match /projects/{projectId} {
          allow read, write: if isWorkspaceMember(workspaceId);

          match /silos/{siloId} {
            allow read, write: if isWorkspaceMember(workspaceId);

            match /tasks/{taskId} {
              allow read, write: if isWorkspaceMember(workspaceId);

              match /comments/{commentId=**} {
                allow get, list, create: if isWorkspaceMember(workspaceId);
                allow update, delete: if isWorkspaceMember(workspaceId) && isOwner(resource.data.createdBy);
              }
            }
          }
          
          match /sales/{saleId} {
            allow read, write: if isWorkspaceMember(workspaceId);
          }
        }
        
        match /socialPosts/{postId} {
          allow read, write: if isWorkspaceMember(workspaceId);
        }

        match /socialAccounts/{accountId} {
          allow read, write: if isWorkspaceAdmin(workspaceId);
        }
      }
    }
    
    /**
     * @description Rules for denormalized user task documents.
     */
     match /user-tasks/{userId}/tasks/{taskId} {
        allow get, list: if isSignedIn() && isOwner(userId);
        allow create: if isWorkspaceMember(request.resource.data.workspaceId);
        allow update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description System collections (Invites, Notifications, Presence, Prefs).
     */
    match /invites/{inviteId} {
      allow get, list, update, delete: if false;
      allow create: if isWorkspaceAdmin(request.resource.data.workspaceId);
    }

    match /notifications/{workspaceId}/activities/{activityId} {
      allow read, list, update: if isWorkspaceMember(workspaceId);
      allow create, delete: if false;
    }

     match /presence/{workspaceId}/users/{userId} {
      allow read, list: if isWorkspaceMember(workspaceId);
      allow create, update: if isOwner(userId) && isWorkspaceMember(workspaceId);
      allow delete: if false;
    }

    match /user-workspace-prefs/{docId} {
        allow read: if isSignedIn() && request.auth.uid == docId.split('-')[0];
        allow write: if isSignedIn() && request.auth.uid == resource.data.uid;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
    }

    match /workspace-files/{fileId} {
      allow list: if isSignedIn();
      allow get, update: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(request.resource.data.workspaceId);
      allow delete: if isWorkspaceAdmin(request.resource.data.workspaceId);
    }
  }
}
