
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is a member of a specific workspace
    function isWorkspaceMember(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.has(request.auth.uid);
    }
    
    // Helper function to check if a user is an admin of a specific workspace
    function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    // Users can only write to their own profile. Any authenticated user can read public profile info.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Rules for workspaces and all subcollections
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create: if request.auth.uid == request.resource.data.ownerId;
      allow update: if isWorkspaceAdmin(workspaceId);

      // Companies
      match /companies/{companyId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update, delete: if isWorkspaceAdmin(workspaceId);

        // Projects
        match /projects/{projectId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow create, update, delete: if isWorkspaceAdmin(workspaceId);

          // Sales
          match /sales/{saleId} {
            allow read: if isWorkspaceMember(workspaceId);
            allow create, update, delete: if isWorkspaceAdmin(workspaceId);
          }

          // Silos
          match /silos/{siloId} {
            allow read: if isWorkspaceMember(workspaceId);
            allow create, update, delete: if isWorkspaceAdmin(workspaceId);

            // Tasks
            match /tasks/{taskId} {
              allow read: if isWorkspaceMember(workspaceId);
              // Anyone in the workspace can create a task
              allow create: if isWorkspaceMember(workspaceId);
              // Only admins or the assignee can update/delete a task
              allow update, delete: if isWorkspaceAdmin(workspaceId) || request.auth.uid == resource.data.assigneeId;
            }
          }
        }
      }
    }
    
    // Rules for denormalized user tasks
    match /user-tasks/{userId} {
        // A user can only access their own task list
        allow read, list: if request.auth.uid == userId;

        // Allow a task to be created if the user creating it is a member of the workspace the task belongs to.
        // This securely enables the backend function to denormalize tasks for other users.
        allow create: if isWorkspaceMember(request.resource.data.workspaceId);
        
        // Allow a task to be updated/deleted only by the user it is assigned to.
        allow update, delete: if request.auth.uid == userId;
    }

    // Invites can be read/created by anyone (token is secret). Can only be deleted by the function.
    match /invites/{inviteId} {
        allow read, create: if request.auth != null;
        allow update, delete: return false; // Only backend can delete
    }
  }
}
