/**
 * @file
 * @description Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on user roles within workspaces
 * and ownership for user-specific data. It enforces strict authorization for all write operations
 * while allowing public read access to certain collections where ownership is validated on creation.
 * Data shape validation is minimized to allow for rapid prototyping.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - Workspaces are stored under `/workspaces/{workspaceId}`, containing information about members and their roles.
 * - Companies, projects, silos, tasks, and sales are nested hierarchically under workspaces.
 * - User specific tasks are denormalized in `/users/{userId}/tasks/{taskId}`
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Workspace access is controlled by the `users` map within each workspace document.
 * - Listing user profiles is disallowed.
 * - Public read access is granted to the `/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}` collection, but write access is restricted to validated owners.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map that stores user roles, enabling efficient authorization checks without additional reads.
 * - User specific tasks are denormalized in `/users/{userId}/tasks/{taskId}`
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (read, write) if the requesting user's UID matches the user ID in the path.
     * @deny (read, write) if the requesting user's UID does not match the user ID in the path.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      // Verified Identity:  All authorization decisions must rely on `request.auth` as the source of truth.
      function isSignedIn() {
        return request.auth != null;
      }

      // Flexible Access Control Patterns: Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(userId)`.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to user tasks documents.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (read, write) if the requesting user's UID matches the user ID in the path.
     * @deny (read, write) if the requesting user's UID does not match the user ID in the path.
     */
    match /users/{userId}/tasks/{taskId} {
      // Verified Identity:  All authorization decisions must rely on `request.auth` as the source of truth.
      function isSignedIn() {
        return request.auth != null;
      }

      // Flexible Access Control Patterns: Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(userId)`.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to workspace documents.
     * @path /workspaces/{workspaceId}
     * @allow (read, write) if the requesting user is a member of the workspace.
     * @deny (read, write) if the requesting user is not a member of the workspace.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isWorkspaceAdmin(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceAdmin(workspaceId);
    }

    /**
     * @description Controls access to company documents within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (read, write) if the requesting user is a member of the workspace.
     * @deny (read, write) if the requesting user is not a member of the workspace.
     * @principle Enforces role-based access control for companies within workspaces.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Controls access to project documents within a company.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (read, write) if the requesting user is a member of the workspace.
     * @deny (read, write) if the requesting user is not a member of the workspace.
     * @principle Enforces role-based access control for projects within companies.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Controls access to silo documents within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (read, write) if the requesting user is a member of the workspace.
     * @deny (read, write) if the requesting user is not a member of the workspace.
     * @principle Enforces role-based access control for silos within projects.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Controls access to task documents within a silo.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (read) to anyone.
     * @allow (create, update, delete) if the requesting user is a member of the workspace.
     * @deny (create, update, delete) if the requesting user is not a member of the workspace.
     * @principle Allows public read access but restricts write access to workspace members.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }

    /**
     * @description Controls access to sale documents within a project.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
     * @allow (read, write) if the requesting user is a member of the workspace.
     * @deny (read, write) if the requesting user is not a member of the workspace.
     * @principle Enforces role-based access control for sales within projects.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow update: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && isWorkspaceMember(workspaceId);
    }
  }
}