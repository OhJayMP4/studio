/**
 * @file Firestore Security Rules
 * @description This ruleset is currently in prototyping mode.
 *
 * Core Philosophy:
 * All reads and writes are allowed for all authenticated users.
 *
 * Data Structure:
 * /users/{userId} - User profile information
 * /workspaces/{workspaceId} - Workspace data and member roles
 * /workspaces/{workspaceId}/companies/{companyId} - Company information within a workspace
 * /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} - Project details for a company
 * /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} - Silos (columns) in a project
 * /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} - Tasks within a silo
 *
 * Key Security Decisions:
 * - All reads and writes are allowed for all authenticated users during prototyping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows all reads and writes for user profiles during prototyping.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny None - All reads and writes are allowed.
     * @principle Unrestricted access during prototyping.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows all reads and writes for workspaces during prototyping.
     * @path /workspaces/{workspaceId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny None - All reads and writes are allowed.
     * @principle Unrestricted access during prototyping.
     */
    match /workspaces/{workspaceId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows all reads and writes for companies during prototyping.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny None - All reads and writes are allowed.
     * @principle Unrestricted access during prototyping.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows all reads and writes for projects during prototyping.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny None - All reads and writes are allowed.
     * @principle Unrestricted access during prototyping.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows all reads and writes for silos during prototyping.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny None - All reads and writes are allowed.
     * @principle Unrestricted access during prototyping.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows all reads and writes for tasks during prototyping.
     * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny None - All reads and writes are allowed.
     * @principle Unrestricted access during prototyping.
     */
    match /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}