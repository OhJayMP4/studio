rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is the owner of the profile.
     * @deny (get, create, update, delete) if the user is not the owner of the profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing user profiles is not permitted.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to workspace documents.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create) if the user is the owner of the workspace.
     * @allow (update, delete) if the user is an admin of the workspace.
     * @deny (create, update, delete) if the user is not authorized.
     * @principle Enforces shared access with role-based authorization.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isWorkspaceMember() {
        return resource.data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin() {
        return resource.data.users[request.auth.uid].role == 'admin';
      }

      function isWorkspaceOwner() {
        return request.resource.data.ownerId == request.auth.uid;
      }

      function isExistingWorkspaceAdmin() {
        return isWorkspaceAdmin() && resource.data != null;
      }

      allow get: if isSignedIn() && isWorkspaceMember();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isWorkspaceOwner();
      allow update: if isSignedIn() && isExistingWorkspaceAdmin();
      allow delete: if isSignedIn() && isExistingWorkspaceAdmin();
    }

    /**
     * @description Controls access to company documents within a workspace.
     * @path /workspaces/{workspaceId}/companies/{companyId}
     * @allow (get, list) if the user is a member of the workspace.
     * @allow (create, update, delete) if the user is an admin of the workspace.
     * @deny (create, update, delete) if the user is not authorized.
     * @principle Enforces shared access with role-based authorization, inherited from the workspace.
     */
    match /workspaces/{workspaceId}/companies/{companyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getWorkspace() {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
      }

      function isWorkspaceMember() {
          return getWorkspace().data.users[request.auth.uid] != null;
      }

      function isWorkspaceAdmin() {
          return getWorkspace().data.users[request.auth.uid].role == 'admin';
      }

      function isExistingWorkspaceAdmin() {
          return isWorkspaceAdmin();
      }

      allow get: if isSignedIn() && isWorkspaceMember();
      allow list: if isSignedIn() && isWorkspaceMember();
      allow create: if isSignedIn() && isWorkspaceAdmin();
      allow update: if isSignedIn() && isExistingWorkspaceAdmin();
      allow delete: if isSignedIn() && isExistingWorkspaceAdmin();
    }
  }
}