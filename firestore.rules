/**
 * @fileoverview Firestore Security Rules for SaturnSync application.
 *
 * Core Philosophy:
 * This ruleset enforces a multi-tenant security model based on workspaces.
 * Users can only access workspaces they are explicitly members of.
 * Workspace owners have full control over their workspaces.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles; accessible only by the user themselves.
 * - /workspaces/{workspaceId}: Stores workspace metadata; accessible by workspace members.
 * - /workspaces/{workspaceId}/users/{userId}: Stores workspace user membership and roles.
 * - /workspaces/{workspaceId}/companies/{companyId}: Stores companies within workspaces.
 * - /companies/{companyId}/projects/{projectId}: Stores projects within companies.
 * - /projects/{projectId}/silos/{siloId}: Stores silos within projects.
 * - /silos/{siloId}/tasks/{taskId}: Stores tasks within silos.
 *
 * Key Security Decisions:
 * - Users can only list workspaces they are members of, via the /workspaces collection.
 * - Workspace membership is managed through the /workspaces/{workspaceId}/users/{userId} subcollection.
 * - Denormalization: WorkspaceUser documents contain redundant user information.  This is to simplify authorization checks and avoid extra reads.
 *
 *  - The rules do not perform full data validation to allow for rapid prototyping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own user profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get) if request.auth.uid != userId
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      // Only the user themselves can read their profile.
      allow get: if isOwner(userId);
      allow list: if false; // No listing of all users.

      // Only the user can create, update, or delete their own profile.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows listing of workspaces for members, and owner-only writes.
     * @path /workspaces/{workspaceId}
     * @allow (list) if true
     * @allow (get, create, update, delete) if resource.data.ownerId == request.auth.uid
     * @deny (get) if resource.data.ownerId != request.auth.uid
     * @principle Public read with owner-only writes.
     */
    match /workspaces/{workspaceId} {
        // Everyone can list workspaces.  Membership is validated in the /workspaces/{workspaceId}/users/{userId} collection.
        allow list: if true;

        // Only the owner can get workspace details.
        allow get: if isWorkspaceOwner(workspaceId);

        // Only the owner can create a workspace, and the ownerId must match their UID.
        allow create: if request.auth.uid == request.resource.data.ownerId;

        // Only the owner can update or delete the workspace.
        allow update: if isWorkspaceOwner(workspaceId);
        allow delete: if isWorkspaceOwner(workspaceId);

        /**
         * @description Allows workspace admins to manage workspace users.
         * @path /workspaces/{workspaceId}/users/{userId}
         * @allow (get, list, create, update, delete) if workspace().data.ownerId == request.auth.uid
         * @deny (get) if workspace().data.ownerId != request.auth.uid
         * @principle Enforces workspace admin control over workspace users.
         */
        match /users/{userId} {
            // Anyone who is a member of the workspace can read user details.
            allow get: if isWorkspaceMember(workspaceId, userId);
            allow list: if false;

            // Only workspace admins can create workspace users.
            allow create: if isWorkspaceAdmin(workspaceId);

            // Only workspace admins can update workspace users.
            allow update: if isWorkspaceAdmin(workspaceId);

            // Only workspace admins can delete workspace users.
            allow delete: if isWorkspaceAdmin(workspaceId);
        }

        /**
         * @description Allows workspace admins to manage companies within a workspace.
         * @path /workspaces/{workspaceId}/companies/{companyId}
         * @allow (get, list, create, update, delete) if workspace().data.ownerId == request.auth.uid
         * @deny (get) if workspace().data.ownerId != request.auth.uid
         * @principle Enforces workspace admin control over companies.
         */
        match /companies/{companyId} {
            // Anyone who is a member of the workspace can read company details.
            allow get: if isWorkspaceMember(workspaceId);
            allow list: if isWorkspaceMember(workspaceId);

            // Only workspace admins can create companies.
            allow create: if isWorkspaceAdmin(workspaceId);

            // Only workspace admins can update companies.
            allow update: if isWorkspaceAdmin(workspaceId);

            // Only workspace admins can delete companies.
            allow delete: if isWorkspaceAdmin(workspaceId);

            /**
             * @description Allows project admins to manage projects within a company.
             * @path /companies/{companyId}/projects/{projectId}
             * @allow (get, list, create, update, delete) if company().data.workspaceId == request.auth.uid
             * @deny (get) if company().data.workspaceId != request.auth.uid
             */
            match /projects/{projectId} {
                // Anyone who is a member of the workspace can read project details.
                allow get: if isWorkspaceMember(workspaceId);
                allow list: if isWorkspaceMember(workspaceId);

                // Only workspace admins can create projects.
                allow create: if isWorkspaceAdmin(workspaceId);

                // Only workspace admins can update projects.
                allow update: if isWorkspaceAdmin(workspaceId);

                // Only workspace admins can delete projects.
                allow delete: if isWorkspaceAdmin(workspaceId);

                /**
                 * @description Allows project admins to manage silos within a project.
                 * @path /projects/{projectId}/silos/{siloId}
                 * @allow (get, list, create, update, delete) if project().data.companyId == request.auth.uid
                 * @deny (get) if project().data.companyId != request.auth.uid
                 */
                match /silos/{siloId} {
                    // Anyone who is a member of the workspace can read silo details.
                    allow get: if isWorkspaceMember(workspaceId);
                    allow list: if isWorkspaceMember(workspaceId);

                    // Only workspace admins can create silos.
                    allow create: if isWorkspaceAdmin(workspaceId);

                    // Only workspace admins can update silos.
                    allow update: if isWorkspaceAdmin(workspaceId);

                    // Only workspace admins can delete silos.
                    allow delete: if isWorkspaceAdmin(workspaceId);

                    /**
                     * @description Allows silo admins to manage tasks within a silo.
                     * @path /silos/{siloId}/tasks/{taskId}
                     * @allow (get, list, create, update, delete) if silo().data.projectId == request.auth.uid
                     * @deny (get) if silo().data.projectId != request.auth.uid
                     */
                    match /tasks/{taskId} {
                        // Anyone who is a member of the workspace can read task details.
                        allow get: if isWorkspaceMember(workspaceId);
                        allow list: if isWorkspaceMember(workspaceId);

                        // Only workspace admins can create tasks.
                        allow create: if isWorkspaceAdmin(workspaceId);

                        // Only workspace admins can update tasks.
                        allow update: if isWorkspaceAdmin(workspaceId);

                        // Only workspace admins can delete tasks.
                        allow delete: if isWorkspaceAdmin(workspaceId);
                    }
                }
            }
        }
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document (userId matches request.auth.uid).
     * @param {string} userId - The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the document and the document exists.
     * @param {string} userId - The user ID to check against.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
    }

    /**
     * @description Checks if the user is the owner of the workspace.
     * @param {string} workspaceId - The workspace ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && workspace(workspaceId).data.ownerId == request.auth.uid;
    }

    /**
     * @description Checks if the user is the owner of the workspace and the document exists.
     * @param {string} workspaceId - The workspace ID to check against.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingWorkspaceOwner(workspaceId) {
        return isWorkspaceOwner(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

      /**
       * @description Checks if the user is a member of the workspace
       * @param {string} workspaceId - The workspace ID to check against.
       * @return {boolean} True if the user is a member, false otherwise.
       */
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
    }
    
      /**
       * @description Checks if the user is a member of the workspace
       * @param {string} workspaceId - The workspace ID to check against.
       * @param {string} userId - The user ID to check against
       * @return {boolean} True if the user is a member, false otherwise.
       */
    function isWorkspaceMember(workspaceId, userId) {
      return isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(userId));
    }
      /**
       * @description Checks if the user is an admin of the workspace.
       * @param {string} workspaceId - The workspace ID to check against.
       * @return {boolean} True if the user is an admin, false otherwise.
       */
    function isWorkspaceAdmin(workspaceId) {
      return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)).data.role == 'admin';
    }
        /**
         * @description Checks if the user is an admin of the workspace and the document exists.
         * @param {string} workspaceId - The workspace ID to check against.
         * @return {boolean} True if the user is an admin and the document exists, false otherwise.
         */
    function isExistingWorkspaceAdmin(workspaceId) {
        return isWorkspaceAdmin(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid));
    }

    /**
     * @description Gets the workspace document.
     * @param {string} workspaceId - The workspace ID.
     * @return {firestore.Document} The workspace document.
     */
    function workspace(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    /**
     * @description Gets the company document.
     * @param {string} workspaceId - The workspace ID.
     * @param {string} companyId - The company ID.
     * @return {firestore.Document} The company document.
     */
    function company(workspaceId, companyId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)/companies/$(companyId));
    }

    /**
     * @description Gets the project document.
     * @param {string} workspaceId - The workspace ID.
     * @param {string} companyId - The company ID.
     * @param {string} projectId - The project ID.
     * @return {firestore.Document} The project document.
     */
    function project(workspaceId, companyId, projectId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)/companies/$(companyId)/projects/$(projectId));
    }

    /**
     * @description Gets the silo document.
     * @param {string} workspaceId - The workspace ID.
     * @param {string} companyId - The company ID.
     * @param {string} projectId - The project ID.
     * @param {string} siloId - The silo ID.
     * @return {firestore.Document} The silo document.
     */
    function silo(workspaceId, companyId, projectId, siloId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)/companies/$(companyId)/projects/$(projectId)/silos/$(siloId));
    }
  }
}