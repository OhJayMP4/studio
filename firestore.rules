rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create, update, delete, get, list) User with matching UID can access their own profile.
     * @deny (create, update, delete, get, list) User attempts to access a different user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure workspaces. Access is controlled by the 'members' map in the document.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) Any authenticated user can read workspace if they are a member.
     * @allow (create) Any authenticated user can create a workspace.
     * @allow (update, delete) Only workspace admins can modify or delete a workspace.
     * @deny (create, update, delete, get, list) Unauthorized access.
     * @principle Implements role-based access control using a 'members' map.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isMember(workspaceId) {
        return isSignedIn() && 'memberIds' in resource.data && resource.data.memberIds is list && resource.data.memberIds.hasAny([request.auth.uid]);
      }

      function isAdmin(workspaceId) {
        return isSignedIn() && 'users' in resource.data && request.auth.uid in resource.data.users && resource.data.users[request.auth.uid].role == 'admin';
      }

      allow get, list: if isMember(workspaceId);
      allow create: if isSignedIn();
      allow update: if isAdmin(workspaceId);
      allow delete: if isAdmin(workspaceId);

      /**
       * @description Secure companies within a workspace.  Inherit workspace-level permissions.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (get, list) Members of the workspace can read companies.
       * @allow (create) Admins of the workspace can create companies.
       * @allow (update, delete) Admins of the workspace can update/delete companies.
       * @deny (create, update, delete, get, list) Non-members cannot access companies.
       * @principle Enforces workspace-level role-based access control for subcollections.
       */
      match /companies/{companyId} {
        allow get, list: if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
        allow create: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        allow update: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        allow delete: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';

        /**
         * @description Secure projects within a company. Inherit workspace-level permissions.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
         * @allow (get, list) Members of the workspace can read projects.
         * @allow (create) Admins of the workspace can create projects.
         * @allow (update, delete) Admins of the workspace can update/delete projects.
         * @deny (create, update, delete, get, list) Non-members cannot access projects.
         * @principle Enforces workspace-level role-based access control for nested subcollections.
         */
        match /projects/{projectId} {
          allow get, list: if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
          allow create: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
          allow update: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
          allow delete: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';

          /**
           * @description Secure silos within a project. Inherit workspace-level permissions.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
           * @allow (get, list) Members of the workspace can read silos.
           * @allow (create) Admins of the workspace can create silos.
           * @allow (update, delete) Admins of the workspace can update/delete silos.
           * @deny (create, update, delete, get, list) Non-members cannot access silos.
           * @principle Enforces workspace-level role-based access control for deeply nested subcollections.
           */
          match /silos/{siloId} {
            allow get, list: if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
            allow create: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            allow update: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            allow delete: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';

            /**
             * @description Secure tasks within a silo. Inherit workspace-level permissions.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
             * @allow (get, list) Members of the workspace can read tasks.
             * @allow (create) Admins of the workspace can create tasks.
             * @allow (update, delete) Admins of the workspace can update/delete tasks.
             * @deny (create, update, delete, get, list) Non-members cannot access tasks.
             * @principle Enforces workspace-level role-based access control for deeply nested subcollections.
             */
            match /tasks/{taskId} {
              allow get, list: if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
              allow create: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
              allow update: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
              allow delete: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            }
          }

          /**
           * @description Secure sales within a project. Inherit workspace-level permissions.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
           * @allow (get, list) Members of the workspace can read sales.
           * @allow (create) Admins of the workspace can create sales.
           * @allow (update, delete) Admins of the workspace can update/delete sales.
           * @deny (create, update, delete, get, list) Non-members cannot access sales.
           * @principle Enforces workspace-level role-based access control for nested subcollections.
           */
          match /sales/{saleId} {
            allow get, list: if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
            allow create: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            allow update: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            allow delete: if 'users' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
          }
        }
      }
    }

    /**
     * @description Secure denormalized user tasks. Only the user can read/write their own tasks.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (create, update, delete, get, list) User with matching UID can access their own tasks.
     * @deny (create, update, delete, get, list) User attempts to access a different user's tasks.
     * @principle Enforces document ownership for writes.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure invites. Publicly readable to allow verification of invite tokens.
     * @path /invites/{inviteId}
     * @allow (get, list) Any user can check the validity of an invite token.
     * @deny (create, update, delete) No one can create, modify, or delete invites through the client.
     * @principle Allows public read access for specific data.
     */
    match /invites/{inviteId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}