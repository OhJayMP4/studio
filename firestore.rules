/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure authorization based on user roles and ownership, while relaxing data shape validation for rapid prototyping.
 *
 * Data Structure:
 * The Firestore database is organized hierarchically with workspaces at the root.  Workspaces contain companies, which contain projects, which contain silos, which contain tasks.
 * User profiles are stored in a separate `/users` collection. Denormalized user-task relationships are stored in the `/user-tasks` collection.  Invitations are stored in the `/invites` collection.
 *
 * Key Security Decisions:
 * - Users can only read their own profile data.
 * - Workspace ownership and membership determine access to workspaces and their child collections (companies, projects, silos, tasks, and sales).
 * - User listing is disallowed.
 * - Data validation is minimized to focus on authorization.
 *
 * Denormalization for Authorization:
 * - Workspace documents contain a `users` map that stores user roles within the workspace.  This allows for efficient role-based authorization without needing to query a separate collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (get, list) User with matching UID can read their profile.
     * @allow (create, update, delete) User with matching UID can create/update/delete their profile.
     * @deny (get, list) User attempts to read another user's profile.
     * @deny (create, update, delete) User attempts to modify another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages workspaces, allowing workspace owners and members to read workspace data.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) Authenticated user can read workspace data.
     * @allow (create) Authenticated user can create a workspace.
     * @allow (update, delete) Only the workspace owner can update/delete the workspace.
     * @deny Unauthorized access.
     * @principle Enforces workspace ownership and membership for write operations.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isWorkspaceOwner(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }
       function isWorkspaceMember(workspaceId) {
        return request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && isWorkspaceOwner(workspaceId);

      match /companies/{companyId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
          allow update, delete: if isSignedIn() && isWorkspaceMember(workspaceId);

          match /projects/{projectId} {
              allow get, list: if isSignedIn();
              allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
              allow update, delete: if isSignedIn() && isWorkspaceMember(workspaceId);

              match /silos/{siloId} {
                  allow get, list: if isSignedIn();
                  allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
                  allow update, delete: if isSignedIn() && isWorkspaceMember(workspaceId);

                  match /tasks/{taskId} {
                      function isWorkspaceMember(workspaceId) {
                          return request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users;
                      }
                      allow get, list: if isSignedIn();
                      allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
                      allow update, delete: if isSignedIn() && isWorkspaceMember(workspaceId);
                  }

                  match /sales/{saleId} {
                       allow get, list: if isSignedIn();
                       allow create: if isSignedIn() && isWorkspaceMember(workspaceId);
                       allow update, delete: if isSignedIn() && isWorkspaceMember(workspaceId);
                  }
              }
          }
      }
    }

    /**
     * @description Manages denormalized user-task relationships, restricting access to the specific user's tasks.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) User with matching UID can read their task data.
     * @allow (create) Authenticated user can create a user task.
     * @allow (update, delete) User with matching UID can update/delete their task data.
     * @deny Unauthorized access.
     * @principle Enforces document ownership for all operations.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages invites.
     * @path /invites/{inviteId}
     * @allow (get, list) No access.
     * @allow (create) No access.
     * @allow (update, delete) No access.
     */
    match /invites/{inviteId} {
        allow get, list, create, update, delete: if false;
    }
  }
}