/**
 * @fileoverview Firestore Security Rules for Saturn Management.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and utilizes
 * shared access control for workspaces and their associated data (companies, projects, tasks, sales).
 * User-specific task lists are also secured using ownership.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the owning user.
 * - /workspaces/{workspaceId}: Workspaces, accessible to members.
 * - /workspaces/{workspaceId}/companies/{companyId}: Companies within workspaces, accessible to workspace members.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}: Projects within companies, accessible to workspace members.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}: Silos (task containers) within projects, accessible to workspace members.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}: Tasks within silos, accessible to workspace members.
 * - /user-tasks/{userId}/tasks/{taskId}: Denormalized task lists, accessible only to the owning user.
 * - /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}: Sales logged for projects, accessible to workspace members.
 * - /invites/{inviteId}: Invitations to join workspaces, publicly readable but with restricted creation.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted to invites for simplified handling.
 * - Data validation is limited to fields crucial for authorization and relational integrity,
 *   allowing for flexible data shapes during prototyping.
 *
 * Denormalization for Authorization:
 * - Workspace membership is stored directly on the `/workspaces/{workspaceId}` document
 *   in the `users` map, enabling efficient access control for all workspace-related data.
 *   The `memberIds` array is for simpler querying.
 *
 * Structural Segregation:
 * - Private user data is stored under `/users/{userId}`, while invites are stored
 *   in a separate top-level collection for public read access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages workspaces and their member access.
     * @path /workspaces/{workspaceId}
     * @allow (get, list) if request.auth.uid in resource.data.memberIds
     * @allow (create) if request.auth.uid == request.resource.data.ownerId
     * @allow (update, delete) if resource.data.users[request.auth.uid].role == 'admin'
     * @deny (create, update, delete) if the user is not an admin or the owner
     * @principle Grants workspace access to members and restricts management to admins.
     */
    match /workspaces/{workspaceId} {
      function isWorkspaceMember(workspaceId) {
        return request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;
      }

      function isWorkspaceAdmin(workspaceId) {
        return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      }

      allow get: if exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid]);
      allow list: if false;
      allow create: if request.auth.uid == request.resource.data.ownerId;
      allow update: if exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
      allow delete: if exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';

      /**
       * @description Manages companies within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
       * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
       * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
       * @deny (create, update, delete) if the user is not an admin of the workspace
       * @principle Restricts company management to workspace admins.
       */
      match /companies/{companyId} {
        function getWorkspace() {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId));
        }

        function isWorkspaceMember() {
          return request.auth.uid in getWorkspace().data.memberIds;
        }

        function isWorkspaceAdmin() {
          return getWorkspace().data.users[request.auth.uid].role == 'admin';
        }

        allow get: if isWorkspaceMember();
        allow list: if isWorkspaceMember();
        allow create: if isWorkspaceAdmin();
        allow update: if isWorkspaceAdmin();
        allow delete: if isWorkspaceAdmin();

        /**
         * @description Manages projects within a company.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
         * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
         * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
         * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
         * @deny (create, update, delete) if the user is not an admin of the workspace
         * @principle Restricts project management to workspace admins.
         */
        match /projects/{projectId} {
          function getWorkspace() {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId));
          }

          function isWorkspaceMember() {
            return request.auth.uid in getWorkspace().data.memberIds;
          }

          function isWorkspaceAdmin() {
            return getWorkspace().data.users[request.auth.uid].role == 'admin';
          }

          allow get: if isWorkspaceMember();
          allow list: if isWorkspaceMember();
          allow create: if isWorkspaceAdmin();
          allow update: if isWorkspaceAdmin();
          allow delete: if isWorkspaceAdmin();

          /**
           * @description Manages silos within a project.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
           * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
           * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
           * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
           * @deny (create, update, delete) if the user is not an admin of the workspace
           * @principle Restricts silo management to workspace admins.
           */
          match /silos/{siloId} {
            function getWorkspace() {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId));
            }

            function isWorkspaceMember() {
              return request.auth.uid in getWorkspace().data.memberIds;
            }

            function isWorkspaceAdmin() {
              return getWorkspace().data.users[request.auth.uid].role == 'admin';
            }

            allow get: if isWorkspaceMember();
            allow list: if isWorkspaceMember();
            allow create: if isWorkspaceAdmin();
            allow update: if isWorkspaceAdmin();
            allow delete: if isWorkspaceAdmin();

            /**
             * @description Manages tasks within a silo.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
             * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
             * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
             * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
             * @deny (create, update, delete) if the user is not an admin of the workspace
             * @principle Restricts task management to workspace admins.
             */
            match /tasks/{taskId} {
              function getWorkspace() {
                return get(/databases/$(database)/documents/workspaces/$(workspaceId));
              }

              function isWorkspaceMember() {
                return request.auth.uid in getWorkspace().data.memberIds;
              }

              function isWorkspaceAdmin() {
                return getWorkspace().data.users[request.auth.uid].role == 'admin';
              }

              allow get: if isWorkspaceMember();
              allow list: if isWorkspaceMember();
              allow create: if isWorkspaceAdmin();
              allow update: if isWorkspaceAdmin();
              allow delete: if isWorkspaceAdmin();
            }
          }

          /**
           * @description Manages sales within a project.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
           * @allow (get, list) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds.hasAny([request.auth.uid])
           * @allow (create) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
           * @allow (update, delete) if get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin'
           * @deny (create, update, delete) if the user is not an admin of the workspace
           * @principle Restricts sale management to workspace admins.
           */
          match /sales/{saleId} {
             function getWorkspace() {
                return get(/databases/$(database)/documents/workspaces/$(workspaceId));
              }

              function isWorkspaceMember() {
                return request.auth.uid in getWorkspace().data.memberIds;
              }

              function isWorkspaceAdmin() {
                return getWorkspace().data.users[request.auth.uid].role == 'admin';
              }

            allow get: if isWorkspaceMember();
            allow list: if isWorkspaceMember();
            allow create: if isWorkspaceAdmin();
            allow update: if isWorkspaceAdmin();
            allow delete: if isWorkspaceAdmin();
          }
        }
      }
    }

    /**
     * @description Allows users to read and write their own denormalized task data.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (get, list) if request.auth.uid == userId
     * @allow (create, update, delete) if request.auth.uid == userId
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for denormalized user tasks.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to invites, but restricts creation.
     * @path /invites/{inviteId}
     * @allow (get, list) if true
     * @allow (create) if request.auth.uid != null // TODO: Add stronger validation on create
     * @deny (update, delete)
     * @principle Allows public reading for invite links.
     */
    match /invites/{inviteId} {
        allow get: if true;
        allow list: if true;
        allow create: if request.auth.uid != null; // TODO: Add stronger validation on create
        allow update: if false;
        allow delete: if false;
    }
  }
}