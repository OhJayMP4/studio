rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (read, write) User with matching {userId} can access their own profile.
     * @deny (read, write) User attempts to access another user's profile.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to workspace documents based on user roles.
     * @path /workspaces/{workspaceId}
     * @allow (read) Any authenticated user who is a member of the workspace can read it.
     * @allow (create) Any authenticated user can create a workspace, and they become the owner.
     * @allow (update, delete) Only the workspace owner (admin role) can update or delete the workspace.
     * @deny (read, write) Unauthorized users cannot access workspace data.
     * @principle Enforces role-based access control for workspaces.
     */
    match /workspaces/{workspaceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin(workspaceId) {
        return isSignedIn() && resource.data.users[request.auth.uid].role == 'admin';
      }

      function isContributor(workspaceId) {
        return isSignedIn() && resource.data.users[request.auth.uid].role == 'contributor';
      }

      function isViewer(workspaceId) {
        return isSignedIn() && resource.data.users[request.auth.uid].role == 'viewer';
      }

      function isWorkspaceMember(workspaceId) {
        return isSignedIn() && resource.data.users[request.auth.uid] != null;
      }

      allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isAdmin(workspaceId);
      allow delete: if isSignedIn() && isAdmin(workspaceId);

      /**
       * @description Controls access to company documents within a workspace.
       * @path /workspaces/{workspaceId}/companies/{companyId}
       * @allow (read) Any workspace member can read company data.
       * @allow (create) Contributors and admins can create companies.
       * @allow (update, delete) Only admins can update or delete companies.
       * @deny (read, write) Unauthorized users cannot access company data.
       * @principle Enforces role-based access control for companies within workspaces.
       */
      match /companies/{companyId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isAdmin(workspaceId) {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        }

        function isContributor(workspaceId) {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'contributor';
        }

        function isWorkspaceMember(workspaceId) {
          return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
        }

        allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
        allow list: if false;
        allow create: if isSignedIn() && (isContributor(workspaceId) || isAdmin(workspaceId));
        allow update: if isSignedIn() && isAdmin(workspaceId);
        allow delete: if isSignedIn() && isAdmin(workspaceId);

        /**
         * @description Controls access to project documents within a company.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}
         * @allow (read) Any workspace member can read project data.
         * @allow (create) Contributors and admins can create projects.
         * @allow (update, delete) Only admins can update or delete projects.
         * @deny (read, write) Unauthorized users cannot access project data.
         * @principle Enforces role-based access control for projects within companies.
         */
        match /projects/{projectId} {
          function isSignedIn() {
            return request.auth != null;
          }

          function isAdmin(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
          }

          function isContributor(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'contributor';
          }

          function isWorkspaceMember(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
          }

          allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
          allow list: if false;
          allow create: if isSignedIn() && (isContributor(workspaceId) || isAdmin(workspaceId));
          allow update: if isSignedIn() && isAdmin(workspaceId);
          allow delete: if isSignedIn() && isAdmin(workspaceId);

          /**
           * @description Controls access to silo documents within a project.
           * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}
           * @allow (read) Any workspace member can read silo data.
           * @allow (create) Contributors and admins can create silos.
           * @allow (update, delete) Only admins can update or delete silos.
           * @deny (read, write) Unauthorized users cannot access silo data.
           * @principle Enforces role-based access control for silos within projects.
           */
          match /silos/{siloId} {
            function isSignedIn() {
              return request.auth != null;
            }

            function isAdmin(workspaceId) {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
            }

            function isContributor(workspaceId) {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'contributor';
            }

            function isWorkspaceMember(workspaceId) {
              return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
            }

            allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
            allow list: if false;
            allow create: if isSignedIn() && (isContributor(workspaceId) || isAdmin(workspaceId));
            allow update: if isSignedIn() && isAdmin(workspaceId);
            allow delete: if isSignedIn() && isAdmin(workspaceId);

            /**
             * @description Controls access to task documents within a silo.
             * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}
             * @allow (read) Any workspace member can read task data.
             * @allow (create) Contributors and admins can create tasks.
             * @allow (update, delete) Only admins can update or delete tasks.
             * @deny (read, write) Unauthorized users cannot access task data.
             * @principle Enforces role-based access control for tasks within silos.
             */
            match /tasks/{taskId} {
              function isSignedIn() {
                return request.auth != null;
              }

              function isAdmin(workspaceId) {
                return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
              }

              function isContributor(workspaceId) {
                return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'contributor';
              }

              function isWorkspaceMember(workspaceId) {
                return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
              }

              allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
              allow list: if false;
              allow create: if isSignedIn() && (isContributor(workspaceId) || isAdmin(workspaceId));
              allow update: if isSignedIn() && isAdmin(workspaceId);
              allow delete: if isSignedIn() && isAdmin(workspaceId);
            }
          }
        }

        /**
         * @description Controls access to sale documents within a project.
         * @path /workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}
         * @allow (read) Any workspace member can read sale data.
         * @allow (create) Contributors and admins can create sales.
         * @allow (update, delete) Only admins can update or delete sales.
         * @deny (read, write) Unauthorized users cannot access sale data.
         * @principle Enforces role-based access control for sales within projects.
         */
        match /sales/{saleId} {
          function isSignedIn() {
            return request.auth != null;
          }

          function isAdmin(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
          }

          function isContributor(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'contributor';
          }

          function isWorkspaceMember(workspaceId) {
            return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
          }

          allow get: if isSignedIn() && isWorkspaceMember(workspaceId);
          allow list: if false;
          allow create: if isSignedIn() && (isContributor(workspaceId) || isAdmin(workspaceId));
          allow update: if isSignedIn() && isAdmin(workspaceId);
          allow delete: if isSignedIn() && isAdmin(workspaceId);
        }
      }
    }

    /**
     * @description Controls access to denormalized user task documents.
     * @path /user-tasks/{userId}/tasks/{taskId}
     * @allow (read) Only the user with the matching {userId} can read their own tasks.
     * @allow (write) No direct writes allowed to user-tasks collection (only through backend triggers).
     * @principle Enforces data ownership and prevents direct client-side modification of denormalized data.
     */
    match /user-tasks/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to invite documents.
     * @path /invites/{inviteId}
     * @allow (read) No reads are allowed.
     * @allow (create) Any signed in user can create an invite
     * @allow (write) No updates or deletes allowed.
     */
    match /invites/{inviteId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}