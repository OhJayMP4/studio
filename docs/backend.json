{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user's public profile.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        },
        "name": {
          "type": "string",
          "description": "The display name of the user."
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL for the user's avatar image."
        },
        "workspaceIds": {
          "type": "array",
          "description": "An array of workspace IDs the user is a member of.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "uid",
        "email"
      ]
    },
    "Workspace": {
      "title": "Workspace",
      "type": "object",
      "description": "A workspace containing companies, projects, etc.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the workspace."
        },
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns the workspace."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL of the workspace logo"
        },
        "memberIds": {
          "type": "array",
          "description": "An array of UIDs for all members of the workspace, for querying.",
          "items": {
            "type": "string"
          }
        },
        "users": {
          "type": "object",
          "description": "A map of user UIDs to their roles and info within the workspace.",
          "patternProperties": {
            "^[a-zA-Z0-9_]+$": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "admin",
                    "contributor",
                    "viewer"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "avatarUrl": {
                  "type": "string"
                }
              },
              "required": [
                "role"
              ]
            }
          }
        }
      },
      "required": [
        "name",
        "ownerId",
        "users",
        "memberIds"
      ]
    },
    "Company": {
      "title": "Company",
      "type": "object",
      "description": "A company within a workspace.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the company."
        },
        "description": {
          "type": "string",
          "description": "A description of the company."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL for the company's logo."
        },
        "yearlyTurnoverTarget": {
          "type": "number",
          "description": "The yearly turnover target for the company."
        }
      },
      "required": [
        "name",
        "description"
      ]
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "description": "A project within a company.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the project."
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "description": "The project deadline."
        },
        "hasMonetaryValue": {
          "type": "boolean",
          "description": "Whether the project has a monetary value."
        },
        "monetaryValue": {
          "type": "number",
          "description": "The monetary value of the project."
        },
        "progress": {
          "type": "number",
          "description": "The project's progress from 0 to 100."
        },
        "companyId": {
          "type": "string",
          "description": "The ID of the company this project belongs to."
        },
        "totalSalesValue": {
          "type": "number",
          "description": "The total value of all logged sales for the project."
        }
      },
      "required": [
        "name",
        "deadline",
        "hasMonetaryValue",
        "progress",
        "companyId"
      ]
    },
    "Silo": {
      "title": "Silo",
      "type": "object",
      "description": "A container for tasks within a project (e.g., a column in a Kanban board).",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the silo (e.g., To Do, In Progress)."
        },
        "order": {
          "type": "number",
          "description": "The order of the silo in the project view."
        }
      },
      "required": [
        "name",
        "order"
      ]
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "description": "A single task item within a silo.",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the task."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the task."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task has been completed."
        },
        "dueDate": {
          "type": "string",
          "format": "date-time",
          "description": "The due date for the task."
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "The priority of the task."
        },
        "assigneeId": {
          "type": "string",
          "description": "The UID of the user assigned to this task."
        },
        "projectId": {
          "type": "string",
          "description": "The ID of the project this task belongs to."
        }
      },
      "required": [
        "title",
        "completed",
        "priority",
        "assigneeId",
        "dueDate",
        "projectId"
      ]
    },
    "UserTask": {
      "title": "User Task",
      "type": "object",
      "description": "A denormalized task document for quick lookups by user.",
      "properties": {
        "originalTaskId": {
          "type": "string",
          "description": "The original ID of the task document."
        },
        "workspaceId": {
          "type": "string"
        },
        "companyId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "siloId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "dueDate": {
          "type": "string",
          "format": "date-time"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assigneeId": {
          "type": "string"
        },
        "companyName": {
          "type": "string"
        },
        "projectName": {
          "type": "string"
        },
        "siloName": {
          "type": "string"
        }
      },
      "required": [
        "originalTaskId",
        "workspaceId",
        "companyId",
        "siloId",
        "projectId",
        "title",
        "completed",
        "priority",
        "assigneeId",
        "dueDate",
        "companyName",
        "projectName",
        "siloName"
      ]
    },
    "Sale": {
      "title": "Sale",
      "type": "object",
      "description": "A logged sale for a project.",
      "properties": {
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date of the sale."
        },
        "source": {
          "type": "string",
          "description": "The source of the sale."
        },
        "value": {
          "type": "number",
          "description": "The value of the sale in ZAR."
        },
        "projectId": {
          "type": "string",
          "description": "The ID of the project this sale belongs to."
        }
      },
      "required": [
        "date",
        "source",
        "value",
        "projectId"
      ]
    },
    "Invite": {
      "title": "Invite",
      "type": "object",
      "description": "An invitation for a user to join a workspace.",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "The ID of the workspace the user is invited to."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email of the user being invited."
        },
        "token": {
          "type": "string",
          "description": "The unique, secret invite token."
        },
        "expires": {
          "type": "number",
          "description": "A Unix timestamp indicating when the invite expires."
        }
      },
      "required": [
        "workspaceId",
        "email",
        "token",
        "expires"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile information."
    },
    "/workspaces/{workspaceId}": {
      "schema": {
        "$ref": "#/entities/Workspace"
      },
      "description": "Stores workspace data, including member roles."
    },
    "/workspaces/{workspaceId}/companies/{companyId}": {
      "schema": {
        "$ref": "#/entities/Company"
      },
      "description": "Stores company data within a workspace."
    },
    "/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Stores project data within a company."
    },
    "/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}": {
      "schema": {
        "$ref": "#/entities/Silo"
      },
      "description": "Stores the silos (task containers) for a project."
    },
    "/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/silos/{siloId}/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Stores the individual tasks within a silo."
    },
    "/user-tasks/{userId}/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/UserTask"
      },
      "description": "Denormalized tasks for a specific user for efficient lookup."
    },
    "/workspaces/{workspaceId}/companies/{companyId}/projects/{projectId}/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Stores the individual sales logged for a project."
    },
    "/invites/{inviteId}": {
      "schema": {
        "$ref": "#/entities/Invite"
      },
      "description": "Stores pending invitations for users to join workspaces."
    }
  }
}
