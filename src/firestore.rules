
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is a member of the specified workspace.
     */
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && workspaceId != null && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.users;
    }

    /**
     * @description Checks if the authenticated user is an admin of the specified workspace.
     */
    function isWorkspaceAdmin(workspaceId) {
      let ws = get(/databases/$(database)/documents/workspaces/$(workspaceId));
      return isWorkspaceMember(workspaceId) && ws.data.users[request.auth.uid].role == 'admin';
    }

    /**
     * @description User Profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if isSignedIn() && isOwner(userId);
    }
    
    /**
     * @description Global Collection Group Queries (secured by workspaceId filter).
     */
    match /{path=**}/companies/{companyId} {
      allow get: if isSignedIn() && isWorkspaceMember(resource.data.workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(request.query.workspaceId);
    }
    match /{path=**}/projects/{projectId} {
      allow get: if isSignedIn() && isWorkspaceMember(resource.data.workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(request.query.workspaceId);
    }
    match /{path=**}/silos/{siloId} {
      allow get: if isSignedIn() && isWorkspaceMember(resource.data.workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(request.query.workspaceId);
    }
    match /{path=**}/tasks/{taskId} {
      allow get: if isSignedIn() && isWorkspaceMember(resource.data.workspaceId);
      allow list: if isSignedIn() && isWorkspaceMember(request.query.workspaceId);
    }

    /**
     * @description Workspaces and nested content.
     */
    match /workspaces/{workspaceId} {
      allow get, list: if isWorkspaceMember(workspaceId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if false; // Via Cloud Function only

      match /companies/{companyId} {
        allow read, write: if isWorkspaceMember(workspaceId);

        match /projects/{projectId} {
          allow read, write: if isWorkspaceMember(workspaceId);

          match /silos/{siloId} {
            allow read, write: if isWorkspaceMember(workspaceId);

            match /tasks/{taskId} {
              allow read, write: if isWorkspaceMember(workspaceId);

              match /comments/{commentId=**} {
                allow get, list, create: if isWorkspaceMember(workspaceId);
                allow update, delete: if isWorkspaceMember(workspaceId) && isOwner(resource.data.createdBy);
              }
            }
          }
          
          match /sales/{saleId} {
            allow read, write: if isWorkspaceMember(workspaceId);
          }
        }
        
        match /socialPosts/{postId} {
          allow read, write: if isWorkspaceMember(workspaceId);
        }

        match /socialAccounts/{accountId} {
          allow read, write: if isWorkspaceAdmin(workspaceId);
        }
      }
    }
    
    /**
     * @description User-specific tasks (denormalized).
     */
     match /user-tasks/{userId}/tasks/{taskId} {
        allow get, list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isWorkspaceMember(request.resource.data.workspaceId);
        allow update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Invites, Presence, and Prefs.
     */
    match /invites/{inviteId} {
      allow create: if isWorkspaceAdmin(request.resource.data.workspaceId);
      allow get, list, update, delete: if false;
    }

    match /notifications/{workspaceId}/activities/{activityId} {
      allow read, list, update: if isWorkspaceMember(workspaceId);
      allow create, delete: if false;
    }

    match /presence/{workspaceId}/users/{userId} {
      allow read, list: if isWorkspaceMember(workspaceId);
      allow create, update: if isOwner(userId) && isWorkspaceMember(workspaceId);
    }

    match /user-workspace-prefs/{docId} {
        allow read: if isSignedIn() && request.auth.uid == docId.split('-')[0];
        allow write: if isSignedIn() && request.auth.uid == resource.data.uid;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
    }

    match /workspace-files/{fileId} {
      allow list: if isSignedIn();
      allow get, update: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isSignedIn() && isWorkspaceMember(request.resource.data.workspaceId);
      allow delete: if isWorkspaceAdmin(resource.data.workspaceId);
    }
  }
}
