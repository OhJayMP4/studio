rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Standard rule: Allow all reads, and allow writes for authenticated users.
    // This permissive read rule helps avoid CORS preflight issues during development.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
