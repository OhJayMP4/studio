
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read access to workspace logos
    match /workspaces/{workspaceId}/logo {
      allow read;
    }

    // Company logos within workspaces
    match /workspaces/{workspaceId}/companies/{companyId}/logo {
      allow read;
      allow write: if request.auth != null;
    }

    // Shared drive files inside workspaces
    match /workspaces/{workspaceId}/files/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Allow public read access to user avatars
    match /user-avatars/{userId} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Secure user uploads: only the authenticated user can write to their own temp upload path.
    match /user-uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
