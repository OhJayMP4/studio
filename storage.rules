rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all workspace logos
    match /workspaces/{workspaceId}/logo {
      allow read;
    }
    
    // Allow a user to write to a temporary folder under their own UID
    match /user-uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
