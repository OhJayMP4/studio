rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for workspace logos
    match /workspaces/{workspaceId}/logo {
      // Allow anyone to read the logo
      allow read;

      // Allow only admins of the workspace to upload/update/delete the logo
      allow write: if request.auth != null && 
                    exists(/databases/(default)/documents/workspaces/$(workspaceId)) &&
                    get(/databases/(default)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }
  }
}
