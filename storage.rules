
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read access to workspace logos
    match /workspaces/{workspaceId}/logo {
      allow read;
    }

    // Allow authenticated users to read files in workspaces they belong to.
    // Writes are handled by the Cloud Function which moves files from a temp location.
    match /workspaces/{workspaceId}/files/{allPaths=**} {
       allow read: if request.auth != null;
    }

    // Allow public read access to user avatars
    match /user-avatars/{userId} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Secure user uploads: only the authenticated user can write to their own temp upload path.
    match /user-uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

    