rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read access to workspace logos
    match /workspaces/{workspaceId}/logo {
      allow read;
    }

    // Shared drive files inside workspaces
    match /workspaces/{workspaceId}/files/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Allow members of a workspace to read/write to the social media folder
    match /workspaces/{workspaceId}/companies/{companyId}/socialMedia/{fileName} {
      allow read, write: if request.auth != null && exists(/databases/(default)/documents/workspaces/$(workspaceId)) && request.auth.uid in get(/databases/(default)/documents/workspaces/$(workspaceId)).data.memberIds;
    }

    // Allow public read access to user avatars for UI consistency
    // Write is restricted to the owner of the UID
    match /user-avatars/{userId} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Secure user uploads: only the authenticated user can write to their own temp upload path.
    match /user-uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
