
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Workspace files - Read access still requires membership.
    // Write access is open to any logged-in user, but a Cloud Function
    // will validate and delete unauthorized files.
    match /workspaces/{workspaceId}/files/{allPaths=**} {
      allow read: if request.auth != null &&
                     get(/databases/(default)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid] != null;
      
      // Allow any authenticated user to start an upload. A function will validate it.
      allow write: if request.auth != null;
      
      allow delete: if request.auth != null &&
                       get(/databases/(default)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    // Allow public read access to finalized workspace logos
    match /workspaces/{workspaceId}/logo {
      allow read;
      allow write: if request.auth != null &&
                      get(/databases/(default)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    // Allow public read access to user avatars
    match /user-avatars/{userId} {
      allow read;
    }
    
    // Secure user uploads: only the authenticated user can write to their own upload path.
    match /user-uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

     // Secure user avatars: only the authenticated user can write to their own avatar path.
    match /user-avatars/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
