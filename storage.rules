rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for workspaces images
    match /workspaces/{workspaceId}/logo {
      allow read;
      allow write: if request.auth != null && 
                   exists(/databases/(default)/documents/workspaces/$(workspaceId)) &&
                   get(/databases/(default)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }
  }
}
