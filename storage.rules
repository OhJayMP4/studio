rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow admins to upload a logo for their workspace.
    // The path is workspaces/{workspaceId}/logo
    match /workspaces/{workspaceId}/logo {
      allow write: if
        request.auth != null &&
        // Check if the user's UID exists as a key in the workspace's 'users' map
        // and if their 'role' is 'admin'.
        get(/databases/(default)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
        
      // Allow anyone to read workspace logos.
      allow read;
    }
  }
}
