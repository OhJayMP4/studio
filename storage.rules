rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // DIAGNOSTIC: Allowing all reads and writes to determine if 403 is a rule issue or a CORS/Handshake issue.
    // This should be tightened once the connection is established.
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
