
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Read access to finalized workspace files is public
    match /workspaces/{workspaceId}/files/{allPaths=**} {
      allow read;
      
      // DENY direct writes. All writes must go through the user-uploads path and a Cloud Function.
      allow write: if false;

      // Only admins can delete files.
      allow delete: if request.auth != null &&
                       get(/databases/(default)/documents/workspaces/$(workspaceId)).data.users[request.auth.uid].role == 'admin';
    }

    // Allow public read access to finalized workspace logos
    match /workspaces/{workspaceId}/logo {
      allow read;
      // Writes are handled by a Cloud Function after upload to a temp path
      allow write: if false;
    }

    // Allow public read access to user avatars
    match /user-avatars/{userId} {
      allow read;
    }
    
    // Secure user uploads: only the authenticated user can write to their own temp upload path.
    match /user-uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

     // Secure user avatars: only the authenticated user can write to their own avatar path.
    match /user-avatars/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
